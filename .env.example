# Neon Cloud — Xer graph storage
# Get your connection string: https://console.neon.tech → Project → Connect
#
# Use the POOLED connection string (required for Vercel serverless + local API):
#   postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#
# Local: copy to xer/.env
# Vercel: Project → Settings → Environment Variables → NEON_DATABASE_URL

NEON_DATABASE_URL=

# Legacy alias (optional):
# DATABASE_URL=postgresql://...

# API server (local only — Vercel uses serverless api/index.py)
XER_API_HOST=127.0.0.1
XER_API_PORT=8765
