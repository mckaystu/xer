<pardef id='81' align='center' tabs='L1.5299in L2.0299in L2.5299in L3.0299in L3.5299in L4.0299in L4.5299in L5.0299in'
 keepwithnext='true' keeptogether='true'><code event='hidewhen'><formula>SignType = "Standard"</formula></code></pardef>
<par def='81'><run><font size='8pt' style='bold underline' name='Verdana'
 pitch='variable' truetype='true' familyid='20' color='red'/></run><actionhotspot
 hotspotstyle='none' htmlstyle='font-family:Verdana; font-size:8pt; color:red; font-weight:bold'><code
 event='onClick' for='web'><javascript>var f = document.forms[0] ;
if (f.SignType.value != "ARQ") {
	f.Action.value = "Frame" 
		}
		else {
			f.Action.value = "ARQ Frame"
		}

if( f.ODMod.value == "" ) {
  alert( "You must select a module type before adding a frame.")
  f.ODMod.focus()
   return false ;
}

if( f.Color.value == "") {
   alert("You must select a color for this module type before adding a frame.")
   f.Color.focus()
   return false ;
}

if( f.Shape.value == "") {
   alert("You must select a shape for this module type before adding a frame.")
   f.Shape.focus()
   return false ;
}
if( f.ODFrMount.value == "" ) {
  alert( "You must select a mounting method before adding a frame.")
  f.ODFrMount.focus()
   return false ;
}

if( f.ADACompliant[0].selected) {
   alert("You must indicate whether this frame should be ADA Compliant.")
   f.ADACompliant.focus()
   return false ;
}  
if( f.ADACompliant[1].selected  &amp;&amp; f.ADAMsg.value == "") {
	alert("If ADA Compliant, please enter a message.")
	f.ADAMsg.focus()
	return false;
}


f.submit();</javascript></code><run><font size='8pt' style='bold underline'
 name='Verdana' pitch='variable' truetype='true' familyid='20' color='red'/>Add a Frame(s) to the Order</run></actionhotspot><run
