	Case "Lettered Bottom Insert" 
		If Right(doc.ODMod(0), 2) = "/B" Then
			ipskey = doc.ODMod(0) &amp; lBottominserttext	
		Else
			ipskey = doc.ODMod(0) &amp; "/B" &amp; lBottominserttext
		End If
		
		Set ipsdoc = ipsview.GetDocumentbyKey( ipskey, True )
		If Not ipsdoc Is Nothing Then
