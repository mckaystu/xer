	Case "Lettered Strip" 
		If Left(doc.ODMod(0), 2) &lt;&gt; "17" Then
			If Right(doc.ODMod(0), 2) = "/B" Then
				ipskey = doc.ODMod(0) &amp; lStriptext
				newdoc.ODDesc = lStriptext
			Else
				ipskey = doc.ODMod(0) &amp; "/B" &amp; lStriptext	
				newdoc.ODDesc = lStriptext
			End If
		Else
			stripwidth = Cstr(doc.ODStripWidth(0))			
			If stripwidth = "1" Then
				ipskey = "17.0/B" &amp; lHalfInchStriptext	
				newdoc.ODDesc = lHalfInchStriptext
			Else
				ipskey = "17.0/B" &amp; lOneInchStriptext	
				newdoc.ODDesc = lOneInchStriptext
			End If
		End If
		
		Set ipsdoc = ipsview.GetDocumentbyKey( ipskey, True )
		If Not ipsdoc Is Nothing Then		
			newdoc.FixedPrice = ipsdoc.ColumnValues( column )
			newdoc.ExtPrice = ipsdoc.ColumnValues( column ) * doc.InsQty(0)			
		Else
