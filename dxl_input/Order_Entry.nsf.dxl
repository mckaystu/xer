<form name='(PrintForm)' nocompose='true' noquery='true' htmlallfields='true'
 publicaccess='false' designerversion='5' inherit='true'>
<noteinfo noteid='8f6' unid='1587924D315F051385256A7800513ECC' sequence='54'>
<created><datetime dst='true'>20010627T104724,92-04</datetime></created>
<modified><datetime>20061215T010446,44-05</datetime></modified>
<revised><datetime>20061214T132515,78-05</datetime></revised>
<lastaccessed><datetime>20061215T010446,43-05</datetime></lastaccessed>
<addedtofile><datetime>20030211T095918,76-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby><code event='windowtitle'><formula
>"Print Form for " + CustomerName</formula></code><code event='postopen'><lotusscript
>Sub Postopen(Source As Notesuidocument)
	
'declarations	
	Dim s As New NotesSession
	Dim db As NotesDatabase
	Dim view As notesview	
	Dim doc As notesdocument
	Dim orderdoc As notesdocument, detaildoc As notesdocument	
	Dim dc As notesdocumentcollection
	Dim key As String
	Dim velcro As String
	Dim unid As String
	
'declare error handling for entire script
	On Error Goto Errorhandler
	
'basic setup	
	Set db = s.currentdatabase
	
	Set doc = source.document
	
	Set view = db.GetView( "(Orders By Number)" )
	key = source.FieldGetText( "OHOrdNo" )
	
'get the header document and build a collection of detail items (response documents)	
	unid = source.FieldGetText("Unid")
	Set orderdoc = db.GetDocumentbyUnid( unid )	
	Set dc = orderdoc.Responses
	Set detaildoc = dc.GetFirstDocument
	
	If detaildoc Is Nothing Then	
		Messagebox "There is no detail items for this order."
		Exit Sub
	End If
	
	If ( detaildoc.ODColor(0) &lt;&gt; "" ) Then
		doc.Color = detaildoc.ODColor(0)
	Else
		If ( detaildoc.ODColor_1(0) &lt;&gt; "" ) Then
			doc.Color = detaildoc.ODColor_1(0)
		Else
			If ( detaildoc.ODColor_2(0) &lt;&gt; "" ) Then
				doc.Color = detaildoc.ODColor_2(0)
			Else
				If ( detaildoc.ODColor_3(0) &lt;&gt; "" ) Then
					doc.Color = detaildoc.ODColor_3(0)
				Else
					If ( detaildoc.ODColor_4(0) &lt;&gt; "" ) Then
						doc.Color = detaildoc.ODColor_4(0)
					Else
						doc.Color = detaildoc.ODColor_5(0)
					End If
				End If
			End If
		End If	
	End If
	
	If ( detaildoc.ODShape(0) &lt;&gt; "" ) Then
		doc.Shape = detaildoc.ODShape(0)
	Else
		If ( detaildoc.ODShape_1(0) &lt;&gt; "" ) Then
			doc.Shape = detaildoc.ODShape_1(0)
		Else
			doc.Shape = detaildoc.ODFrShape(0)
		End If
	End If
	
'loop to load the table with detail for this order	
	While Not detaildoc Is Nothing
		velcro = Right(detaildoc.JBANo(0), 2)
		If ( velcro = "VT" Or velcro = "HL" ) Then
			doc.Frame_Insert = doc.Frame_Insert(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "Mount"	
		Else
			If ( detaildoc.ODColor(0) &lt;&gt; "" ) Then
				doc.Frame_Insert = doc.Frame_Insert(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "Frame"
			Else
				doc.Frame_Insert = doc.Frame_Insert(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "Insert"
			End If
		End If
		
		doc.LineNbr = doc.LineNbr(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; detaildoc.ODItem(0)
		doc.ItemNbr = doc.ItemNbr(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; detaildoc.JBANo(0)
		doc.Quantity = doc.Quantity(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; Cstr( detaildoc.ODQty(0) )		
		doc.Module = doc.Module(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; detaildoc.ODMod(0)
		
		'doc.arr_graph = doc.arr_graph(0) &amp; Chr$(13) &amp; Chr$(10)  &amp;  ". . ."
		
		If ( detaildoc.ODArrowDir(0) = "" ) Then
			doc.arrow = doc.arrow(0) &amp; Chr$(13) &amp; Chr$(10)  &amp;  ". . ."
		Else
			doc.arrow = doc.arrow(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; detaildoc.ODArrowDir(0) 
		End If
		
		If ( detaildoc.ODLetStyle(0) = "Other" ) Then
			doc.Typestyle = doc.Typestyle(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; detaildoc.ODLetFontSP(0)
		Else 
			If ( detaildoc.ODLetStyle(0) = "" ) Then
				doc.Typestyle = doc.Typestyle(0) &amp; Chr$(13) &amp; Chr$(10)  &amp;  ". . ."
			Else
				doc.Typestyle = doc.Typestyle(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; detaildoc.ODLetStyle(0)
			End If
		End If
		
		If ( detaildoc.ODLetUse(0) = "" ) Then
			doc.LetUse = doc.LetUse(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; ". . ."
		Else
			doc.LetUse = doc.LetUse(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; detaildoc.ODLetUse(0)
		End If
		
		If ( detaildoc.ODLetColor(0) = "Other" ) Then
			doc.LetColor = doc.LetColor(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; detaildoc.ODLetColorSP(0)
		Else 
			If ( detaildoc.ODLetColor(0) = "" ) Then
				doc.LetColor = doc.LetColor(0) &amp; Chr$(13) &amp; Chr$(10)  &amp;  ". . ."
			Else
				doc.LetColor = doc.LetColor(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; detaildoc.ODLetColor(0)
			End If
		End If
		
		If ( detaildoc.ADACompliant(0) = "Yes" ) Then
			doc.ADAYN = doc.ADAYN(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "Yes"
			doc.ADAMsg = doc.ADAMsg(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; detaildoc.ADAMsg(0)
		Else
			If ( detaildoc.ADACompliant_1(0) = "Yes" ) Then
				doc.ADAYN = doc.ADAYN(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "Yes"
				doc.ADAMsg = doc.ADAMsg(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; detaildoc.ADAMsg_1(0)
			Else
				doc.ADAYN = doc.ADAYN(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "No"
				doc.ADAMsg = doc.ADAMsg(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; ". . ."
			End If
		End If		
		
		If ( detaildoc.ODLetMsg(0) = "" ) Then
			doc.Message = doc.Message(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; ". . ."
		Else
			doc.Message = doc.Message(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; detaildoc.ODLetMsg(0)
		End If
		doc.Copysize = doc.Copysize(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "__/__  "	
		
'here we draw some lines to separate the detail items		
		doc.Frame_Insert = doc.Frame_Insert(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "___"
		doc.LineNbr = doc.LineNbr(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "___"
		doc.ItemNbr = doc.ItemNbr(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "___"
		doc.Quantity = doc.Quantity(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "___"
		doc.Module = doc.Module(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "___"
		doc.Typestyle = doc.Typestyle(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "___"
		doc.LetUse = doc.LetUse(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "___"
		doc.LetColor = doc.LetColor(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "___"
		doc.arrow = doc.arrow(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "___"	
		'doc.arr_graph = doc.arr_graph(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "___"
		doc.Message = doc.Message(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "___"
		doc.ADAYN = doc.ADAYN(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "___"
		doc.ADAMsg = doc.ADAMsg(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "___"
		doc.Copysize = doc.Copysize(0) &amp; Chr$(13) &amp; Chr$(10)  &amp; "___"		
		
		Set detaildoc = dc.GetNextDocument(detaildoc)	
	Wend
	
	Call source.refresh
	
	Exit Sub 'Exit the sub before the errorhandler
	
ErrorHandler:
	Print("Error Number " + Cstr(Err) + " : " + Error$ + " on line number " + Cstr(Erl)) 
	Resume Next 'Continue where the agent encountered the last error	
	
End Sub</lotusscript></code>
