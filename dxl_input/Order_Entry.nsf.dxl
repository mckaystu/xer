<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby><code event='htmlhead'><formula
>"&lt;META HTTP-EQUIV=\"Content-Type\" CONTENT=\"text/html; charset=ISO-8859-1\"&gt;" +
"&lt;META NAME=\"Generator\" CONTENT=\"Lotus Domino 6.5\"&gt;" +
"&lt;TITLE&gt;Innerface Architectural Signage: Online Ordering&lt;/TITLE&gt;" +
"&lt;META CONTENT=\"Innerface offers signage planning and wayfinding consulting, and a complete line of interior, exterior and ADA signage.  Nationwide coverage and a commitment to quality drive customer services have made Innerface - The Company That Does Things Right.\" NAME=\"description\"&gt;" +
"&lt;META CONTENT=\"sign, signs, wayfinding, ADA, traffic flow, plaques, name plates,  banners, overheads, labels, exterior signs, fire evacuation plans, floor plans, maps,  fire exit signs, restroom signs, handicap signs, sign installation, graphic design,  sign systems, logos, medical signage\" NAME=\"keywords\"&gt;" +
"&lt;META CONTENT=\"Lotus Domino 6.5\" NAME=\"Generator\"&gt;" +
"&lt;BASE TARGET=\"_parent\"&gt;"</formula></code><code event='jsheader' for='web'><javascript
>function popUp(url) {
sealWin=window.open(url,"win",'toolbar=0,location=0,directories=0,status=1,menubar=1,scrollbars=1,resizable=1,width=500,height=450');
self.name = "mainWin"; }

function windowopener(url) {
	args = "height=" + 320 + ", width=" + 800 + ",dependent=yes,status=1,menubar=1,resizable=1,scrollbars=1"
	window.open(url, "Insert_File_Win", args);
	window.setInterval("checkrefresh()",500);
}

function checkrefresh() {
	_doClick('$Refresh',this,'_self','1');
}

</javascript></code>
