<par def='5'><run><font size='8pt' style='bold' name='Verdana' pitch='variable'
 truetype='true' familyid='20' color='navy'/>Customer Number:  </run><run
><font size='8pt' name='Verdana' pitch='variable' truetype='true' familyid='20'/><field
 type='text' kind='computed' name='OHBill_CustNo'><code event='defaultvalue'><formula
>OHBill_CustNo</formula></code></field></run><run><font size='8pt' name='Verdana'
 pitch='variable' truetype='true' familyid='20'/>   (</run><run><font size='8pt'
 color='red' name='Verdana' pitch='variable' truetype='true' familyid='20'/><field
 type='text' kind='computedfordisplay' name='OHShipAddrCode'><code event='defaultvalue'><formula
>OHShipAddrCode</formula></code></field></run><run><font size='8pt' name='Verdana'
 pitch='variable' truetype='true' familyid='20'/>)</run></par></tablecell>
<tablecell borderwidth='0px'>
<pardef id='7' align='right' leftmargin='0.0104in' keepwithnext='true' keeptogether='true'/>
<par def='7'><run><font size='8pt' style='bold' name='Verdana' pitch='variable'
 truetype='true' familyid='20' color='navy'/>Order Number:  </run><run><font
 size='8pt' style='bold' name='Verdana' pitch='variable' truetype='true' familyid='20'/><field
 type='text' kind='computed' name='OHOrdNo'><code event='defaultvalue'><formula
>OHOrdNo</formula></code></field></run><run><font size='8pt' style='bold'
 name='Verdana' pitch='variable' truetype='true' familyid='20' color='navy'/></run></par></tablecell></tablerow></table>
<par def='2'/>
<table widthtype='fixedleft' refwidth='6in'><tablecolumn width='4in'/><tablecolumn
 width='2in'/>
<tablerow>
<tablecell borderwidth='0px'>
<pardef id='8' leftmargin='0.0104in' keepwithnext='true' keeptogether='true'/>
<par def='8'><run><font size='8pt' style='bold' name='Verdana' pitch='variable'
 truetype='true' familyid='20' color='navy'/>Enter the part number  </run><run
><font size='8pt' style='bold' name='Verdana' pitch='variable' truetype='true'
 familyid='20'/><field defaultfocus='true' type='text' kind='editable' name='JBANo'/></run><run
><font size='8pt' style='bold' name='Verdana' pitch='variable' truetype='true'
 familyid='20' color='navy'/></run></par>
<pardef id='9' leftmargin='0.0104in' hide='read copy preview' keepwithnext='true'
 keeptogether='true'/>
<par def='9'><run><font size='8pt' style='bold' name='Verdana' pitch='variable'
 truetype='true' familyid='20' color='navy'/>and click here ==&gt; </run><button
 width='2in' widthtype='maximum' maxlines='0' wraptext='true' bgcolor='system'><code
 event='click'><formula>@If(JBANo = "" ; @Do(@Prompt([Ok] ; "No Part Number Entered" ; "You must enter a JBA part number before clicking this button.  Enter a valid JBA part number and try again.") ; @Return("")) ; "");

itemdb := "Innerface\\Item Master.nsf";

FIELD FixedPrice := FixedPrice;
price := @DbLookup( "" ; hDbserver : itemdb ; "(Item Price Lookup)" ; JBANo ; "IM_ItemPrice" );
@If(@IsError(price) ; @Do(@Prompt([Ok] ; "Part Number Not Found" ; "The JBA part number that you entered is not in the Item Master File.  The part number will be saved and information will be generated for each item component but the component information derived may not be correct.") ; @SetField("FixedPrice" ; 0)) ; @SetField("FixedPrice" ; price));

FIELD ODPrefix := @Left(JBANo ; 2);
FIELD ODMod := @Middle(JBANo ; 2 ;6);

FIELD ODInnerDot := @If(@Middle(JBANo ; 12 ; 2) = "ID" ; "Yes" ; "No");
FIELD ODQty := 1;
FIELD ODColor := ODColor;
FIELD ODColor_1 := ODColor_1;
FIELD ODColor_2 := ODColor_2;
FIELD ODColor_3 := ODColor_3;

proddb := "Innerface\\Product Information.nsf";
FIELD hProdType := @DbLookup( "" : ""; hDbserver : proddb; "(Product by Code)" ; ODPrefix  ; 2 );
FIELD ODSpIns := @Right(@DbLookup( "" : ""; hDbserver : proddb; "(Product by Code)" ; ODPrefix  ; 3 ) ; ODPrefix);

@If(hProdType = "Frame" ;
		@Do(@SetField("ODColor" ; @Middle(JBANo ; 8 ;2)) ; @SetField("ODFrShape" ; @Middle(JBANo ; 10 ; 2))) ;
				hProdType = "Lettered Insert" ;
				@Do(@SetField("ODColor_1" ; @Middle(JBANo ; 8 ;2)) ; @SetField("ODShape" ; @Middle(JBANo ; 10 ; 					2))) ; 	
					hProdType = "Blank Insert" ;
					@Do(@SetField("ODColor_2" ; @Middle(JBANo ; 8 ;2)) ; @SetField("ODShape_1" ; @Middle(JBANo 						;10 ;2))) ;
							@Prompt([Ok] ; "Item Number Exception" ; "It appears the item number entered is not a frame or insert.  Use the special instructions below to explain the item to be ordered."));

@Command([ViewRefreshFields])</formula></code><font size='8pt' name='Verdana'
 pitch='variable' truetype='true' familyid='20'/></button><run><font size='8pt'
