<agent name='(MarkDupeComplete)' hide='v3' publicaccess='false' designerversion='5'>
<noteinfo noteid='726' unid='DC0B92839B5973CF8525699900740EBC' sequence='20'>
<created><datetime>20001116T160739,48-05</datetime></created>
<modified><datetime>20061215T010446,15-05</datetime></modified>
<revised><datetime>20061214T132507,11-05</datetime></revised>
<lastaccessed><datetime>20061215T010446,14-05</datetime></lastaccessed>
<addedtofile><datetime>20030211T095901,89-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby>
<designchange><datetime>20061214T132507,11-05</datetime></designchange>
<trigger type='agentlist'/>
<documentset type='runonce'/><code event='options'><lotusscript>Option Public

</lotusscript></code><code event='initialize'><lotusscript>Sub Initialize
	
	Dim s As New NotesSession
	Dim db As NotesDatabase
	Dim dc As NotesDocumentCollection	
	Dim doc As NotesDocument, hdrdoc As NotesDocument
	Dim view As NotesView
	Dim unid As String, hdrunid As String
	Dim module As String
	Dim newunid As String
	
'Declare error handling for entire script
	On Error Goto Errorhandler
	
'Get a handle on the current document	
	Set db = s.CurrentDatabase	
	Set doc = s.DocumentContext
	
'Use the unid of the header document to get a handle on it	
	newunid = doc.HdrUnid(0)	
	Set hdrdoc = db.GetDocumentbyUNID( newunid )
	
'Change the status to complete	
	hdrdoc.OHOrdStatus = "Web - Complete"
	Call hdrdoc.Save( True, True)		
	
'And do the same for all of the response docs (details)	
	Set dc = hdrdoc.Responses
	Call dc.StampAll("hODStatus", "Web - Complete")
	
'Send the user an email confirmation and then to our pleasant Thank You page
	Set maildoc = New NotesDocument( db )     
	maildoc.Form = "Memo"   
	maildoc.SendTo = hdrdoc.WebEmail(0)	
	maildoc.Head = "Memo from Innerface Sign Systems"	
	maildoc.Subject = "Your Recent Order"     
	maildoc.Body = "This email is to confirm receipt of your recent web order with Innerface Sign Systems.  " &amp; _
	"Your order number was " &amp; hdrdoc.OHOrdNo(0) &amp; ".  You may contact Innerface customer service if you " &amp; _
	"have questions regarding this order.  Thank You For Your Order!"
   ' send the new document to the recipient
	Call maildoc.Send( False )
	Print "[/Innerface/Order+Entry.nsf/ThankYouPage?OpenPage]"	
	
	Exit Sub 'Exit the sub before the errorhandler
	
ErrorHandler:
	Print("Error Number " + Cstr(Err) + " : " + Error$ + " on line number " + Cstr(Erl)) 
	Resume Next 'Continue where the agent encountered the last error
End Sub</lotusscript></code>
<rundata processeddocs='0' exitcode='0'>
<agentmodified><datetime dst='true'>20021024T100518,55-04</datetime></agentmodified></rundata>
<item name='$POID'><datetime>20061214T132507,11-05</datetime></item></agent>

