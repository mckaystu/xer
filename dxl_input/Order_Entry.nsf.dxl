<agent name='(WebDetailMods)' hide='v3' publicaccess='false' designerversion='5'>
<noteinfo noteid='11ef2' unid='514885C2CDA02140852571C0005A062F' sequence='4'>
<created><datetime dst='true'>20060804T122318,23-04</datetime></created>
<modified><datetime>20061215T010446,71-05</datetime></modified>
<revised><datetime>20061214T132526,01-05</datetime></revised>
<lastaccessed><datetime>20061215T010446,70-05</datetime></lastaccessed>
<addedtofile><datetime dst='true'>20060804T122838,12-04</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby>
<designchange><datetime>20061214T132526,01-05</datetime></designchange>
<trigger type='agentlist'/>
<documentset type='runonce'/><code event='options'><lotusscript>Option Public
Option Declare

</lotusscript></code><code event='initialize'><lotusscript>Sub Initialize
	
	Dim s As New NotesSession
	Dim db As NotesDatabase
	Dim doc As Notesdocument, hdrdoc As NotesDocument
	Dim msgItem As Variant
	
'declare error handling for entire script
	On Error Goto Errorhandler	
	
'get a handle on the input doc in the ui and then do some basic stuff
	Set db = s.CurrentDatabase		
	Set doc = s.Documentcontext
	
	If doc.unid(0) = "" Then
		If doc.Message(0) &lt;&gt; "" Then
			doc.plainText = doc.Message(0)
			Call doc.Save( True, True )
		End If
	Else
		Set hdrdoc = db.Getdocumentbyunid( doc.unid(0) )
		If Not hdrdoc Is Nothing Then
			If doc.Message(0) &lt;&gt; "" Then
				doc.plainText = doc.Message(0)
				Call doc.Save( True, True )
			End If
			hdrdoc.TotalPrice = hdrdoc.TotalPrice(0) - doc.ExtPrice(0)			
			If doc.Deleted(0) &lt;&gt; "Yes" Then
				doc.ExtPrice = doc.FixedPrice(0) * doc.Quantity(0)
				hdrdoc.TotalPrice = hdrdoc.TotalPrice(0) + doc.ExtPrice(0)
			End If
			Call hdrdoc.Save( True, True )						
			doc.Query_String = ""
			doc.unid = ""			
			Call doc.MakeResponse( hdrdoc )
			Call doc.Save( False, False )
		End If
	End If
	
'**************************************************************************************	
	
	Exit Sub 'Exit the sub before the errorhandler
	
ErrorHandler:
	Print("WebDetailMods - Error Number " + Cstr(Err) + " : " + Error$ + " on line number " + Cstr(Erl)) 
	Resume Next 'Continue where the agent encountered the last 
	
End Sub</lotusscript></code>
