<action title='_Move To Folder...' showinbar='false' systemcommand='movetofolder'/>
<action title='_Remove From Folder' showinbar='false' systemcommand='removefromfolder'/></actionbar>
<background allowoverride='false'/>
<body><richtext>
<pardef id='1'/>
<par def='1'/>
<table widthtype='fixedleft' refwidth='6in'><tablecolumn width='6in'/>
<tablerow>
<tablecell borderwidth='0px'>
<pardef id='3' align='center' leftmargin='0.0104in' keepwithnext='true' keeptogether='true'/>
<par def='3'><button width='2in' widthtype='maximum' maxlines='1' wraptext='true'
 bgcolor='system'><code event='onClick' for='web'><javascript>window.close()</javascript></code><code
 event='onClick' for='client'><javascript>window.close()</javascript></code><font
 size='7pt' style='bold' name='Verdana' pitch='variable' truetype='true' familyid='20'/>Close This Window</button></par></tablecell></tablerow></table>
<pardef id='4' leftmargin='1in'/>
<par def='4'><run><font size='14pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20' color='purple'/></run></par>
<par def='4'><run><font size='14pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20' color='purple'/></run></par>
<par def='4'><run><font size='14pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20' color='#00476b'/>InnerDot Sign Inserts. . .</run></par>
<pardef id='5' leftmargin='1in' hide='read edit copy preview previewedit'/>
<par def='5'><run><font size='9pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20' color='purple'/></run></par>
<par def='5'><run><font size='9pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20' color='purple'/></run></par>
<par def='5'><run><font size='9pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20' color='purple'/></run></par>
<table widthtype='fixedleft' refwidth='6in'><tablecolumn width='6in'/>
<tablerow>
<tablecell>
<pardef id='6' leftmargin='0.0104in' tabs='L2.5208in L3.0208in L3.5208in L4.0208in L4.5208in L5.0208in L5.5208in L6.0208in'
 keepwithnext='true' keeptogether='true'/>
<par def='6'><run><font size='9pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20' color='#ba5700'/>An InnerDot frame is one that has raised characters placed on the frame with Braille translation immediately below.  Text on the insert will typically be placed centered and low enough to not be hidden by the raised characters and braille.  In the example below the number 213 and braille translation are placed on the outside of the frame.  The insert has the words Office Manager placed on it.  Placement of these characters may be different than on a non-InnerDot frame.</run></par>
<pardef id='7' leftmargin='0.0104in' tabs='L1.5104in L2.0104in L2.5104in L3.0104in L3.5104in L4.0104in L4.5104in L5.0104in'
 keepwithnext='true' keeptogether='true'/>
<par def='7'><run><font size='9pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20' color='purple'/></run></par>
<par def='7'><run><font size='9pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20' color='purple'/></run></par>
<pardef id='8' leftmargin='0.0104in' keepwithnext='true' keeptogether='true'/>
<par def='8'><run><font size='7pt'/><field type='text' kind='computed' name='hGraphicHTML'><code
 event='defaultvalue'><formula>key := "brailleExp";
db := "Innerface\\NRFCFILE.nsf";
temp := @DbLookup( "" ; "" : db ; "(Lookup)" ; key  ; 2 ) ;
htmlPre := @If(@IsError(temp) ; @DbLookup( "" ; "" : db ; "(Lookup)" ; "Innerface"  ; 2 ) ; temp);
finalhtml := @ReplaceSubstring(htmlPre ; " " ; "+");
"[&lt;img src = \"" + finalhtml + "\"&gt;]"</formula></code></field></run><run
><font size='8pt' name='Verdana' pitch='variable' truetype='true' familyid='20'
 color='purple'/></run></par></tablecell></tablerow></table>
<pardef id='9' hide='web' tabs='L1.5104in L2.0104in L2.5104in L3.0104in L3.5104in L4.0104in L4.5104in L5.0104in'/>
<par def='9'><run><font size='9pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20' color='purple'/></run></par></richtext></body>
<item name='$$ScriptName' summary='false' sign='true'><text>WebInnerDotForm</text></item></form>

