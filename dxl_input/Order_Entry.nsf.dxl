 pitch='variable' truetype='true' familyid='20'/><field type='names' allowmultivalues='true'
 kind='computed' name='Editors' listinputseparators='comma semicolon newline'
 listdisplayseparator='newline'><code event='defaultvalue'><formula>@If(@IsNewDoc &amp; !@IsDocBeingSaved; ""; @IsDocBeingSaved; @Trim(@Name([CN]; @UserName) : Editors); Editors)</formula></code></field></run><run
><font size='8pt' name='Verdana' pitch='variable' truetype='true' familyid='20'
 color='navy'/></run></par></tablecell>
<tablecell borderwidth='0px' bgcolor='white'>
<par def='4'><run><font size='8pt' name='Verdana' pitch='variable' truetype='true'
 familyid='20' color='navy'/></run><run><font size='8pt' color='navy' name='Verdana'
 pitch='variable' truetype='true' familyid='20'/><field type='text' allowmultivalues='true'
 kind='computed' name='EditDates' listinputseparators='comma semicolon newline'
 listdisplayseparator='newline'><code event='defaultvalue'><formula>@If(!@IsDocBeingSaved; @Return(EditDates); "");
FIELD EditDates := EditDates;
mo := @Text(@Month(@Now));
da := @Text(@Day(@Now));
yr := @Text(@Year(@Now));
dateDisp := mo + "/" + da + "/" + yr + " " + @Text(@Time(@Now));
@SetField("EditDates" ; @Trim(dateDisp : EditDates))</formula></code></field></run><run
><font size='8pt' name='Verdana' pitch='variable' truetype='true' familyid='20'
 color='navy'/></run></par></tablecell>
<tablecell borderwidth='0px' bgcolor='white'>
<par def='5'><run><font size='8pt' name='Verdana' pitch='variable' truetype='true'
 familyid='20' color='navy'/></run><run><font size='8pt' color='navy' name='Verdana'
 pitch='variable' truetype='true' familyid='20'/><field type='text' allowmultivalues='true'
 kind='computed' name='EditSequence' listinputseparators='comma semicolon newline'
 listdisplayseparator='newline'><code event='defaultvalue'><formula>thisnumber := @If(EditSequence = ""; "1"; @Text(1 + @TextToNumber(@Subset(EditSequence; 1))));

REM {This line of code is commented out for Innerface Signs};
REM {thisseq := @If(@Today = VerifyDate; thisnumber + "**"; thisnumber);};

@If(@IsNewDoc &amp; !@IsDocBeingSaved; ""; @IsDocBeingSaved; @Trim(thisnumber : EditSequence); EditSequence)</formula></code></field></run><run
><font size='8pt' name='Verdana' pitch='variable' truetype='true' familyid='20'
 color='navy'/></run></par></tablecell></tablerow></table>
