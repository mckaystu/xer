 familyid='20' color='gray'/>random order number for all customers: </run><run
><font size='7pt' name='Verdana' pitch='variable' truetype='true' familyid='20'/><field
 type='text' kind='computed' name='hRndOrd'><code event='defaultvalue'><formula
>temp := @Right(Query_String ; "&amp;Random=");
@Left(temp ; "&amp;Order=")</formula></code></field></run><compositedata type='98'
