<par def='31'><run><font size='7pt' name='Verdana' pitch='variable' truetype='true'
 familyid='20'/></run><run><font size='7pt' color='navy' name='Verdana' pitch='variable'
 truetype='true' familyid='20'/><field type='text' kind='editable' name='ODMod'
 taborder='1' htmlstyle='font-family:Verdana; font-size:8pt; color:dk blue'
 extrahtmlattrs='tabindex=1'><code event='htmlattributes'><formula>"size=8 maxlength=8"</formula></code><code
 event='defaultvalue'><formula>ODMod</formula></code><code event='onFocus'
 for='web'><javascript>window.status='Click the column header above to select a basic module.'</javascript></code><code
 event='onBlur' for='web'><javascript>window.status=''</javascript></code><code
 event='onChange' for='web'><javascript>var f = document.forms[0] ;

var temp = 0;
var module = f.ODMod.value;
var period = module.indexOf(".",0);  //find the period in the module designation

temp = parseInt(module.substring(0, period),10); //temp is the module number left of the period (converted to integer)

//here we determine what type of module it is so we can price it correctly when the customer clicks one of the add buttons
if ( temp &lt; 10 ) {
	f.hModType.value = "Plaque Module" ;
}
else {
	if ( temp &gt;= 10 &amp;&amp; temp &lt;= 16 ) {
		f.hModType.value = "Secondary Directory Module";
	}	
	else {
		if ( temp == 17 ) {
			f.hModType.value = "Main Directory Module";
		}
	}	
}
document.forms[0].ODMod.focus()
//checkrefresh()</javascript></code></field></run><compositedata type='98'
 prevtype='65402' nexttype='65375' afterparcount='16' containertype='65418'
 aftercontainercount='8' afterbegincount='11'>
