<agent name='(CopyOrder)' hide='v3' publicaccess='false' designerversion='5'
 comment='copies entire order fm duplicate an order page'>
<noteinfo noteid='4ee' unid='8762BA4E67993D3D852568F800633B7A' sequence='45'>
<created><datetime dst='true'>20000608T140352,90-04</datetime></created>
<modified><datetime>20061215T010445,00-05</datetime></modified>
<revised><datetime>20061214T132458,96-05</datetime></revised>
<lastaccessed><datetime>20061215T010445,00-05</datetime></lastaccessed>
<addedtofile><datetime>20030211T095859,34-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby>
<designchange><datetime>20061214T132458,95-05</datetime></designchange>
<trigger type='agentlist'/>
<documentset type='runonce'/><code event='options'><lotusscript>Option Public

</lotusscript></code><code event='initialize'><lotusscript>Sub Initialize
	
	'declare everything
	Dim s As New NotesSession
	Dim db As NotesDatabase
	Dim dc As NotesDocumentCollection
	Dim doc As notesDocument, olddoc As NotesDocument, newdoc As NotesDocument
	Dim numdoc As NotesDocument
	Dim detdoc As NotesDocument, newdetdoc As NotesDocument
	Dim unid As String
	Dim customer As String, key As String, order As String
	Dim view As Notesview
	Dim counter As Integer
	Dim maildoc As NotesDocument
	
	'Declare error handling for entire script
	On Error Goto Errorhandler
	
	'set up things and get the URL string that called the agent to find the target UNID
	Set db = s.CurrentDatabase
	Set doc = s.DocumentContext
	
	unid = Mid$( doc.Query_String(0) , Instr( doc.Query_String(0) , "ID=") + 3)
	
	'Get the source order and details
	Set olddoc = db.GetDocumentbyUNID( unid )
	customer = olddoc.OHBill_CustNam(0)	
	Set dc = olddoc.Responses
	
	'Create the new order
	Dim admindb As New NotesDatabase( db.server, "Innerface\Order Entry Administration.nsf")
	Set view = admindb.GetView( "(luOEUsers)" )
	key = "Web User"
	Set numdoc = view.GetDocumentbyKey( key , True )
	order = "WEB" + Trim(Str$(numdoc.UP_NextNumber(0)))
	numdoc.UP_NextNumber = numdoc.UP_NextNumber(0) + 1
	Call numdoc.Save( True, True)
	
	Set newdoc = olddoc.CopytoDatabase( db )
	newdoc.OHDate = Now
	newdoc.OHOrdNo = order
	newdoc.OHOrdStatus = "Web - Verify"
	Call newdoc.Save( True, True)
	
	'create the new details
	Set detdoc = dc.GetFirstDocument
	counter = 1
	Do Until detdoc Is Nothing
		Set newdetdoc = detdoc.CopytoDatabase( db )
		newdetdoc.OHDate = Now
		newdetdoc.OHOrdNo = order
		newdetdoc.ODItem = counter
		newdetdoc.ODLocation = ""
		newdetdoc.OHOrdStatus = "Web - Verify"
		Call newdetdoc.MakeResponse( newdoc )
		Call newdetdoc.Save( True, True)
		Set detdoc = dc.GetNextDocument( detdoc )
		counter = counter + 1
	Loop
	
%REM	
	Set maildoc = New NotesDocument( db )
	maildoc.Form = "Memo"
	maildoc.MsgType = "Web Order Notification"		
	maildoc.SendTo = "Nancy Brazier/Innerface"
	maildoc.CopyTo = "John Holcomb/Innerface"
	maildoc.Subject = "Web Order from " &amp; customer
	maildoc.Body = "Order number " &amp; order &amp; " has been received in the Notes Order Entry system as a duplicated order."
	Call maildoc.Send( False, maildoc.SendTo(0) ) 
%ENDREM	
	
	'send the user to our pleasant and confidence-inspiring thank you page.
	Print "[/Innerface/Order+Entry.nsf/ThankYouForm?OpenForm&amp;Order=" &amp; order &amp; "]"
	
	Exit Sub 'Exit the sub before the errorhandler
	
ErrorHandler:
	Print("Error Number " + Cstr(Err) + " : " + Error$ + " on line number " + Cstr(Erl)) 
	Resume Next 'Continue where the agent encountered the last error
	
End Sub</lotusscript></code>
<rundata processeddocs='0' exitcode='0'>
<agentmodified><datetime>20021112T080159,92-05</datetime></agentmodified></rundata>
<item name='$POID'><datetime>20061214T132458,96-05</datetime></item></agent>

