 kind='computed' name='OHSelection'><code event='defaultvalue'><formula>@If(@IsNewDoc &amp; !@IsDocBeingRecalculated &amp; !@IsDocBeingSaved ;  "" ; @Return(""));
db := "Innerface\\MasterDB.nsf";

temp := @DbLookup( "" ; "" : db; "Customers\\by Number" ; OHBill_CustNo  ; 2 );
billdata := @DbLookup( "" ; "" : db; "(Lookup Name Imploded)" ; temp  ; 3 );
shipdata := @DbLookup( "" ; "" : db; "(Lookup Name Imploded)" ; temp  ; 3 );

useShip := @If( @ReplaceSubstring( shipdata ; "~" ; "" ) = "" ; @False ; @True);

@If( @IsError( temp) ; @Return("") ; "");
FIELD OHBill_CustNam := temp;
FIELD OHBill_Add1 := @Word( billdata ; "~" ; 1);
FIELD OHBill_Add2 := @Word( billdata ; "~" ; 2);
FIELD OHBill_City := @Word( billdata ; "~" ; 4);
FIELD OHBill_State := @Word( billdata ; "~" ; 5);
FIELD OHBill_ZIP := @Word( billdata ; "~" ; 6);
FIELD OHBill_Phone := @Word( billdata ; "~" ; 8);
FIELD OHAPContact := @Word( billdata ; "~" ; 9);
FIELD OHAPCtc_Phone := OHAPCtc_Phone;

FIELD OHShip_CustNam := OHBill_CustNam;
FIELD OHShip_Add1 := @If( useShip ; @Word( shipdata ; "~" ; 1); OHBill_Add1);
FIELD OHShip_Add2 := @If( useShip ; @Word( shipdata ; "~" ; 2); OHBill_Add2) ;
FIELD OHShip_City := @If( useShip ; @Word( shipdata ; "~" ; 4); OHBill_City);
FIELD OHShip_State := @If( useShip ; @Word( shipdata ; "~" ; 5); OHBill_State);
FIELD OHShip_ZIP := @If( useShip ; @Word( shipdata ; "~" ; 6); OHBill_ZIP);
FIELD OHShip_Phone := @If( useShip ; @Word( shipdata ; "~" ; 8); OHBill_Phone);
temp</formula></code><code event='terminate'><lotusscript>Sub Terminate
	
