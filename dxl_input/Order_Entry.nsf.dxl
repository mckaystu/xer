 event='webquerysave'><formula>@Command([ToolsRunMacro]; "(StatusToVerify)")</formula></code><code
 event='jsheader' for='web'><javascript>var f = document.forms[0];

function popUp(url) {
sealWin=window.open(url,"win",'toolbar=0,location=0,directories=0,status=1,menubar=1,scrollbars=1,resizable=1,width=500,height=450');
self.name = "mainWin";
}

function windowopener(u,h,w) {
args = "height=" + h + ", width=" + w + ",dependent=yes,resizable=yes,scrollbars=yes,status=0"
window.open (u, "Order_Detail", args);
window.setInterval("checkrefresh()",1000);
}

function checkrefresh() {
	var f = document.forms[0];
	if (f.RefreshFlag.value == "1") {	
	f.RefreshFlag.value = "";
	_doClick('$Refresh',this,'_self','#_RefreshKW_RefreshKWField');
	window.clearInterval;
	}
}
</javascript></code>
