<body><richtext>
<pardef id='1' leftmargin='1in' rightmargin='100%'><code event='hidewhen'><formula
>1</formula></code></pardef>
<par def='1'><run><font size='8pt' color='red' name='Tahoma' pitch='variable'
 truetype='true' familyid='20'/>Local Hidden Fields</run></par>
<par def='1'><run><font name='Tahoma' pitch='variable' truetype='true' familyid='20'/></run><run
><font size='8pt' color='red' name='Tahoma' pitch='variable' truetype='true'
 familyid='20'/><field type='text' kind='editable' name='CheckFields'><code
 event='inputvalidation'><formula>@If(@Elements(FromFields)!=@Elements(ToFields);@Failure("Both field lists must contain the same number of entries.");@Success)</formula></code></field></run><run
><font name='Tahoma' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='1'><run><font size='8pt' color='red' name='Tahoma' pitch='variable'
 truetype='true' familyid='20'/>End Local Hidden Fields</run></par>
<table user4spacing='true' rightmargin='100%' widthtype='fitmargins' refwidth='5.5417in'><tablecolumn
 width='100%'/>
<tablerow>
<tablecell bgcolor='navy' borderwidth='0px'>
<pardef id='2' leftmargin='1.0278in' rightmargin='6.5139in' keepwithnext='true'
 keeptogether='true'/>
<par def='2'><run><font size='14pt' color='white' style='bold' name='Tahoma'
 pitch='variable' truetype='true' familyid='20'/></run><run><font size='14pt'
 color='white' style='bold' name='Tahoma' pitch='variable' truetype='true'
 familyid='20'/><field type='text' kind='computedfordisplay' name='DBTitle'><code
 event='defaultvalue'><formula>@DbTitle + " - Data Dictionary"</formula></code></field></run><run
><font size='14pt' color='white' style='bold' name='Tahoma' pitch='variable'
 truetype='true' familyid='20'/></run></par></tablecell></tablerow></table>
<pardef id='3' leftmargin='1in' rightmargin='100%'><code event='hidewhen'
 enabled='false'><formula>1</formula></code></pardef>
<par def='3'><run><font name='Tahoma' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='3'><run><font style='bold' name='Tahoma' pitch='variable' truetype='true'
 familyid='20'/>Active:</run><run><font name='Tahoma' pitch='variable' truetype='true'
 familyid='20'/> </run><run><font name='Tahoma' pitch='variable' truetype='true'
 familyid='20'/><field type='keyword' kind='editable' name='Active'><keywords
 ui='dialoglist'><textlist><text>True | 1</text><text>False | 0</text></textlist></keywords><code
 event='defaultvalue'><formula>"0"</formula></code></field></run><run><font
 name='Tahoma' pitch='variable' truetype='true' familyid='20'/></run></par>
<par def='3'><run><font name='Tahoma' pitch='variable' truetype='true' familyid='20'/></run></par>
<table user4spacing='true' rightmargin='100%' widthtype='fitmargins' refwidth='5.5403in'><tablecolumn
 width='49.9931%'/><tablecolumn width='49.9931%'/>
<tablerow>
<tablecell bgcolor='#f7f7f7'>
<pardef id='4' leftmargin='1.0278in' rightmargin='3.7424in' keepwithnext='true'
 keeptogether='true'><code event='hidewhen' enabled='false'><formula>1</formula></code></pardef>
<par def='4'><run><font style='bold' name='Tahoma' pitch='variable' truetype='true'
 familyid='20'/>From Field List (Notes Fields)</run></par></tablecell>
<tablecell bgcolor='#f7f7f7'>
<pardef id='5' leftmargin='3.7979in' rightmargin='6.5125in' keepwithnext='true'
 keeptogether='true'><code event='hidewhen' enabled='false'><formula>1</formula></code></pardef>
<par def='5'><run><font style='bold' name='Tahoma' pitch='variable' truetype='true'
 familyid='20'/>To Field List (Descriptive Fields)</run></par></tablecell></tablerow>
<tablerow>
<tablecell>
<par def='4'><run><font name='Tahoma' pitch='variable' truetype='true' familyid='20'/></run><run
><font name='Tahoma' pitch='variable' truetype='true' familyid='20'/><field
 type='text' allowmultivalues='true' kind='editable' name='FromFields' listinputseparators='newline'
 listdisplayseparator='newline'/></run><run><font name='Tahoma' pitch='variable'
 truetype='true' familyid='20'/></run></par></tablecell>
<tablecell>
<par def='5'><run><font name='Tahoma' pitch='variable' truetype='true' familyid='20'/><field
 type='text' allowmultivalues='true' kind='editable' name='ToFields' listinputseparators='newline'
 listdisplayseparator='newline'><code event='inputtranslation'><formula>@ReplaceSubstring(ToFields; " "; "_")</formula></code></field></run><run
><font name='Tahoma' pitch='variable' truetype='true' familyid='20'/></run></par></tablecell></tablerow></table>
<par def='3'><run><font name='Tahoma' pitch='variable' truetype='true' familyid='20'/></run></par></richtext></body>
<item name='$$ScriptName' summary='false' sign='true'><text>$DataDictionary</text></item></form>

