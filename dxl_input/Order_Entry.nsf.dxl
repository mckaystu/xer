		doc.hItemType = ""		
		Call doc.save(False, False)
		Call view.Refresh			
		unid = doc.UniversalID		
		Print "[/Innerface/Order+Entry.nsf/0/" &amp; unid &amp; "?EditDocument]"
		
	Case "Blank Base"
		If doc.ODMod(0) = "2.6" Or doc.ODMod(0) = "4.6" Or doc.ODMod(0) = "4.7" Or _
		doc.ODMod(0) = "5.6" Or doc.ODMod(0) = "6.6" Or doc.ODMod(0) = "7.1" Or doc.ODMod(0) = "8.1" Then
			insertletter = "B"
		Else
			insertletter = "C"
		End If		
		If Right(doc.ODMod(0), 2) = "/B" Or Right(doc.ODMod(0), 2) = "/C" Then	
			ipskey = doc.ODMod(0) &amp; bBasetext
		Else
			ipskey = doc.ODMod(0) &amp; "/" &amp; insertletter &amp; bBasetext
		End If
		
		Set ipsdoc = ipsview.GetDocumentbyKey( ipskey, True )
		If Not ipsdoc Is Nothing Then
			newdoc.FixedPrice = ipsdoc.ColumnValues( column )
			newdoc.ExtPrice = ipsdoc.ColumnValues( column ) * doc.BlankQty(0)		
		Else
			newdoc.FixedPrice = 0
			newdoc.ExtPrice = 0
		End If
		newdoc.ODDesc = bBaseText
		
		newdoc.ODBlankType = "Base Insert, Blank"				
		newdoc.ODQty = doc.BlankQty(0)
		
		newdoc.ODColor_2 = doc.Color(0)
		newdoc.ODShape_1 = doc.Shape(0)
		If Right(doc.ODMod(0), 2) = "/B" Or Right(doc.ODMod(0), 2) = "/C" Then
			newdoc.ODMod = doc.ODMod(0)
		Else
			newdoc.ODMod = doc.ODMod(0) &amp; "/" &amp; insertletter
		End If
		
		Call newdoc.MakeResponse(hdrdoc)		
		Call newdoc.Save( True, True)				
		Call view.Refresh
		
		doc.Action = "Save"
		doc.BlankQty = 1
		doc.ODLocation = ""		
		doc.SpIns = ""	
		doc.ODSpIns = ""			
		doc.InstReq = "No"		
		doc.hPrice = ""		
		doc.hItemType = ""		
		Call doc.save(False, False)
		Call view.Refresh			
		unid = doc.UniversalID		
		Print "[/Innerface/Order+Entry.nsf/0/" &amp; unid &amp; "?EditDocument]"
		
	Case "Lettered Left Insert" 
		If Right(doc.ODMod(0), 2) = "/A" Then
			ipskey = doc.ODMod(0) &amp; lLeftinserttext	
		Else
			ipskey = doc.ODMod(0) &amp; "/A" &amp; lLeftinserttext
		End If
		
		Set ipsdoc = ipsview.GetDocumentbyKey( ipskey, True )
		If Not ipsdoc Is Nothing Then
			newdoc.FixedPrice = ipsdoc.ColumnValues( column )
			newdoc.ExtPrice = ipsdoc.ColumnValues( column ) * doc.InsQty(0)		
		Else
			newdoc.FixedPrice = 0
			newdoc.ExtPrice = 0
		End If
		newdoc.ODDesc = lInsertText
		
		newdoc.ODQty = doc.InsQty(0)		
		insertletter = "A"
		
		newdoc.ODInsType = "Lettered Left Insert"		
		newdoc.ODLetMsg = doc.ODLetMsg(0)
		newdoc.ODRAText = doc.RAText(0)		
		newdoc.ODColor_1 = doc.Color(0)		
		newdoc.ODLetStyle = doc.ODLetStyle(0)
		newdoc.ODLetColor = doc.ODLetColor(0)
		newdoc.ODLetUse = doc.ODLetUse(0)		
		newdoc.ODShape = doc.Shape(0)
		newdoc.ODSymbol = doc.ODSymbol(0)
		newdoc.ODSymbol_1 = doc.ODSymbol_1(0)		
		newdoc.ODArrowDir = doc.ODArrowDir(0)
		
		newdoc.ODSymbolImage = "C:\msimages\PG_" &amp; doc.ODSymbol(0) &amp; ".gif"
		newdoc.ODSymbolImage_1 = "C:\msimages\PG_" &amp; doc.ODSymbol_1(0) &amp; ".gif"
		newdoc.ODArrowImage = "C:\msimages\PG_" &amp; doc.ODArrowDir_1(0) &amp; ".gif"		
		
		newdoc.ODFormat = doc.ODFormat(0)
		If Right(doc.ODMod(0), 2) = "/A" Then
			newdoc.ODMod = doc.ODMod(0)
		Else
			newdoc.ODMod = doc.ODMod(0) &amp; "/" &amp; insertletter
		End If
		
		Call newdoc.MakeResponse(hdrdoc)				
		Call newdoc.Save( True, True)		
		Call view.Refresh
		
		doc.Action = "Save"
		doc.ODLetMsg = ""
		doc.RAText = ""		
		doc.ODSymbol = ""
		doc.ODSymbol_1 = ""		
		doc.ODArrowDir = ""
		doc.ODArrowDir_1 = ""		
		doc.ADAMsg_1  = ""		
		doc.ODLocation = ""		
		doc.SpIns = ""	
		doc.ODSpIns = ""			
		doc.InsQty = 1		
		doc.InstReq = "No"		
		doc.hPrice = ""		
		doc.hItemType = ""		
		Call doc.save(False, False)
		Call view.Refresh			
		unid = doc.UniversalID		
		Print "[/Innerface/Order+Entry.nsf/0/" &amp; unid &amp; "?EditDocument]"		
		
	Case "Lettered Right Insert" 
		If Right(doc.ODMod(0), 2) = "/B" Then
			ipskey = doc.ODMod(0) &amp; lRightinserttext	
		Else
			ipskey = doc.ODMod(0) &amp; "/B" &amp; lRightinserttext
		End If
		
		Set ipsdoc = ipsview.GetDocumentbyKey( ipskey, True )
		If Not ipsdoc Is Nothing Then
			newdoc.FixedPrice = ipsdoc.ColumnValues( column )
			newdoc.ExtPrice = ipsdoc.ColumnValues( column ) * doc.InsQty(0)		
		Else
			newdoc.FixedPrice = 0
			newdoc.ExtPrice = 0
		End If
		newdoc.ODDesc = lInsertText
		
		newdoc.ODQty = doc.InsQty(0)		
		insertletter = "B"
		
		newdoc.ODInsType = "Lettered Right Insert"		
		newdoc.ODLetMsg = doc.ODLetMsg(0)
		newdoc.ODRAText = doc.RAText(0)		
		newdoc.ODColor_1 = doc.Color(0)		
		newdoc.ODLetStyle = doc.ODLetStyle(0)
		newdoc.ODLetColor = doc.ODLetColor(0)
		newdoc.ODLetUse = doc.ODLetUse(0)		
		newdoc.ODShape = doc.Shape(0)
		newdoc.ODSymbol = doc.ODSymbol(0)
		newdoc.ODSymbol_1 = doc.ODSymbol_1(0)		
		newdoc.ODArrowDir = doc.ODArrowDir(0)
		
		newdoc.ODSymbolImage = "C:\msimages\PG_" &amp; doc.ODSymbol(0) &amp; ".gif"
		newdoc.ODSymbolImage_1 = "C:\msimages\PG_" &amp; doc.ODSymbol_1(0) &amp; ".gif"
		newdoc.ODArrowImage = "C:\msimages\PG_" &amp; doc.ODArrowDir_1(0) &amp; ".gif"		
		
		newdoc.ODFormat = doc.ODFormat(0)
		If Right(doc.ODMod(0), 2) = "/B" Then
			newdoc.ODMod = doc.ODMod(0)
		Else
			newdoc.ODMod = doc.ODMod(0) &amp; "/" &amp; insertletter
		End If
		
		Call newdoc.MakeResponse(hdrdoc)				
		Call newdoc.Save( True, True)		
		Call view.Refresh
		
		doc.Action = "Save"
		doc.ODLetMsg = ""
		doc.RAText = ""		
		doc.ODSymbol = ""
		doc.ODSymbol_1 = ""		
		doc.ODArrowDir = ""
		doc.ODArrowDir_1 = ""		
		doc.ADAMsg_1  = ""		
		doc.ODLocation = ""		
		doc.SpIns = ""	
		doc.ODSpIns = ""			
		doc.InsQty = 1		
		doc.InstReq = "No"		
		doc.hPrice = ""		
		doc.hItemType = ""		
		Call doc.save(False, False)
		Call view.Refresh			
		unid = doc.UniversalID		
		Print "[/Innerface/Order+Entry.nsf/0/" &amp; unid &amp; "?EditDocument]"		
		
	Case "Blank Left Insert"
		If Right(doc.ODMod(0), 2) = "/A" Then
			ipskey = doc.ODMod(0) &amp; bLeftinserttext
		Else
			ipskey = doc.ODMod(0) &amp; "/A" &amp; bLeftinserttext
		End If
		Set ipsdoc = ipsview.GetDocumentbyKey( ipskey, True )
		If Not ipsdoc Is Nothing Then
			newdoc.FixedPrice = ipsdoc.ColumnValues( column )
			newdoc.ExtPrice = ipsdoc.ColumnValues( column ) * doc.BlankQty(0)		
		Else
			newdoc.FixedPrice = 0
			newdoc.ExtPrice = 0
		End If
		newdoc.ODDesc = bInsertText
		
		newdoc.ODBlankType = "Left Insert, Blank"		
		newdoc.ODQty = doc.BlankQty(0)
		
		insertletter = "A"
		
		newdoc.ODColor_2 = doc.Color(0)
		newdoc.ODShape_1 = doc.Shape(0)
		If Right(doc.ODMod(0), 2) = "/A" Then
			newdoc.ODMod = doc.ODMod(0)
		Else
			newdoc.ODMod = doc.ODMod(0) &amp; "/" &amp; insertletter
		End If	
		Call newdoc.MakeResponse(hdrdoc)		
		Call newdoc.Save( True, True)				
		Call view.Refresh
		
		doc.Action = "Save"
		doc.BlankQty = 1
		doc.ODLocation = ""		
		doc.SpIns = ""	
		doc.ODSpIns = ""			
		doc.InstReq = "No"		
		doc.hPrice = ""		
		doc.hItemType = ""		
		Call doc.save(False, False)
		Call view.Refresh			
		unid = doc.UniversalID		
		Print "[/Innerface/Order+Entry.nsf/0/" &amp; unid &amp; "?EditDocument]"
		
	Case "Blank Right Insert"
		If Right(doc.ODMod(0), 2) = "/B" Then
			ipskey = doc.ODMod(0) &amp; bRightinserttext
		Else
			ipskey = doc.ODMod(0) &amp; "/B" &amp; bRightinserttext
		End If
		Set ipsdoc = ipsview.GetDocumentbyKey( ipskey, True )
		If Not ipsdoc Is Nothing Then
			newdoc.FixedPrice = ipsdoc.ColumnValues( column )
			newdoc.ExtPrice = ipsdoc.ColumnValues( column ) * doc.BlankQty(0)		
		Else
			newdoc.FixedPrice = 0
			newdoc.ExtPrice = 0
		End If
		newdoc.ODDesc = bInsertText
		
		newdoc.ODBlankType = "Right Insert, Blank"		
		newdoc.ODQty = doc.BlankQty(0)
		
		insertletter = "B"
		
		newdoc.ODColor_2 = doc.Color(0)
		newdoc.ODShape_1 = doc.Shape(0)
		If Right(doc.ODMod(0), 2) = "/B" Then
			newdoc.ODMod = doc.ODMod(0)
		Else
			newdoc.ODMod = doc.ODMod(0) &amp; "/" &amp; insertletter
		End If	
		Call newdoc.MakeResponse(hdrdoc)		
		Call newdoc.Save( True, True)				
		Call view.Refresh
		
		doc.Action = "Save"
		doc.BlankQty = 1
		doc.ODLocation = ""		
		doc.SpIns = ""	
		doc.ODSpIns = ""			
		doc.InstReq = "No"		
		doc.hPrice = ""		
		doc.hItemType = ""		
		Call doc.save(False, False)
		Call view.Refresh			
		unid = doc.UniversalID		
		Print "[/Innerface/Order+Entry.nsf/0/" &amp; unid &amp; "?EditDocument]"
		
	Case "Special"
		newdoc.FixedPrice = 0
		Dim instring As String
		Dim textlines As Variant
		instring = ""
		textlines = doc.spInstructions
		Forall x In textlines
			If instring = "" Then
				instring = x
			Else
				instring = instring + crlf$ + x
			End If
		End Forall
		
		newdoc.ODDesc = instring
		newdoc.ODQty = doc.spQty(0)
		newdoc.ODMod = "See item description"
		Call newdoc.MakeResponse(hdrdoc)		
		Call newdoc.Save( True, True)				
		Call view.Refresh
		
		doc.Action = "Save"
		doc.spQty = 1
		doc.ODLocation = ""		
		doc.SpIns = ""	
		doc.ODSpIns = ""			
		doc.InstReq = "No"		
		doc.hPrice = ""		
		doc.hItemType = ""
		doc.spInstructions = ""
		Call doc.save(False, False)
		Call view.Refresh			
		unid = doc.UniversalID		
		Print "[/Innerface/Order+Entry.nsf/0/" &amp; unid &amp; "?EditDocument]"
		
	Case "Save"
		If doc.hUserInit(0) = "WEB" Then		
			hdrdoc.OHProject = ""
			hdrdoc.OHOrdStatus = "Web - In Process"
			Call hdrdoc.Save( True, True)		
			Set dc = hdrdoc.Responses
			Call dc.StampAll("hODStatus", "Web - In Process")
			Set confirmdoc = db.CreateDocument	
			Call hdrdoc.CopyAllItems( confirmdoc, True )
			confirmdoc.Form = "OrderConfirmation"
			Call confirmdoc.Save(True, False)
			confunid = confirmdoc.UniversalID	
			Print "[/Innerface/Order+Entry.nsf/0/" &amp; confunid &amp; "?EditDocument&amp;HdrUnid=" &amp; doc.HdrUnid(0) &amp; "&amp;TrackNumber=" &amp; tracknum &amp; "&amp;Random=" &amp; rndnum &amp; "]"
		Else
'since we're saving this new quote we need to increment the next quote number.
			Dim admindb As New NotesDatabase( db.server, "Innerface\Order Entry Administration.nsf")
			Dim adminview As Notesview
			Dim ordnum As String, key As String
			Dim thankyouord As String, zeros As String
			
			Set adminview = admindb.GetView( "(luOEUsers)" )
			key = "Quote Requestor"
			
			Dim numdoc As Notesdocument			
			Set numdoc = adminview.GetDocumentbyKey( key , True)
			ordnum = Cstr( numdoc.UP_NextNumber(0) )			
			numdoc.UP_NextNumber = numdoc.UP_NextNumber(0) + 1
			Call numdoc.Save( True, True)	
			
			
			If Cint(ordnum) &lt; 10 Then
				zeros = "0000"
			Else
				If Cint(ordnum) &lt; 100 Then
					zeros = "000"
				Else
					If Cint(ordnum) &lt; 1000 Then
						zeros = "00"
					Else
						If Cint(ordnum) &lt; 10000 Then
							zeros = "0"
						Else
							zeros = ""
						End If
					End If
				End If
			End If
			thankyouord = "Q" &amp; zeros &amp; Cstr(ordnum)
			
			hdrdoc.OHOrdStatus = "Web - Verify"
			hdrdoc.OHOrdNo = thankyouord
			Call hdrdoc.Save( True, True)		
			Set dc = hdrdoc.Responses
			Call dc.StampAll("hODStatus", "Web - Verify")
			Call dc.StampAll("OHOrdNo", thankyouord )
			
'create the new project document for the quote and set it up
			Dim projdb As New NotesDatabase( db.server, "Project Management\ProjectTrack.nsf" )		
			Dim projdoc As NotesDocument			
			Set projdoc = projdb.CreateDocument
			
			projdoc.form = "Project"
			projdoc.int_ext = "Interior"
			projdoc.dateCreated = Cdat( Today )
			projdoc.pmQuoteOrder = "Quote"
			projdoc.pmStatus = "Customer Service"
			projdoc.pmCustomer = hdrdoc.OHBill_CustNam(0)	
			projdoc.pmNumber = thankyouord
			projdoc.pmName = hdrdoc.OHBill_CustNam(0)	
			projdoc.pmCustNo = hdrdoc.OHBill_CustNo(0)
			projdoc.pmCtcName = hdrdoc.WebName(0)
			projdoc.pmCtcEmail = hdrdoc.WebEmail(0)
			projdoc.pmCtcPhone = "(" + hdrdoc.WebArea(0) + ")" + hdrdoc.WebExchange(0) + "-" + hdrdoc.WebPhone(0)
			projdoc.pmPONbr = "Request for Quote Only"
			projdoc.pmSalesRep = hdrdoc.RepNbr(0)
			projdoc.onLocation = "1"
			projdoc.hDept = "Customer Service"
			projdoc.hDateIn = Today
			projdoc.SearchDate = Cdat( Today )
			projdoc.pmTotalDays = 0
			
			Dim repdb As New NotesDatabase( db.server, "Sales\SalesRep.nsf" )	
			Set repview = repdb.GetView( "repsbyNumber" )
			repkey = hdrdoc.RepNbr(0)
			Set repdoc = repview.GetDocumentbyKey( repkey )
			projdoc.repsmgr = repdoc.repManager(0)
			
			Call projdoc.Save( False, False )
			
'we need to create a response document to show the movement from the web to the CSR		
			Set pmdoc = projdb.CreateDocument
			pmdoc.Form = "ProjectMovement"
			Call pmdoc.MakeResponse( projdoc )	
			pmdoc.pmNumber = thankyouord
			pmdoc.pmCustomer = projdoc.pmCustomer(0)
			pmdoc.pmCustNo = projdoc.pmCustNo(0)
			pmdoc.projDept = "Customer Service"
			pmdoc.projPerson = projdoc.pmCSRPlnr(0)
			pmdoc.projDateIn = Today
			pmdoc.projReason = "Web Quote Request"
			pmdoc.onLocationResp = "1"
			Call pmdoc.Save( True, True )
			
'Create header and detail documents in IPS			
			Call CreateIPSDocs( hdrdoc )
			
'send the quote requestor off to our very pleasant thank you page			
			quotenbr = thankyouord
			Print "[/Innerface/Order+Entry.nsf/QuoteThankYouForm?OpenForm&amp;QuoteNumber=" &amp; quotenbr &amp; "]"
		End If
		
	End Select
	
	Exit Sub 'Exit the sub before the errorhandler
	
ErrorHandler:
	Print("CreateWebOrderDetail - Error Number " + Cstr(Err) + " : " + Error$ + " on line number " + Cstr(Erl)) 
	Resume Next 'Continue where the agent encountered the last error
	
End Sub
</lotusscript></code><code event='Velcro'><lotusscript>Sub Velcro(Module As String, mounttype As String, view As NotesView, qty As Integer)
	
'declare everything	
	Dim s As New NotesSession
	Dim db As NotesDatabase
	Dim dc As NotesDocumentCollection	
	Dim doc As NotesDocument, newdoc As NotesDocument, moddoc As NotesDocument, hdrdoc As NotesDocument
	Dim modview As NotesView
	Dim hdrunid As String
	Dim nextnum As Integer
	Dim modkey As String
	
'declare error handling for entire script
	On Error Goto Errorhandler
	
'set up a few things	
	Set db = s.CurrentDatabase	
	Set doc = s.DocumentContext	
	
'here we check to determine if this frame can be mounted with velcro...if not we bail	
	Dim moduledb As New NotesDatabase( db.server, "Innerface\\Product Information.nsf")	
	Set modview = moduledb.GetView( "ModInsLookup")
	modkey = module
	Set moddoc = modview.GetDocumentbyKey( modkey )
	If ( mounttype = "VT" And moddoc.CR_VT(0) = "" ) Or ( mounttype = "VTHL" And moddoc.CR_VTHL(0) = "" ) Then
		Exit Sub
	End If
	
'get the next item number from the previously saved header document
	hdrunid = doc.HdrUnid(0)
	Set hdrdoc = db.GetDocumentbyUNID( hdrunid )
	hdrdoc.NextItemNum = hdrdoc.NextItemNum(0) + 1
	nextnum = hdrdoc.NextItemNum(0)
	Call hdrdoc.Save( True, True)
	
'Basic detail document setup	
	Set newdoc = db.CreateDocument
	newdoc.Form = "OEDtl"	
	newdoc.hODStatus = "Web - In Process"
	newdoc.hODCono = "II"
	newdoc.OHBill_CustNam = doc.CustName(0)
	newdoc.OHBill_CustNo = doc.CustNum(0)
	newdoc.OHOrdNo = doc.OrderNum(0)
	newdoc.hODDeliverDate = doc.OHDate(0)
	newdoc.ODItem = nextnum
	newdoc.ODLocation = doc.ODLocation(0)
	newdoc.ODSpIns = doc.ODSpIns(0)
	newdoc.InstReq = doc.InstReq(0)		
	newdoc.EditorsDetail = "Web User"
	newdoc.EditDatesDetail = Now
	newdoc.EditSequenceDetail = "1"
	
'determine the part number designator for the velcro or hook and loop mount
	If mounttype = "VT" Then
		newdoc.ODOther = "Velcro Tape Mount - Hook Only"
	Else
		If mounttype = "VTHL" Then
			newdoc.ODOther = "Velcro Hook and Loop Mount"
		End If
	End If
	newdoc.ODQty = qty
	
'Create the new detail document
	Call newdoc.MakeResponse(hdrdoc)				
	Call newdoc.Save( True, True)		
	Call view.Refresh
	
	Exit Sub 'Exit the sub before the errorhandler
	
ErrorHandler:
	Print("Error Number " + Cstr(Err) + " : " + Error$ + " on line number " + Cstr(Erl)) 
	Resume Next 'Continue where the agent encountered the last error
	
End Sub
</lotusscript></code><code event='CreateIPSDocs'><lotusscript>Sub CreateIPSDocs(webdoc As NotesDocument)
	
	Dim s As New NotesSession
	Dim db As NotesDatabase
	Dim ipsdb As New Notesdatabase( "", "Project Management\QuoteOrderProcessing.nsf")
	Dim priceview As NotesView
	Dim pricedoc As Notesdocument
	Dim rfqdc As NotesDocumentCollection
	Dim rfqdtl As NotesDocument
	Dim webhdrdoc As NotesDocument, webdtldoc As NotesDocument, qhdrdoc As Notesdocument, dtldoc As NotesDocument
	Dim nextitem As Integer
	Dim priceKey As String
	
'declare error handling for entire script
	On Error Goto Errorhandler
	
'the basic setup stuff
	nextitem = 1	
	Set db = s.CurrentDatabase
	Set priceview = ipsdb.GetView( "(luModStuffCat)" )	
	Set webhdrdoc = db.GetDocumentbyUnid( webdoc.Unid(0) )
	If Not webhdrdoc Is Nothing Then
		
'create and load an IPS header document for this quote
		Set qhdrdoc = ipsdb.Createdocument
		qhdrdoc.Form = "Header"
		
		qhdrdoc.hDbserver = db.Server
		qhdrdoc.hint_ext = "Interior"
		qhdrdoc.hProjNbr = webhdrdoc.OHOrdNo(0)
		qhdrdoc.opOrdNo = webhdrdoc.OHOrdNo(0)
		qhdrdoc.opOrdStatus = "Web Quote Received"
		qhdrdoc.opOrdDesc = "Request for quote submitted from the web on " + Cstr(Today)
		qhdrdoc.opAssignedTo = "Not Assigned"
		qhdrdoc.opCustNam = webhdrdoc.OHBill_CustNam(0)
		qhdrdoc.opEmail = webhdrdoc.WebEmail(0)
		qhdrdoc.opPhone = webhdrdoc.WebArea(0) + "-" + webhdrdoc.WebExchange(0) + "-" + webhdrdoc.WebPhone(0)
		qhdrdoc.opFax = webhdrdoc.FaxArea(0) + "-" + webhdrdoc.FaxExchange(0) + "-" + webhdrdoc.FaxPhone(0)
		qhdrdoc.opBillCustNo = webhdrdoc.OHBill_CustNo(0)
		qhdrdoc.opDate = Today
		qhdrdoc.opProject = webhdrdoc.OHOrdDesc(0)
		qhdrdoc.RepName = webhdrdoc.RepName(0)
		qhdrdoc.opInstInfo = "None"	
		qhdrdoc.opSpecialInst = webhdrdoc.OHBill_MiscInfo(0)
		
		Call qhdrdoc.Save( False, False )
		
'loop to load IPS detail documents	
		Dim rtitem As NotesRichTextItem
		Set rfqdc = webhdrdoc.Responses
		If Not rfqdc.Count = 0 Then
			Set rfqdtl = rfqdc.Getfirstdocument
			
			Do While Not rfqdtl Is Nothing
				Set dtldoc = ipsdb.Createdocument
				Call dtldoc.Makeresponse( qhdrdoc )
				dtldoc.Form = "ProjectDetail"
				dtldoc.hRepQuote = "0"
				dtldoc.opOrdNo = rfqdtl.OHOrdNo(0)
				dtldoc.opBillCustNo = rfqdtl.opBill_CustNo(0)
				dtldoc.spItemNum = nextitem
				dtldoc.dtCLoc = rfqdtl.ODLocation(0)
				dtldoc.dtCModule = Ucase( rfqdtl.ODMod(0) )
				dtldoc.dtCDesc = rfqdtl.ODDesc(0)
				dtldoc.dtCFormat = rfqdtl.ODFormat(0)
				dtldoc.dCSpIns = rfqdtl.ODSpIns(0)
				dtldoc.dtCQty = rfqdtl.ODQty(0)
				dtldoc.dtCLP = rfqdtl.ODArrowDir(0)
				dtldoc.dtCRP = rfqdtl.ODSymbol
				dtldoc.dtCMsg = rfqdtl.ODLetMsg(0)
				dtldoc.plainText = rfqdtl.ODLetMsg(0)
				dtldoc.dtCIRJCharacters = rfqdtl.ODRAText(0)				
				priceKey = Ucase(rfqdtl.ODMod(0)) + rfqdtl.ODDesc(0)
				Set pricedoc = priceview.GetDocumentByKey( priceKey, True )
				If Not pricedoc Is Nothing Then
					dtldoc.dtCPrice = pricedoc.ColumnValues( 8 )
					dtldoc.dtCXPrice = pricedoc.ColumnValues( 8 ) * rfqdtl.ODQty(0)
					dtldoc.dtCSize = pricedoc.ColumnValues( 3 )
				End If
				Call dtldoc.Save( False, False )					
				
				nextitem = nextitem + 1			
				Set rfqdtl = rfqdc.Getnextdocument( rfqdtl )
			Loop
		End If
		
	End If
	
	Exit Sub 'Exit the sub before the errorhandler
	
ErrorHandler:
	Print("CreateIPSDocs - Error Number " + Cstr(Err) + " : " + Error$ + " on line number " + Cstr(Erl)) 
	Resume Next 'Continue where the agent encountered the last error
	
End Sub</lotusscript></code>
