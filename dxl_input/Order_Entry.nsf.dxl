<par def='57'><run><font size='7pt' style='bold' name='Verdana' pitch='variable'
 truetype='true' familyid='20' color='red'/></run><button width='1in' widthtype='fixed'
 wraptext='true' edge='rounded' bgcolor='#ffe1b0' type='ok' htmlstyle='font-family:"Verdana"; font-size:7pt; color="darkslateblue"'
 extrahtmlattrs='tabindex=21'><code event='onClick' for='web'><javascript
>var f = document.forms[0]
f.Action.value = "Lettered Insert"

	if( f.ODMod.value == "2.1" | f.ODMod.value == "2.1/B" |  f.ODMod.value == "2.2" | f.ODMod.value == "2.2/B" | 
		f.ODMod.value == "4.1" | f.ODMod.value == "4.1/B" |  f.ODMod.value == "4.2" | f.ODMod.value == "4.2/B" | 
	 	f.ODMod.value == "4.1E" | f.ODMod.value == "4.1E/B" |  f.ODMod.value == "4.2E" | f.ODMod.value == "4.2E/B" |
		f.ODMod.value == "4.3" | f.ODMod.value == "4.3/B" |  f.ODMod.value == "4.4" | f.ODMod.value == "4.4/B" | 
	 	f.ODMod.value == "4.8" | f.ODMod.value == "4.8/B" | f.ODMod.value == "4.99" | f.ODMod.value == "4.99/B" |
	 	f.ODMod.value == "6.1" | f.ODMod.value == "6.1/B" | f.ODMod.value == "6.2" | f.ODMod.value == "6.2/B" | 
		f.ODMod.value == "6.3" | f.ODMod.value == "6.3/B" | f.ODMod.value == "6.4" | f.ODMod.value == "6.4/B" | 
 		f.ODMod.value == "2.11" | f.ODMod.value == "2.11/B" |  f.ODMod.value == "2.22" | f.ODMod.value == "2.22/B" |
		f.ODMod.value == "4.11" | f.ODMod.value == "4.11/B" |  f.ODMod.value == "4.22" | f.ODMod.value == "4.22/B" |
		f.ODMod.value == "4.33" | f.ODMod.value == "4.33/B" |  f.ODMod.value == "4.44" | f.ODMod.value == "4.44/B" | f.ODMod.value == "4.55" |  
		f.ODMod.value == "4.88" | f.ODMod.value == "4.88/B" |  f.ODMod.value == "4.99" |f.ODMod.value == "5.5PW" | f.ODMod.value == "6.11" | f.ODMod.value == "6.11/B" |
 		f.ODMod.value == "6.22" | f.ODMod.value == "6.22/B" | f.ODMod.value == "6.33" | f.ODMod.value == "6.33/B" | 
		f.ODMod.value == "6.44" | f.ODMod.value == "6.44/B" | f.ODMod.value == "17.25" | f.ODMod.value == "17.25/B" |
		f.ODMod.value == "17.50L" | f.ODMod.value == "17.50L/B" | f.ODMod.value == "17.50W" | f.ODMod.value == "17.50W/B" |
		f.ODMod.value == "17.100" | f.ODMod.value == "17.100/B" |f.ODMod.value == "17.150" | f.ODMod.value == "17.150/B" |
		f.ODMod.value == "17.200" | f.ODMod.value == "17.200/B" | f.ODMod.value == "17.250" | f.ODMod.value == "17.250/B" |
		f.ODMod.value == "17.300" | f.ODMod.value == "17.300/B" |
		f.ODMod.value == "10.0" | f.ODMod.value == "10.1" |  f.ODMod.value == "11.0" | f.ODMod.value == "11.1" | 
	 	f.ODMod.value == "12.0" | f.ODMod.value == "12.1" |  f.ODMod.value == "13.0" | f.ODMod.value == "13.1" |
		f.ODMod.value == "14.0" | f.ODMod.value == "14.1" |  f.ODMod.value == "15.0" | f.ODMod.value == "15.1" | 
	 	f.ODMod.value == "16.0" | f.ODMod.value == "16.1" | f.ODMod.value == "16.25" | f.ODMod.value == "24.0" |
	 	f.ODMod.value == "24.1" | f.ODMod.value == "24.2" | f.ODMod.value == "24.3" ) { 
			f.Action.value = "Lettered Strip"
		}
	else {
		f.Action.value = "Lettered Insert"
	}	
	
if( f.ODMod.value == "8.12" | f.ODMod.value == "8.12/B" |  f.ODMod.value == "8.14" | f.ODMod.value == "8.14/B") {
		f.Action.value = "Lettered Main Insert"
}
		
if( f.ODMod.value == "" ) {
  alert( "You must select a module type before adding a strip insert.")
  f.ODMod.focus()
   return false
}   
if( f.Color.value == "") {
   alert("You must select a color for this module type before adding a strip insert.")
   f.Color.focus()
   return false
}
if( f.Shape.value == "") {
   alert("You must select a shape for this module type before adding a strip insert.")
   f.Shape.focus()
   return false
}
if( f.ODLetMsg.value == "" ) {
  alert( "You must enter the message text for a strip insert.")
  f.ODLetMsg.focus()
   return false
}   
if( f.ODLetStyle.value == "") {
   alert("You must select a type style for this strip insert.")
   f.ODLetStyle.focus()
   return false
}
if( f.ODFormat.value == "") {
   alert("You must select a lettering format for this strip insert.")
   f.ODFormat.focus()
   return false
}
if( f.ODLetColor.value == "") {
   alert("You must select a font color for this strip insert.")
   f.ODLetColor.focus()
   return false
}
   if( f.InsQty == "") {
   alert("You must enter a quantity for this strip insert.")
   f.InsQty.focus()
   return false
}
if ((f.ODMod.value ==  "17.100" || f.ODMod.value == "17.150" || f.ODMod.value == "17.200" || f.ODMod.value == "17.25" ||
		 f.ODMod.value == "17.50L" ||  f.ODMod.value == "17.50W") &amp;&amp; (f.ODStripWidth.value != 1 &amp;&amp; f.ODStripWidth.value != 2)) {
   		alert("You must strip width when ordering strips for a main directory sign.");
   		f.ODStripWidth.focus();
   return false
}

f.submit()</javascript></code><font size='7pt' name='Verdana' pitch='variable'
 truetype='true' familyid='20'/>Add Insert/Strip to Quote</button><run><font
 size='7pt' style='bold' name='Verdana' pitch='variable' truetype='true' familyid='20'
 color='red'/></run></par></tablecell>
