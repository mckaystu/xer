<par def='9'/>
<table widthtype='fixedcenter' refwidth='7.3194in'><tablecolumn width='7.3194in'/>
<tablerow>
<tablecell borderwidth='0px'>
<pardef id='10' align='center' leftmargin='0.0104in' keepwithnext='true' keeptogether='true'/>
<par def='10'><run><font style='bold' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>[&lt;br&gt;]</run></par>
<par def='10'><run><font style='bold' name='Arial' pitch='variable' truetype='true'
 familyid='20' color='#00b8e0'/>Your order has been forwarded to Innerface Customer Service.</run></par>
<par def='10'><run><font size='9pt' style='bold' name='Arial' pitch='variable'
 truetype='true' familyid='20' color='#00b8e0'/>You will receive confirmation of receipt of your order via email.  Please make a note of the number below or print this page using your browser's print function</run><run
><font size='9pt' style='bold' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>.</run></par>
<par def='10'><run><font style='bold' name='Arial' pitch='variable' truetype='true'
 familyid='20'/></run></par>
<par def='10'><run><font style='bold' name='Arial' pitch='variable' truetype='true'
 familyid='20'/>Your order number is:  </run><run><font color='red' style='bold'
 name='Arial' pitch='variable' truetype='true' familyid='20'/><field type='text'
