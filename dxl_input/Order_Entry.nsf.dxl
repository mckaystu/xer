<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby><code event='webquerysave'><formula
>@Command([ToolsRunMacro]; "(MarkDupeComplete)")</formula></code><code event='jsheader'
 for='web'><javascript>function windowopener(u,h,w) {
args = "height=" + h + ", width=" + w + ",dependent=yes,resizable=yes,scrollbars=yes,status=0"
window.open (u, "User_Addresses", args);
window.setInterval("checkrefresh()",1000);
}
function checkrefresh() {
var f = document.forms[0];

	if (f.RefreshFlag.value == "1") {	
	f.RefreshFlag.value = ""
	_doClick('$Refresh',this,'_self','#_RefreshKW_RefreshKWField');
	window.clearInterval;
	}
}
</javascript></code>
<background allowoverride='false'/>
<body><richtext>
<pardef id='1' leftmargin='1in'><code event='hidewhen'><formula>@True</formula></code></pardef>
<par def='1'><run><font size='7pt' name='Verdana' pitch='variable' truetype='true'
 familyid='20' color='gray'/>Hidden Fields </run></par>
<par def='1'><run><font size='7pt' name='Verdana' pitch='variable' truetype='true'
 familyid='20' color='gray'/>Cust num </run><run><font size='7pt' color='gray'
 name='Verdana' pitch='variable' truetype='true' familyid='20'/><field type='text'
 kind='computed' name='CustNum'><code event='defaultvalue'><formula>temp := @UserName;
@If( temp = "Anonymous" ; "" ; @NameLookup( [TrustedOnly] ; temp ; "EmployeeID"))</formula></code></field></run><run
><font size='7pt' name='Verdana' pitch='variable' truetype='true' familyid='20'
 color='gray'/> </run></par>
<par def='1'><run><font size='7pt' name='Verdana' pitch='variable' truetype='true'
 familyid='20' color='gray'/>Name  </run><run><font size='7pt' color='gray'
 name='Verdana' pitch='variable' truetype='true' familyid='20'/><field type='authors'
 kind='computed' name='CustName'><code event='defaultvalue'><formula>@UserName</formula></code><code
 event='terminate'><lotusscript>Sub Terminate
	
End Sub</lotusscript></code></field></run><run><font size='7pt' name='Verdana'
 pitch='variable' truetype='true' familyid='20' color='gray'/> </run></par>
<par def='1'><run><font size='7pt' name='Verdana' pitch='variable' truetype='true'
 familyid='20' color='gray'/>Query string</run><run><font size='7pt' color='gray'
 name='Verdana' pitch='variable' truetype='true' familyid='20'/><field type='text'
 kind='editable' name='Query_String' extrahtmlattrs='maxlength=40'/></run><run
><font size='7pt' name='Verdana' pitch='variable' truetype='true' familyid='20'
 color='gray'/></run></par>
<par def='1'><run><font size='7pt' name='Verdana' pitch='variable' truetype='true'
 familyid='20' color='gray'/>new order </run><run><font size='7pt' color='gray'
 name='Verdana' pitch='variable' truetype='true' familyid='20'/><field type='text'
 kind='editable' name='NewOrder'><code event='defaultvalue'><formula>temp := @Right( Query_String; "&amp;Order=" );
@LeftBack(temp ; "&amp;Unid=")</formula></code></field></run><run><font size='7pt'
 name='Verdana' pitch='variable' truetype='true' familyid='20' color='gray'/></run></par>
<par def='1'><run><font size='7pt' name='Verdana' pitch='variable' truetype='true'
 familyid='20' color='gray'/>hdr unid:    </run><run><font size='7pt' color='gray'
 name='Verdana' pitch='variable' truetype='true' familyid='20'/><field type='text'
 kind='editable' name='HdrUnid'><code event='defaultvalue'><formula>@Right( Query_String; "&amp;Unid=" )</formula></code></field></run><run
><font size='7pt' name='Verdana' pitch='variable' truetype='true' familyid='20'
 color='gray'/></run></par>
<pardef id='2' leftmargin='1in'/>
<par def='2'><run><font size='7pt' name='Verdana' pitch='variable' truetype='true'
 familyid='20'/><field type='text' kind='computedfordisplay' name='CustLogo'><code
 event='defaultvalue'><formula>db := "Innerface\\NRFCFILE.nsf";
temp := @DbLookup( "" ; "85256865:00528CE8" ; "(Lookup)" ; CustNum  ; 2 ) ;
htmlPre := @If(@IsError(temp) ; @DbLookup( "" ; "85256865:00528CE8" ; "(Lookup)" ; "Innerface"  ; 2 ) ; temp);
finalhtml := @ReplaceSubstring(htmlPre ; " " ; "+");
"[&lt;img src = \"" + finalhtml + "\"&gt;]"</formula></code></field></run><run
><font size='9pt' style='bold' name='Arial' pitch='variable' truetype='true'
 familyid='20'/></run></par>
<table widthtype='fixedleft' refwidth='2.5000in'><tablecolumn width='1.0736in'/><tablecolumn
 width='1.4264in'/>
