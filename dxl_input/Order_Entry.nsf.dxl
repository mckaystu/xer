><text>Signature Series | Signature</text><text>Standard Plaques | Standard</text><text
>ARQ | ARQ</text></textlist></keywords><code event='defaultvalue'><formula
>"Signature Series"</formula></code><code event='onClick' for='web'><javascript
>var f = document.forms[0];

signtype = -1

for (i=0; i &lt; f.SignType.length; i++) {
	if (f.SignType[i].checked)
 		signtype = i	
	}
	
if (signtype == 1) {
		f.SignType.value = "Standard"
		window.open( "/Project+Management/IPSPricing.nsf/WebStandardSigns?OpenForm" , "", "HEIGHT=600,WIDTH=800,SCROLLBARS=YES,RESIZABLE=YES" )
}
else {
	if (signtype == 2) {
	f.ODSpIns.value = ""
	f.SignType.value = "ARQ"			
	f.ODMod.value = ""
	f.Color.value = ""
	f.Shape.value = "N/A"
	window.open( "/Project+Management/IPSPricing.nsf/WebConvexSigns?OpenForm" , "", "HEIGHT=500,WIDTH=800,RESIZABLE=YES,SCROLLBARS=YES,RESIZABLE=YES" )
	}
	else {
		f.sModule.value = ""
		f.ODMod.value = ""
		f.SignType.value = "Signature Series"
		f.Color.value = ""
		f.Shape.value = ""
		f.sModuleDesc.value = ""
		f.sMessage.value = ""
		f.sQuantity.value = 0
		f.sShape.value == ""
		f.sInsColor.value == ""
		f.sLetterColor.value == ""
		f.sSpIns.value = ""
		f.ODSpIns.value = ""
		}
	}	
	
checkrefresh()</javascript></code><code event='onClick' for='client'><javascript
>var f = document.forms[0];

signtype = -1

for (i=0; i &lt; f.SignType.length; i++) {
	if (f.SignType[i].checked)
 		signtype = i	
	}
	
if (signtype == 1) {
		window.open( "/Project+Management/PricingIPS.nsf/WebStandardSigns?OpenForm" , "", "HEIGHT=600,WIDTH=800,SCROLLBARS=YES" )
}
else {
		if (signtype == 2) {
		f.ODSpIns.value = "Stoneedge"
		f.ODMod.value = ""
		f.Color.value = ""
		f.Shape.value = ""			
		}
		else {
			if (signtype == 3) {
			f.ODSpIns.value = "Convex+"
			f.ODMod.value = ""
			f.Color.value = ""
			f.Shape.value = ""
			}
		else {
			f.sModule.value = ""
			f.ODMod.value = ""
			f.Color.value = ""
			f.Shape.value = ""
			f.sModuleDesc.value = ""
			f.sMessage.value = ""
			f.sQuantity.value = 0
			f.sShape.value == ""
			f.sInsColor.value == ""
			f.sLetterColor.value == ""
			f.sSpIns.value = ""
			f.ODSpIns.value = ""
			}
		}
	}	
	
checkrefresh()</javascript></code></field></run><run><font size='7pt' name='Verdana'
