<agent name='(CreateWebOrderDetail)' hide='v3' publicaccess='false' designerversion='7'
 restrictions='unrestricted'>
<noteinfo noteid='7fa' unid='F8E52B16FE0C652285256911005B6F63' sequence='356'>
<created><datetime dst='true'>20000703T123842,91-04</datetime></created>
<modified><datetime>20120328T010531,74-05</datetime></modified>
<revised><datetime>20120327T091006,00-05</datetime></revised>
<lastaccessed><datetime>20120328T010531,74-05</datetime></lastaccessed>
<addedtofile><datetime>20030211T095902,80-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby>
<designchange><datetime>20120327T091006,00-05</datetime></designchange>
<trigger type='agentlist'/>
<documentset type='runonce'/><code event='options'><lotusscript>Option Public
Option Declare

</lotusscript></code><code event='declarations'><lotusscript>Dim dummypart As String
Dim insertletter As String
Dim partnum As String
Dim insertcolor As String
Dim noletter As Variant
Dim shape As String
Dim pictostring As String
Dim pictotext As Variant

Const Frametext = "Frame"
Const IDFrametext = "InnerDot Frame with Braille Translation"
Const FrameIU = |Frame with "In Use/Enter" Slider Bar|
Const IDFrameIU = |InnerDot Frame with Braille Translation with "In Use/Enter" Slider Bar|
Const MainFrametextR = "Main Directory Frame - Radius"
Const MainFrametextS = "Main Directory Frame - Square"

Const lInserttext = "Lettered Insert"
Const bInserttext = "Blank Insert"

Const lStriptext = "Lettered Strip"
Const bStriptext = "Blank Strip"
Const lHalfInchStripText = |1/2" Lettered Strip|
Const lOneInchStripText = |1" Lettered Strip|
Const bHalfInchStripText = |1/2" Blank Strip|
Const bOneInchStripText = |1" Blank Strip|

Const lBasetext = "Lettered Base"
Const bBasetext = "Blank Base"

Const lHeadertext = "Lettered Header"
Const bHeadertext = "Blank Header"

Const lTopinserttext = "Lettered Top Insert"
Const bTopinserttext = "Blank Top Insert"

Const lBottominserttext = "Lettered Bottom Insert"
Const bBottominserttext = "Blank Bottom Insert"

Const lLeftinserttext = "Lettered Left Insert"
Const bLeftinserttext = "Blank Left Insert"

Const lRightinserttext = "Lettered Right Insert"
Const bRightinserttext = "Blank Right Insert"

Const lMaininserttext = "Lettered Main Insert"
Const bMaininserttext = "Blank Main Insert"

Const lCustomHeadertext = "Custom Header"
</lotusscript></code><code event='initialize'><lotusscript>Sub Initialize
'This script will save the detail information for an order and present a final form to the user 
	'allowing them to confirm the order.
	
'declare everything	
	Dim s As New NotesSession
	Dim db As NotesDatabase
	Dim dc As NotesDocumentCollection	
	Dim doc As NotesDocument, newdoc As NotesDocument, hdrdoc As NotesDocument, maildoc As NotesDocument
	Dim moddoc As NotesDocument, confirmdoc As NotesDocument, ipsdoc As Notesdocument
	Dim repdoc As NotesDocument, pmdoc As NotesDocument
	Dim view As NotesView, modview As NotesView, repview As NotesView, ipsview As Notesview
	Dim modkey As String, custkey As String
	Dim unid As String, hdrunid As String, confunid As String, quotenbr As String
	Dim nextnum As Integer, rightlen As Integer
	Dim repkey As String, ipskey As String
	Dim modright As String
	Dim module As String
	Dim temp As Long
	Dim period As String
	Dim modstring As String, zerostring As String
	Dim reqtype As String
	Dim insertletter As String
	Dim numlen As Integer
	Dim nums As Integer
	Dim numzeros As Integer
	Dim charzero As String
	Dim tracknum As String
	Dim rndnum As String
	Dim crlf As String
	Dim pricelist As String
	Dim column As Integer
	Dim stripwidth As String
	Dim symbol As Variant
	
'declare error handling for entire script
	On Error Goto Errorhandler
	
'set up a few things
	crlf$ = Chr(13) &amp; Chr(10) 
	Set db = s.CurrentDatabase	
	Dim ipsdb As New Notesdatabase( db.Server, "Project Management\IPSPricing.nsf") 	
	Set ipsview = ipsdb.GetView( "(luPricingDesc)" )
	
	Set doc = s.DocumentContext
	Set view = db.GetView( "(DetailsbyTrackNumber)" )
	
'get the next item number from the previously saved header document
	hdrunid = doc.HdrUnid(0)
	Set hdrdoc = db.GetDocumentbyUNID( hdrunid )
	hdrdoc.NextItemNum = hdrdoc.NextItemNum(0) + 1
	nextnum = hdrdoc.NextItemNum(0)
	
'save the header doc	
	Call hdrdoc.Save( True, True)
	
	modkey = doc.ODMod(0)
	
	insertletter = "0"
	
'format the module number
	modstring = doc.ODMod(0)	
	period = "."
	temp = Instr(1, modstring , period)
	If (temp = 2) Then
		module = "0" &amp; modstring 
	Else
		module = modstring
	End If
	modright = Strright( modstring, period  )
	rightlen = Len(modright)
	
	If rightlen = 1 Then
		zerostring = "00"
	Else
		If rightlen = 2 Then
			zerostring = "0"
		Else
			zerostring = ""
		End If
	End If
	
	tracknum = doc.OrderNum(0)
	rndnum = doc.hRndOrd(0)
	
	Set newdoc = db.CreateDocument
	newdoc.Form = "OEDtl"	
	newdoc.hTrackNumber = doc.OrderNum(0)
	newdoc.hRndOrd = doc.hRndOrd(0)	
	newdoc.hODStatus = "Web - In Process"
	newdoc.hODCono = "II"
	newdoc.OHBill_CustNam = doc.CustName(0)
	newdoc.OHBill_CustNo = doc.CustNum(0)
	newdoc.OHOrdNo = "Assigned When Submitted"
	newdoc.hODDeliverDate = doc.OHDate(0)
	newdoc.ODMod = doc.ODMod(0)
	newdoc.ODItem = nextnum
	newdoc.ODLocation = doc.ODLocation(0)	
	newdoc.ODSpIns = doc.ODSpIns(0)	
	newdoc.InstReq = doc.InstReq(0)		
	newdoc.EditorsDetail = "Web User"
	newdoc.EditDatesDetail = Now
	newdoc.EditSequenceDetail = "1"
	
	pricelist = doc.hPriceList(0)
	If pricelist = "BAS" Or pricelist = "" Then
		column = 8
	Else
		If pricelist = "GSA" Then
			column = 7
		Else
			If pricelist = "OMH" Then
				column = 9
			Else
				column = 10
			End If
		End If
	End If
	
'case structure to create a new item record	
	Select Case doc.Action(0)
		
	Case "Cancel"
		Set dc = hdrdoc.Responses
		If dc.Count &gt;0 Then
			Call dc.RemoveAll(True)
		End If
		Call hdrdoc.Remove(True)
		Print "[/Innerface/Order+Entry.nsf/Web+Select?OpenForm]"
		Exit Sub
		
	Case "Standard"	
		ipskey = doc.sModule(0) &amp; doc.sModuleDesc(0)
		Set ipsdoc = ipsview.GetDocumentbyKey( ipskey, True )
		If Not ipsdoc Is Nothing Then		
			newdoc.FixedPrice = ipsdoc.ColumnValues( column )
			newdoc.ExtPrice = newdoc.FixedPrice(0) * doc.sQuantity(0)
		Else
			newdoc.FixedPrice = 0
			newdoc.ExtPrice = 0
		End If
		newdoc.ODMod = doc.sModule(0)
		newdoc.ODDesc = doc.sModuleDesc(0)
		newdoc.ODLocation = doc.ODLocation(0)
		newdoc.ODQty = doc.sQuantity(0)
		newdoc.ODInnerDot = "Yes"
		
		newdoc.ODColor = doc.sInsColor(0)
		newdoc.ODFrMountMtl = |Foam Tape for "Flat Surface Mounted (FSM)"|
		newdoc.ODFrMount = "Flat Surface Mounted (FSM)"
		newdoc.ODFrShape = doc.sShape(0)
		
		newdoc.ODInsType = ""
		newdoc.ADACompliant_1 = "Yes"
		newdoc.ODColor_1 = doc.sInsColor(0)
		newdoc.ODLetStyle = doc.sLetterStyle(0)
		newdoc.ODLetColor = doc.sLetterColor(0)
		newdoc.ODLetUse = doc.sLetterFormat(0)
		newdoc.ODShape = doc.sShape(0)
		
		'pictostring = |@Left(sMessage; " ")|
		'pictotext = Evaluate(pictostring, doc)
		newdoc.ADAMsg = ""
		newdoc.ADACompliant = "Yes"	
		newdoc.ODSymbol = ""
		
		'pictostring = |@Right(sMessage; " ")|
		'pictotext = Evaluate(pictostring, doc)
		newdoc.ODLetMsg = doc.sMessage(0)
		
		newdoc.ODSpIns = doc.sSpIns(0)
		
		Call newdoc.MakeResponse(hdrdoc)
		Call newdoc.Save(True, True)	
		
		doc.Action = "Save"
		doc.sModule = ""
		doc.sModuleDesc = ""
		doc.sMessage  = ""
		doc.sQuantity = 0
		doc.sShape = ""
		doc.sInsColor = ""		
		doc.sLetterColor = ""				
		doc.sLetterStyle = ""
		doc.sLetterFormat = ""				
		doc.ODLocation = ""		
		doc.sSpIns = ""		
		doc.hPrice = ""
		doc.hItemType = ""
		
		Call doc.Save(False, False)
		Call view.Refresh
		unid = doc.UniversalID
		Print "[/Innerface/Order+Entry.nsf/0/" &amp; unid &amp; "?EditDocument]"
		
	Case "ARQ Frame"	
		ipskey = doc.ODMod(0) &amp; doc.hCXDesc(0)
		Set ipsdoc = ipsview.GetDocumentbyKey( ipskey, True )
		If Not ipsdoc Is Nothing Then		
			newdoc.FixedPrice = ipsdoc.ColumnValues( column )
			newdoc.ExtPrice = newdoc.FixedPrice(0) * doc.FrameQty(0)
		Else
			newdoc.FixedPrice = 0
			newdoc.ExtPrice = 0
		End If
		newdoc.ODMod = doc.ODMod(0)
		newdoc.ODDesc = doc.hCXDesc(0)
		newdoc.ODLocation = doc.ODLocation(0)
		newdoc.ODQty = doc.sQuantity(0)
		newdoc.ODInnerDot = doc.ADACompliant(0)
		
		newdoc.ODColor = doc.sInsColor(0)
		newdoc.ODFrMountMtl = |Foam Tape for "Flat Surface Mounted (FSM)"|
		newdoc.ODFrMount = "Flat Surface Mounted (FSM)"
		newdoc.ODFrShape = "N/A"
		
		newdoc.ODInsType = ""
		newdoc.ADACompliant_1 = doc.ADACompliant(0)
		newdoc.ODColor_1 = doc.Color(0)
		newdoc.ODLetStyle = ""
		newdoc.ODLetColor = ""
		newdoc.ODLetUse = ""
		newdoc.ODShape = "N/A"
		
		newdoc.ADAMsg = doc.ADAMsg(0)
		newdoc.ADACompliant = doc.ADACompliant(0)
		newdoc.ODSymbol = ""
		
		newdoc.ODLetMsg = ""
		
		newdoc.ODSpIns = doc.ODSpIns(0)
		
		Call newdoc.MakeResponse(hdrdoc)
		Call newdoc.Save(True, True)	
		
		doc.Action = "Save"
		doc.ODLocation = ""		
		doc.SpIns = ""	
		doc.ODSpIns = ""			
		doc.hPrice = ""
		doc.hCxDesc = ""
		
		Call doc.Save(False, False)
		Call view.Refresh
		unid = doc.UniversalID
		Print "[/Innerface/Order+Entry.nsf/0/" &amp; unid &amp; "?EditDocument]"
		
	Case "Frame"
		If doc.ODMod(0) = "4.5" Then
			ipskey = doc.ODMod(0) &amp; FrameIU
			newdoc.ODDesc = FrameIU
		Else
			If doc.ODMod(0) = "4.5-ID" Then
				ipskey = doc.ODMod(0) &amp; IDFrameIU
				newdoc.ODDesc = IDFrameIU
			Else
				If Right(doc.ODMod(0), 3) = "-ID" Then
					ipskey = doc.ODMod(0) &amp; IDFrametext
					newdoc.ODDesc = IDFrameText
				Else
					ipskey = doc.ODMod(0) &amp; Frametext
					newdoc.ODDesc = FrameText
				End If
			End If
		End If
		
		Set ipsdoc = ipsview.GetDocumentbyKey( ipskey, True )
		If Not ipsdoc Is Nothing Then
			newdoc.FixedPrice = ipsdoc.ColumnValues( column )
			newdoc.ExtPrice = ipsdoc.ColumnValues( column ) * doc.FrameQty(0)		
		Else
			newdoc.FixedPrice = 0
			newdoc.ExtPrice = 0
		End If
		newdoc.ODFrMount = doc.ODFrMount(0)		
		newdoc.ODFrMountMtl = doc.ODFrMountMtl(0)		
		newdoc.ODQty = doc.FrameQty
		
		newdoc.ADAMsg = doc.ADAMsg(0)		
		newdoc.ODColor = doc.Color(0)
		newdoc.ADACompliant = doc.ADACompliant(0)		
		newdoc.ODFrShape = doc.Shape(0)
		
		Call newdoc.MakeResponse(hdrdoc)
		Call newdoc.Save(True, True)	
		
		If ( doc.ODFrMountMtl(0) = "VT" Or doc.ODFrMountMtl(0) = "VTHL" ) Then
			Call Velcro(doc.ODMod(0), doc.ODFrMountMtl(0), view, doc.FrameQty(0))
		End If
		
		doc.Action = "Save"
		doc.ODFrMount = ""
		doc.ODFrMountMtl = ""
		doc.ODLocation = ""		
		doc.SpIns = ""	
		doc.ODSpIns = ""
		doc.InstReq = "No"
		doc.ADACompliant = ""
		doc.ADAMsg  = ""
		doc.FrameQty = 1		
		doc.hPrice = ""
		doc.hItemType = ""
		Call doc.Save(False, False)
		Call view.Refresh
		unid = doc.UniversalID
		Print "[/Innerface/Order+Entry.nsf/0/" &amp; unid &amp; "?EditDocument]"
		
	Case "Main Directory Frame - Radius"
		ipskey = doc.ODMod(0) &amp; MainFrametextR
		newdoc.ODDesc = MainFrametextR
		
		Set ipsdoc = ipsview.GetDocumentbyKey( ipskey, True )
		If Not ipsdoc Is Nothing Then
			newdoc.FixedPrice = ipsdoc.ColumnValues( column )
			newdoc.ExtPrice = ipsdoc.ColumnValues( column ) * doc.FrameQty(0)		
		Else
			newdoc.FixedPrice = 0
			newdoc.ExtPrice = 0
		End If
		newdoc.ODFrMount = doc.ODFrMount(0)		
		newdoc.ODFrMountMtl = doc.ODFrMountMtl(0)		
		newdoc.ODQty = doc.FrameQty
		
		newdoc.ADAMsg = ""
		newdoc.ODColor = doc.Color(0)
		newdoc.ADACompliant = "No"
		newdoc.ODFrShape = doc.Shape(0)
		
		Call newdoc.MakeResponse(hdrdoc)
		Call newdoc.Save(True, True)	
		
		If ( doc.ODFrMountMtl(0) = "VT" Or doc.ODFrMountMtl(0) = "VTHL" ) Then
			Call Velcro(doc.ODMod(0), doc.ODFrMountMtl(0), view, doc.FrameQty(0))
		End If
		
		doc.Action = "Save"
		doc.ODFrMount = ""
		doc.ODFrMountMtl = ""
		doc.ODLocation = ""		
		doc.SpIns = ""	
		doc.ODSpIns = ""
		doc.InstReq = "No"
		doc.ADACompliant = ""
		doc.ADAMsg  = ""
		doc.FrameQty = 1		
		doc.hPrice = ""
		doc.hItemType = ""
		Call doc.Save(False, False)
		Call view.Refresh
		unid = doc.UniversalID
		Print "[/Innerface/Order+Entry.nsf/0/" &amp; unid &amp; "?EditDocument]"
		
	Case "Main Directory Frame - Square"
		ipskey = doc.ODMod(0) &amp; MainFrametextS
		newdoc.ODDesc = MainFrametextS
		
		Set ipsdoc = ipsview.GetDocumentbyKey( ipskey, True )
		If Not ipsdoc Is Nothing Then
			newdoc.FixedPrice = ipsdoc.ColumnValues( column )
			newdoc.ExtPrice = ipsdoc.ColumnValues( column ) * doc.FrameQty(0)		
		Else
			newdoc.FixedPrice = 0
			newdoc.ExtPrice = 0
		End If
		newdoc.ODFrMount = doc.ODFrMount(0)		
		newdoc.ODFrMountMtl = doc.ODFrMountMtl(0)		
		newdoc.ODQty = doc.FrameQty
		
		newdoc.ADAMsg = ""
		newdoc.ODColor = doc.Color(0)
		newdoc.ADACompliant = "No"
		newdoc.ODFrShape = doc.Shape(0)
		
		Call newdoc.MakeResponse(hdrdoc)
		Call newdoc.Save(True, True)	
		
		If ( doc.ODFrMountMtl(0) = "VT" Or doc.ODFrMountMtl(0) = "VTHL" ) Then
			Call Velcro(doc.ODMod(0), doc.ODFrMountMtl(0), view, doc.FrameQty(0))
		End If
		
		doc.Action = "Save"
		doc.ODFrMount = ""
		doc.ODFrMountMtl = ""
		doc.ODLocation = ""		
		doc.SpIns = ""	
		doc.ODSpIns = ""
		doc.InstReq = "No"
		doc.ADACompliant = ""
		doc.ADAMsg  = ""
		doc.FrameQty = 1		
		doc.hPrice = ""
		doc.hItemType = ""
		Call doc.Save(False, False)
		Call view.Refresh
		unid = doc.UniversalID
		Print "[/Innerface/Order+Entry.nsf/0/" &amp; unid &amp; "?EditDocument]"
		
	Case "Lettered Insert" 
		If Right(doc.ODMod(0), 2) = "/A" Then
			ipskey = doc.ODMod(0) &amp; lInserttext	
		Else
			ipskey = doc.ODMod(0) &amp; "/A" &amp; lInserttext
		End If
		
		Set ipsdoc = ipsview.GetDocumentbyKey( ipskey, True )
		If Not ipsdoc Is Nothing Then		
			newdoc.FixedPrice = ipsdoc.ColumnValues( column )
			newdoc.ExtPrice = ipsdoc.ColumnValues( column ) * doc.InsQty(0)
		Else
			newdoc.FixedPrice = 0
			newdoc.ExtPrice = 0
		End If
		
		newdoc.ODDesc = lInsertText
		newdoc.ODQty = doc.InsQty(0)		
		insertletter = "A"
		
		newdoc.ODInsType = "Lettered Insert"		
		newdoc.ODLetMsg = doc.ODLetMsg(0)
		newdoc.ODRAText = doc.RAText(0)
		newdoc.ODColor_1 = doc.Color(0)		
		newdoc.ODLetStyle = doc.ODLetStyle(0)
		newdoc.ODLetColor = doc.ODLetColor(0)
		newdoc.ODLetUse = doc.ODLetUse(0)		
		newdoc.ODShape = doc.Shape(0)
		
		newdoc.ODSymbol = doc.ODSymbol(0)
		newdoc.ODSymbol_1 = doc.ODSymbol_1(0)		
		newdoc.ODArrowDir = doc.ODArrowDir(0)        										'with brackets
		
		newdoc.ODSymbolImage = "C:\msimages\PG_" &amp; doc.ODSymbol(0) &amp; ".gif"
		newdoc.ODSymbolImage_1 = "C:\msimages\PG_" &amp; doc.ODSymbol_1(0) &amp; ".gif"
		newdoc.ODArrowImage = "C:\msimages\PG_" &amp; doc.ODArrowDir_1(0) &amp; ".gif"      'no brackets
		
		newdoc.ADACompliant_1 = doc.ADACompliant_1(0)	
		newdoc.ODFormat = doc.ODFormat(0)
		If Right(doc.ODMod(0), 2) = "/A" Then
			newdoc.ODMod = doc.ODMod(0)
		Else
			newdoc.ODMod = doc.ODMod(0) &amp; "/" &amp; insertletter
		End If
		
		Call newdoc.MakeResponse(hdrdoc)				
		Call newdoc.Save( True, True)		
		Call view.Refresh
		
		doc.Action = "Save"
		doc.ODLetMsg = ""
		doc.ODRAText = ""		
		doc.ODSymbol = ""
		doc.ODSymbol_1 = ""		
		doc.ADACompliant_1 = "No"		
		doc.ODArrowDir = ""
		doc.ODArrowDir_1 = ""
		doc.ODLocation = ""		
		doc.SpIns = ""	
		doc.ODSpIns = ""			
		doc.InsQty = 1		
		doc.InstReq = "No"		
		doc.hPrice = ""		
		doc.hItemType = ""		
		Call doc.save(False, False)
		Call view.Refresh			
		unid = doc.UniversalID		
		Print "[/Innerface/Order+Entry.nsf/0/" &amp; unid &amp; "?EditDocument]"
		
	Case "Lettered Top Insert" 
		If Right(doc.ODMod(0), 2) = "/A" Then
			ipskey = doc.ODMod(0) &amp; lTopinserttext	
		Else
			ipskey = doc.ODMod(0) &amp; "/A" &amp; lTopinserttext
		End If
		
		Set ipsdoc = ipsview.GetDocumentbyKey( ipskey, True )
		If Not ipsdoc Is Nothing Then
			newdoc.FixedPrice = ipsdoc.ColumnValues( column )
			newdoc.ExtPrice = ipsdoc.ColumnValues( column ) * doc.InsQty(0)		
		Else
			newdoc.FixedPrice = 0
			newdoc.ExtPrice = 0
		End If
		newdoc.ODDesc = lInsertText
		
		newdoc.ODQty = doc.InsQty(0)		
		
		insertletter = "A"
		
		newdoc.ODInsType = "Lettered Insert"		
		newdoc.ODLetMsg = doc.ODLetMsg(0)
		newdoc.ODRAText = doc.RAText(0)		
		newdoc.ODColor_1 = doc.Color(0)		
		newdoc.ODLetStyle = doc.ODLetStyle(0)
		newdoc.ODLetColor = doc.ODLetColor(0)
		newdoc.ODLetUse = doc.ODLetUse(0)		
		newdoc.ODShape = doc.Shape(0)
		newdoc.ODSymbol = doc.ODSymbol(0)
		newdoc.ODSymbol_1 = doc.ODSymbol_1(0)		
		newdoc.ODArrowDir = doc.ODArrowDir(0)
		newdoc.ADACompliant_1 = doc.ADACompliant_1(0)
		
		newdoc.ODSymbolImage = "C:\msimages\PG_" &amp; doc.ODSymbol(0) &amp; ".gif"
		newdoc.ODSymbolImage_1 = "C:\msimages\PG_" &amp; doc.ODSymbol_1(0) &amp; ".gif"
		newdoc.ODArrowImage = "C:\msimages\PG_" &amp; doc.ODArrowDir_1(0) &amp; ".gif"		
		
		newdoc.ODFormat = doc.ODFormat(0)
		If Right(doc.ODMod(0), 2) = "/A" Then
			newdoc.ODMod = doc.ODMod(0)
		Else
			newdoc.ODMod = doc.ODMod(0) &amp; "/" &amp; insertletter
		End If
		
		Call newdoc.MakeResponse(hdrdoc)				
		Call newdoc.Save( True, True)		
		Call view.Refresh
		
		doc.Action = "Save"
		doc.ODLetMsg = ""
		doc.RAText = ""		
		doc.ODSymbol = ""
		doc.ODSymbol_1 = ""		
		doc.ADACompliant_1 = "No"		
		doc.ODArrowDir = ""
		doc.ODArrowDir_1 = ""		
		doc.ODLocation = ""		
		doc.SpIns = ""	
		doc.ODSpIns = ""			
		doc.InsQty = 1		
