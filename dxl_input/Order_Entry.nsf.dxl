 familyid='20'/><field type='text' kind='computed' name='CustName'><code event='defaultvalue'><formula
>custdb := "Innerface\\MasterDB.nsf";
temp := @UserName;
@If( temp = "Anonymous" ; "" ; @DbLookup( "" : "NoCache"; "" : custdb; "Customers\\by Number" ; CustNum  ; 2 ))</formula></code><code
 event='terminate'><lotusscript>Sub Terminate
	
