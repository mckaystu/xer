<lastaccessed><datetime>20101103T010559,37-05</datetime></lastaccessed>
<addedtofile><datetime>20031104T110208,30-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby>
<designchange><datetime>20101102T104211,07-05</datetime></designchange>
<trigger type='agentlist'/>
<documentset type='runonce'/><code event='options'><lotusscript>Option Public

</lotusscript></code><code event='initialize'><lotusscript>Sub Initialize
	
'declare everything
	Dim s As New NotesSession
	Dim db As NotesDatabase
	Dim doc As notesDocument, lastdoc As Notesdocument
	Dim unid As String
	Dim view As Notesview
	Dim num As String
	Dim desc As String
	Dim custname As String
	Dim key As String
	Dim tracknum As String
	Dim checkit As Variant
	Dim ccnumlen As Integer
	Dim ccnum As String
	
'declare error handling for entire script
	On Error Goto Errorhandler
	
'set up things
	Set db = s.CurrentDatabase
	Set doc = s.DocumentContext
	doc.Form = "OEHeader"
	
	key = doc.OHBill_CustNo(0)
	Set view = db.GetView( "(WebOrdersbyCustNum)" )
	Set lastdoc = view.GetDocumentbykey( key, True )
	
	If Not lastdoc Is Nothing Then
		doc.WebName = lastdoc.WebName(0)
		doc.WebEmail = lastdoc.WebEmail(0)
		doc.WebArea = lastdoc.WebArea(0)
		doc.WebExchange = lastdoc.WebExchange(0)
		doc.WebPhone = lastdoc.WebPhone(0)
		doc.OHBill_Phone = lastdoc.OHBill_Phone(0)
		doc.OHCCType = lastdoc.OHCCType(0)
		doc.OHCCNum = lastdoc.OHCCNum(0)		
		doc.OHCCVNum = lastdoc.OHCCVNum(0)	
		ccnumlen = Len(lastdoc.OHCCNum(0))
%REM		
		If Not ccnumlen = 0 Then		
			If ccnumlen = 15 Then
				doc.OHCCNum = "**********" + Right(lastdoc.OHCCNum(0), 5)
			Else
				doc.OHCCNum = "***********" + Right(lastdoc.OHCCNum(0), 5)
			End If
		End If
%ENDREM	
		doc.OHCCExpMo = lastdoc.OHCCExpMo(0)
		doc.OHCCExpYr = lastdoc.OHCCExpYr(0)
	End If
	
	
	Exit Sub 'Exit the sub before the errorhandler
	
ErrorHandler:
	Print("LoadHdrItemsWeb - Error Number " + Cstr(Err) + " : " + Error$ + " on line number " + Cstr(Erl)) 
	Resume Next 'Continue where the agent encountered the last error
	
End Sub</lotusscript></code>
