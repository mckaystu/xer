<agent name='(CreateConfDetail)' hide='v3' publicaccess='true' designerversion='5'>
<noteinfo noteid='2ba' unid='3939278E4ACCC36F85256A8F00684F0D' sequence='26'>
<created><datetime dst='true'>20010720T145919,81-04</datetime></created>
<modified><datetime>20061215T010445,08-05</datetime></modified>
<revised><datetime>20061214T132451,13-05</datetime></revised>
<lastaccessed><datetime>20061215T010445,07-05</datetime></lastaccessed>
<addedtofile><datetime>20030211T095856,09-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby>
<designchange><datetime>20061214T132451,12-05</datetime></designchange>
<trigger type='agentlist'/>
<documentset type='runonce'/><code event='options'><lotusscript>Option Public

</lotusscript></code><code event='initialize'><lotusscript>Sub Initialize
	Dim s As New NotesSession
	Dim db As NotesDatabase
	Dim dc As NotesDocumentCollection	
	Dim doc As NotesDocument, newdoc As NotesDocument
	Dim view As NotesView, confview As NotesView
	Dim unid As String, hdrunid As String
	Dim nextnum As Integer
	Dim module As String
	Dim order As String	
	Dim jbanum As String
	Dim rndnum As String
	'Dim ordkey(1 To 2) As String
	Dim ordkey As String
	Dim numlen As Integer
	Dim posit As Integer
	Dim posit1 As Integer
	
 'Declare error handling for entire script
	On Error Goto Errorhandler
	
'some basic setup	
	Set db = s.CurrentDatabase	
	Set doc = s.DocumentContext
	'ordkey(1) = doc.OHOrdNo(0)
	'ordkey(2) = doc.ODItem(0)	
	ordkey = doc.hRndOrd(0) &amp; doc.hTrackNumber(0) &amp; doc.ODItem(0)
	
'this view is a list of the OEDtl response documents that have been created for this order	
	Set view = db.GetView( "(DetailsforReorder)" )
	Set newdoc = view.Getdocumentbykey( ordkey )
	Set confview = db.GetView( "(evOrderConf)" )
	
'establish some working variables for use later on	
	order = doc.OHOrdNo(0)	
	numlen = Len( doc.JBANo(0) )
	posit = numlen - 3
	posit1 = numlen - 1
	
'update the item record; we use a case structure to determine what was modified and to process
	'those modifications
	
	Select Case doc.Action(0)
		
	Case "Lettered Insert" 
		newdoc.ODInsType = "Lettered Insert"		
		newdoc.ODLetMsg = doc.ODLetMsg(0)
		newdoc.ODColor_1 = doc.ODColor_1(0)		
		newdoc.ADACompliant_1 = doc.ADACompliant_1(0)				
		newdoc.ADAMsg_1 = doc.ADAMsg_1(0)		
		newdoc.ODLetStyle = doc.ODLetStyle(0)
		newdoc.ODLetColor = doc.ODLetColor(0)
		newdoc.ODLetUse = doc.ODLetUse(0)		
		newdoc.ODSymbol = doc.ODSymbol(0)
		newdoc.ODArrowDir = doc.ODArrowDir(0)
		newdoc.ODFormat = doc.ODFormat(0)	
		newdoc.ODQty = doc.ODQty(0)
		newdoc.EditorsDetail = "Web User"
		newdoc.EditDatesDetail = Now
		newdoc.EditSequenceDetail = "1"
		jbanum = doc.JBANo(0)
		If(doc.ADACompliant(0) = "No") Then		
			Mid$(jbanum, 1, 2) = "04"
		Else
			Mid$(jbanum, 1, 2) = "86"
		End If
		Mid$( jbanum, posit, 2 ) = doc.Color_2(0)
		newdoc.JBANo = jbanum
		
		Call newdoc.Save( True, True )		
		Call view.Refresh
		Call confview.refresh
		
	Case "Header Insert" 
		newdoc.ODLetMsg = doc.ODLetMsg(0)
		newdoc.ODColor_1 = doc.ODColor_1(0)	
		newdoc.ODLetStyle = doc.ODLetStyle(0)
		newdoc.ODLetColor = doc.ODLetColor(0)
		newdoc.ODLetUse = doc.ODLetUse(0)		
		newdoc.ODSymbol = doc.ODSymbol(0)
		newdoc.ODArrowDir = doc.ODArrowDir(0)
		newdoc.ODFormat = doc.ODFormat(0)
		newdoc.ODQty = doc.ODQty(0)		
		newdoc.ADACompliant_1 = doc.ADACompliant_1(0)
		newdoc.ADAMsg_1 = doc.ADAMsg_1(0)		
		newdoc.EditorsDetail = "Web User"
		newdoc.EditDatesDetail = Now
		newdoc.EditSequenceDetail = "1"
		jbanum = doc.JBANo(0)
		If(doc.ADACompliant(0) = "No") Then		
			Mid$(jbanum, 1, 2) = "04"
		Else
			Mid$(jbanum, 1, 2) = "86"
		End If
		Mid$( jbanum, posit, 2 ) = doc.Color_2(0)
		newdoc.JBANo = jbanum
		
		Call newdoc.Save( True, True)		
		Call view.Refresh
		Call confview.refresh
		
	Case "Base Insert" 
		newdoc.ODLetMsg = doc.ODLetMsg(0)
		newdoc.ODColor_1 = doc.ODColor_1(0)
		newdoc.ODLetStyle = doc.ODLetStyle(0)
		newdoc.ODLetColor = doc.ODLetColor(0)
		newdoc.ODLetUse = doc.ODLetUse(0)		
		newdoc.ODShape = doc.Shape(0)
		newdoc.ODSymbol = doc.ODSymbol(0)
		newdoc.ODArrowDir = doc.ODArrowDir(0)
		newdoc.ODFormat = doc.ODFormat(0)
		newdoc.ODQty = doc.ODQty(0)		
		newdoc.ADACompliant_1 = doc.ADACompliant_1(0)		
		newdoc.ADAMsg_1 = doc.ADAMsg_1(0)				
		newdoc.EditorsDetail = "Web User"
		newdoc.EditDatesDetail = Now
		newdoc.EditSequenceDetail = "1"
		jbanum = doc.JBANo(0)
		If(doc.ADACompliant(0) = "No") Then		
			Mid$(jbanum, 1, 2) = "04"
		Else
			Mid$(jbanum, 1, 2) = "86"
		End If
		Mid$( jbanum, posit, 2 ) = doc.Color_2(0)
		newdoc.JBANo = jbanum
		
		Call newdoc.Save( True, True)		
		Call view.Refresh
		Call confview.refresh
		
	Case "Blank Base"
		newdoc.ODQty = doc.BlankQty
		newdoc.ODColor_2 = doc.Color(0)
		jbanum = doc.JBANo(0)		
		Mid$( jbanum, posit, 2 ) = doc.Color(0)
		newdoc.JBANo = jbanum
		
		Call newdoc.Save( True, True )		
		Call view.Refresh
		Call confview.refresh
		
	Case "Blank Insert"
		newdoc.ODQty = doc.BlankQty
		newdoc.ODColor_2 = doc.Color(0)
		jbanum = doc.JBANo(0)		
		Mid$( jbanum, posit, 2 ) = doc.Color(0)
		newdoc.JBANo = jbanum
		
		Call newdoc.Save( True, True )		
		Call view.Refresh
		Call confview.refresh
		
	Case "Blank Header"
		newdoc.ODQty = doc.BlankQty
		newdoc.ODColor_2 = doc.Color(0)
		jbanum = doc.JBANo(0)		
		Mid$( jbanum, posit, 2 ) = doc.Color(0)
		newdoc.JBANo = jbanum
		
		Call newdoc.Save( True, True )		
		Call view.Refresh
		Call confview.refresh
		
	Case "Frame"
		newdoc.ODFrMount = doc.ODFrMount(0)		
		newdoc.ODFrMountMtl = doc.ODFrMountMtl(0)		
		newdoc.ODQty = doc.FrameQty(0)
		newdoc.ADAMsg = doc.ADAMsg(0)		
		newdoc.ODColor = doc.Color_1(0)
		newdoc.ADACompliant = doc.ADACompliant(0)		
		newdoc.ODFrShape = doc.Shape(0)		
		jbanum = doc.JBANo(0)		
		If(doc.ADACompliant(0) = "No") Then		
			Mid$(jbanum, 1, 2) = "01"
		Else
			Mid$(jbanum, 1, 2) = "84"
		End If
		Mid$( jbanum, posit, 2 ) = doc.Color_1(0)
		Mid$( jbanum, posit1, 2) = doc.Shape(0)
		newdoc.JBANo = jbanum
		
		Call newdoc.Save( True, True )		
		Call view.Refresh
		Call confview.refresh
		
	End Select
	
	Exit Sub 'Exit the sub before the errorhandler
	
ErrorHandler:
	Print("Error Number " + Cstr(Err) + " : " + Error$ + " on line number " + Cstr(Erl)) 
	Resume Next 'Continue where the agent encountered the last error
	
End Sub</lotusscript></code>
