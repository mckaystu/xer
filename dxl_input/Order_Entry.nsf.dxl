 truetype='true' familyid='20'/><field lookupeachchar='false' lookupaddressonrefresh='false'
 type='keyword' kind='editable' name='ODColor'><keywords recalconchange='true'
 columns='1' ui='dialoglist'><formula>tmp := @DbLookup( "" : ""; hDbserver : "Innerface\\Product Information.nsf" ; "(Product Information Lookup)" ; "Color"  ; "PR_DispValue" );

@If(@IsError(tmp) ; "Look Up Error" ; tmp + " | " + @Left(tmp ; " "))</formula></keywords></field></run><run
><font size='8pt' name='Verdana' pitch='variable' truetype='true' familyid='20'/></run></par></tablecell></tablerow>
