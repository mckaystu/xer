<tablecell borderwidth='0px' bgcolor='white'>
<pardef id='39' align='right' keepwithnext='true' keeptogether='true'/>
<par def='39'><run><font size='7pt' style='bold' name='Verdana' pitch='variable'
 truetype='true' familyid='20' color='red'/></run><button width='2in' widthtype='fitcontent'
 wraptext='true' edge='rounded' bgcolor='#82c0ff' type='ok' htmlstyle='font-family:"Verdana"; font-size:7pt; color="darkslateblue"'><code
 event='onClick' for='web'><javascript>var f = document.forms[0] ;
f.Action.value = "Frame" ;

if( f.ODMod.value == "" ) {
  alert( "You must select a module type before adding a frame.")
  f.ODMod.focus()
   return false
}
if( f.Color.value == "") {
   alert("You must select a color for this module type before adding a frame.")
   f.Color.focus()
   return false
}
if( f.Shape.value == "") {
   alert("You must select a shape for this module type before adding a frame.")
   f.Shape.focus()
   return false
}

x = f.ADACompliant.length - 1;

while(x &gt; 0) {
/*Check if anything besides the first choice is selected*/
	if (f.ADACompliant[x].selected) {
	break;
	}
x-=1;
}

if( x == 0) {
   alert("You must indicate whether this frame should be ADA Compliant.")
   f.ADACompliant.focus()
   return false
}  
if( x == 1  &amp;&amp; f.ADAMsg.value == "") {
	alert("If ADA Compliant, please enter a message.")
	f.ADACompliant.focus()
	return false
}

if( f.ODMod.value == "17.25" | f.ODMod.value == "17.25/B" |
	f.ODMod.value == "17.50L" | f.ODMod.value == "17.50L/B" | f.ODMod.value == "17.50W" | f.ODMod.value == "17.50W/B" |
	f.ODMod.value == "17.100" | f.ODMod.value == "17.100/B" |f.ODMod.value == "17.150" | f.ODMod.value == "17.150/B" |
	f.ODMod.value == "17.200" | f.ODMod.value == "17.200/B" | f.ODMod.value == "17.250" | f.ODMod.value == "17.250/B" |
	f.ODMod.value == "17.300" | f.ODMod.value == "17.300/B") {
	if( f.Shape.value == "00" | f.Shape.value == "01") {
		f.Action.value = "Main Directory Frame - Radius";
	}
	else {
		f.Action.value = "Main Directory Frame - Square";
	}
}

f.submit()</javascript></code><font size='7pt' name='Verdana' pitch='variable'
 truetype='true' familyid='20'/>Add a Frame to the Quote</button><run><font
 size='7pt' style='bold' name='Verdana' pitch='variable' truetype='true' familyid='20'
 color='red'/></run></par></tablecell></tablerow></table>
