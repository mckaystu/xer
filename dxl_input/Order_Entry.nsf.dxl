 htmlallfields='true' publicaccess='false' designerversion='7'>
<noteinfo noteid='926' unid='4297BE3EF538B6D0852569640048ABFD' sequence='50'>
<created><datetime dst='true'>20000924T091346,21-04</datetime></created>
<modified><datetime dst='true'>20070419T060914,74-04</datetime></modified>
<revised><datetime dst='true'>20070419T060914,73-04</datetime></revised>
<lastaccessed><datetime dst='true'>20070419T060914,73-04</datetime></lastaccessed>
<addedtofile><datetime>20030211T095920,11-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby><code event='windowtitle'><formula
>"Innerface Web Order for " + @NameLookup( [NoSearching] ; @UserName ; "EmployeeID")</formula></code><code
 event='webquerysave'><formula>@Command([ToolsRunMacro]; "(CreateNewWebOrder)")</formula></code><code
 event='onSubmit' for='web'><javascript>var f = document.forms[0];

if( f.WebName.value == "" ) {
	alert("Please enter your first and last names to assist us in contacting you regarding this order.")
   	f.WebName.focus()
   	return false
}

if( f.WebEmail.value == "" ) {
	alert("Please enter your email address to assist us in contacting you regarding this order.")
   	f.WebEmail.focus()
   	return false
}

if( f.WebPhone.value == "" || f.WebArea.value == "" || f.WebExchange.value == "") {
	alert("Your phone number does not appear to be entered correctly. Please re-enter your phone number to assist us in contacting you regarding this order.")
   	f.WebArea.focus()
   	return false
}

</javascript></code><code event='onLoad' for='web'><javascript>document.forms[0].WebName.focus()</javascript></code>
