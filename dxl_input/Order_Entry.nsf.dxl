<form name='NewInsertSpecs' nocompose='true' noquery='true' htmlallfields='true'
 publicaccess='true' designerversion='6.5' comment='Modify insert specs for new order'>
<noteinfo noteid='962' unid='7448BB468C1FCBEF8525693E004F226E' sequence='149'>
<created><datetime dst='true'>20000817T102421,58-04</datetime></created>
<modified><datetime>20061215T010441,66-05</datetime></modified>
<revised><datetime>20061214T132519,26-05</datetime></revised>
<lastaccessed><datetime>20061215T010441,66-05</datetime></lastaccessed>
<addedtofile><datetime>20030211T095920,84-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby><code event='webquerysave'><formula
>@Command([ToolsRunMacro]; "(CreateConfDetail)")</formula></code><code event='onUnload'
 for='web'><javascript>window.opener.document.forms[0].RefreshFlag.value = "1";
window.close()</javascript></code><code event='jsheader' for='web'><javascript
>
function CheckLettered() {
var f = document.forms[0]
if( f.ODLetMsg.value == "" ) {
  alert( "You must enter the message text for a strip insert.")
  f.ODLetMsg.focus()
  return false
}   
if( f.ODLetStyle.value == "") {
   alert("You must select a type style for this strip insert.")
   f.ODLetStyle.focus()
   return false
   }
if( f.ODFormat.value == "") {
   alert("You must select a lettering format for this strip insert.")
   f.ODFormat.focus()
   return false
   }
if( f.ODLetColor.value == "") {
   alert("You must select a font color for this strip insert.")
   f.ODLetColor.focus()
   return false
   }
if( f.ODQty == "") {
   alert("You must enter a quantity for this strip insert or zero to delete this line item.")
   f.ODQty.focus()
   return false ;
   }
x = f.ADACompliant_1.length - 1;
while(x &gt; 0) {
/*Check if anything besides the first choice is selected*/
if (f.ADACompliant_1[x].selected) {
break;
}
x-=1;
}

if( x == 0) {
   alert("You must indicate whether this insert should be ADA Compliant.")
   f.ADACompliant_1.focus()
   return false ;
}  
if( x == 1  &amp;&amp; f.ADAMsg_1.value == "") {
	alert("If ADA Compliant, please enter a message.")
	f.ADAMsg_1.focus()
	return false ;
	}
}

function CheckBlank() {
var f = document.forms[0]

if( f.Color.value == "") {
   alert("You must select a color for this blank strip.")
   f.Color.focus()
   return false ;
   }
if( f.BlankQty == "") {
   alert("You must enter a quantity for this blank strip or zero to delete this line item.")
   f.BlankQty.focus()
   return false ;
   }
}

function CheckFrame() {
var f = document.forms[0]

if( f.FrameQty == "") {
   alert("You must enter a quantity for this frame or zero to delete this line item.")
   f.FrameQty.focus()
   return false ;
   }
if( f.Color_1.value == "") {
   alert("You must select a color for this frame.")
   f.Color_1.focus()
   return false ;
   }
if( f.Shape.value == "") {
   alert("You must select a shape for this frame.")
   f.Shape.focus()
   return false ;
   }
fr = f.ADACompliant.length - 1;
while(fr &gt; 0) {
/*Check if anything besides the first choice is selected*/
if (f.ADACompliant[fr].selected) {
break;
}
fr-=1;
}

if( fr == 0) {
   alert("You must indicate whether this frame should be ADA Compliant.")
   f.ADACompliant.focus()
   return false ;
}  
if( fr == 1  &amp;&amp; f.ADAMsg.value == "") {
	alert("If ADA Compliant, please enter a message.")
	f.ADAMsg.focus()
	return false ;
	}

}

</javascript></code>
