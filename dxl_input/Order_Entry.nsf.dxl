<body><richtext>
<pardef id='1' leftmargin='1in' hide='read edit print copy preview previewedit'/>
<par def='1'><run><font size='7pt' name='Arial' pitch='variable' truetype='true'
 familyid='20' color='gray'/>Hidden: </run><run><font size='7pt' color='gray'
 name='Arial' pitch='variable' truetype='true' familyid='20'/><field type='text'
 kind='computed' name='CustNum'><code event='defaultvalue'><formula>temp := @UserName;
@If( temp = "Anonymous" ; "" ; @NameLookup( [TrustedOnly] ; temp ; "EmployeeID"))</formula></code></field></run><run
><font size='7pt' name='Arial' pitch='variable' truetype='true' familyid='20'
 color='gray'/> </run><run><font size='7pt' color='gray' name='Arial' pitch='variable'
 truetype='true' familyid='20'/><field type='text' kind='computed' name='CustName'><code
 event='defaultvalue'><formula>custdb := "Innerface\\MasterDB.nsf";
temp := @UserName;
@If( temp = "Anonymous" ; "" ; @DbLookup( "" : "NoCache"; "" : custdb; "Customers\\by Number" ; CustNum  ; 2 ))</formula></code><code
 event='terminate'><lotusscript>Sub Terminate
	
End Sub</lotusscript></code></field></run><run><font size='7pt' name='Arial'
 pitch='variable' truetype='true' familyid='20' color='gray'/> </run></par>
<table widthtype='fixedleft' refwidth='6.1868in'><tablecolumn width='2.5000in'/><tablecolumn
 width='3.6868in'/>
<tablerow>
<tablecell borderwidth='0px'>
<pardef id='3' leftmargin='0.0104in' keepwithnext='true' keeptogether='true'/>
<par def='3'><run><font size='8pt'/><field type='text' kind='computedfordisplay'
 name='CustLogo'><code event='defaultvalue'><formula>db := "Innerface\\NRFCFILE.nsf";
temp := @DbLookup( "" ; "" : db ; "(Lookup)" ; CustNum  ; 2 ) ;
htmlPre := @If(@IsError(temp) ; @DbLookup( "" ; "" : db ; "(Lookup)" ; "Innerface"  ; 2 ) ; temp);
finalhtml := @ReplaceSubstring(htmlPre ; " " ; "+");
"[&lt;img src = \"" + finalhtml + "\"&gt;]"</formula></code></field></run><run
><font size='9pt' style='bold' name='Arial' pitch='variable' truetype='true'
 familyid='20'/></run></par></tablecell>
<tablecell borderwidth='0px'>
<pardef id='4' leftmargin='0.0104in' hide='notes' keepwithnext='true' keeptogether='true'/>
