		f.ODMod.value == "4.88" | f.ODMod.value == "4.88/B" |  f.ODMod.value == "4.99" |f.ODMod.value == "5.5PW" | f.ODMod.value == "6.11" | f.ODMod.value == "6.11/B" |
 		f.ODMod.value == "6.22" | f.ODMod.value == "6.22/B" | f.ODMod.value == "6.33" | f.ODMod.value == "6.33/B" | 
		f.ODMod.value == "6.44" | f.ODMod.value == "6.44/B" | f.ODMod.value == "17.25" | f.ODMod.value == "17.25/B" |
		f.ODMod.value == "17.50L" | f.ODMod.value == "17.50L/B" | f.ODMod.value == "17.50W" | f.ODMod.value == "17.50W/B" |
		f.ODMod.value == "17.100" | f.ODMod.value == "17.100/B" |f.ODMod.value == "17.150" | f.ODMod.value == "17.150/B" |
