<scriptlibrary name='OnlineLibrary' hide='v3 v4strict'>
<noteinfo noteid='bf6' unid='A7109FFBB6A3D37185256CD2006C517D' sequence='8'>
<created><datetime>20030219T144307,49-05</datetime></created>
<modified><datetime>20061215T010442,00-05</datetime></modified>
<revised><datetime>20061214T132522,90-05</datetime></revised>
<lastaccessed><datetime>20061215T010442,00-05</datetime></lastaccessed>
<addedtofile><datetime>20030219T160543,81-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby><code event='options'><lotusscript
>Option Public

</lotusscript></code><code event='ItemSetup'><lotusscript>Sub ItemSetup(module As String, rightlen As Integer)
	
'some modules use an "A" strip but the letter "A" is not inserted into the part number if there is no "B" strip
	'and there is no "C" strip.
	Dim moduledb As New NotesDatabase( "", "Innerface\Product Information.nsf")	
	Dim modview As NotesView
	Dim moddoc As NotesDocument
	
'declare error handling for entire script
	On Error Goto Errorhandler
	
	Set modview = moduledb.GetView( "ModInsLookup" )
	Set moddoc = modview.GetDocumentbyKey( module )
	noletter = False	
	If Not moddoc Is Nothing Then
		If moddoc.CR_HdrInsNo(0) &gt; 0 And moddoc.CR_StripInsNo(0) = 0 And moddoc.CR_BaseInsNo(0) = 0 Then
			noletter = True
		End If
	End If
	
	If ( rightlen = 2 Or rightlen = 3 ) Then
		If Not noletter &amp; doc.dtIType(0) &lt;&gt; "N" Then		
			insertletter = doc.dtIType(0)
		Else
			insertletter = "0"
		End If
	Else
		If Not noletter &amp; doc.dtIType(0) &lt;&gt; "N" Then				
			insertletter = "0" &amp; doc.dtIType(0)
		Else
			insertletter = "00"
		End If
	End If
	
	If doc.spInsColor(0) &lt;&gt; "00 Other (Specify)" Then	
		insertcolor = doc.spInsColor(0)
	Else
		'insertcolor = "99"
		insertcolor = "00"
	End If		
	
'if a module has an A strip, B strips, and a C strip then the shape code for the B strips is always "00"	
'if there is an A strip or a C strip shapes are always "00" or "01" 	
	If doc.dtIType(0) = "B" Then	
		If moddoc.CR_HdrInsNo(0) &gt; 0 And moddoc.CR_StripInsNo(0) &gt; 0 And moddoc.CR_BaseInsNo(0) &gt; 0 Then
			shape = "00"
		Else
			shape = doc.spShape(0)	
		End If
	Else
		If doc.spShape(0) = "01" Or doc.spShape(0) = "00"  Then
			shape = "00"
		Else
			shape = "10"
		End If
	End If
	
	If detdoc.dtIBlank(0) = "No" Then
		partnum = "04" &amp; module &amp; insertletter &amp; insertcolor &amp; shape
		dummypart = "04" &amp; module &amp; insertletter
	Else
		partnum = "05" &amp; module &amp; insertletter &amp; insertcolor &amp; shape
		dummypart = "05" &amp; module &amp; insertletter
	End If
	
	
	Exit Sub 'Exit the sub before the errorhandler
	
ErrorHandler:
	Print("Error Number " + Cstr(Err) + " : " + Error$ + " on line number " + Cstr(Erl)) 
	Resume Next 'Continue where the agent encountered the last error
	
End Sub</lotusscript></code>
<item name='$POID'><datetime>20061214T132522,90-05</datetime></item></scriptlibrary>

