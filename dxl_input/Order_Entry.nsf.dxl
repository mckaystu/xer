<scriptlibrary name='IPPlus' hide='v3 v4strict'>
<noteinfo noteid='d0e' unid='12C84E2EC7DD31CE85256CD30055DE18' sequence='17'>
<created><datetime>20030220T103754,16-05</datetime></created>
<modified><datetime>20101103T010557,58-05</datetime></modified>
<revised><datetime>20101102T104210,35-05</datetime></revised>
<lastaccessed><datetime>20101103T010557,58-05</datetime></lastaccessed>
<addedtofile><datetime>20030220T114111,77-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name><name
>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby><code event='options'><lotusscript
>Option Public

</lotusscript></code><code event='declarations'><lotusscript>Declare Function IPSInitialize Lib "NIPrint.dll" (Byval szCurSer As String, Byval szCurDB As String, Byval szCurView As String) As Long

Declare Function IPSOpenFormat Lib "NIPrint.dll" (Byval lHandle As Long, Byval szFormat As String, Byval iFormatStore As Integer, Byval szServer As String, Byval _ 
szOtherDB As String) As Long

Declare Function IPSEdit Lib "NIPrint.dll" (Byval lHandle As Long, Byval szID As String) As Long

Declare Function IPSPreview Lib "NIPrint.dll" (Byval lHandle As Long, Byval szID As String, Byval iPrintSetUp As Integer) As Long

Declare Function IPSPrint Lib "NIPrint.dll" (Byval lHandle As Long, Byval szID As String, Byval iPrintSetUp As Integer) As Long

Declare Function IPSPrintSetUp Lib "NIPrint.dll" (Byval lHandle As Long, Byval iCopies As Integer, Byval szPrinter As String, Byval iSelection As Long) As Long

Declare Function IPSCloseFormat Lib "NIPrint.dll" (Byval lHandle As Long) As Long

Declare Function IPSTerminate Lib "NIPrint.dll" (Byval lHandle As Long) As Long

Declare Function IPSPrintSetUpEx Lib "NIPrint.dll" (Byval lHandle As Long, Byval iCopies As Integer, Byval szPrinter As String, Byval szDefaultTray As String, Byval iSelection As Long) As Long

Declare Function IPSExport Lib "NIPrint.dll" (Byval lHandle As Long, Byval szID As String, Byval szFilePath As String,Byval ExportType As Integer) As Long

Declare Function IPSGetMessage Lib "NIPrint.dll" (Byval iMessageNo As Long, Byval pszMessage As String) As Long

Declare Function IPSBrowse Lib "NIPrint.dll" (Byval lHandle As Long, Byval szID As String, Byval szName As String) As Long

Declare Function CreateTable Lib "NCLNRTF.DLL" (Byval nrows As Integer,Byval ncols As Integer, Byval margins As String) As Long

Declare Function EnableBorders Lib "NCLNRTF.DLL" (Byval dwHandle As Long,Byval bBorders As Integer) As Long

Declare Function AppendCellText Lib "NCLNRTF.DLL" ( Byval dwHandle As Long, Byval row As Integer,Byval col As Integer,Byval text As String, Byval textsize As Long, Byval fontname As String,Byval isbold As Integer,Byval pointsize As Integer,Byval color As Integer ) As Long

Declare Function AddTableToRichTextField Lib "NCLNRTF.DLL" (Byval dwHandle As Long, Byval servername As String, Byval dbname As String,Byval noteid As String, Byval rtfldname As String) As Long

Declare Function DeleteTable Lib "NCLNRTF.DLL" (Byval dwHandle As Long) As Long
</lotusscript></code><code event='ReportProcessing'><lotusscript>Sub ReportProcessing
	
	Dim s As New Notessession
	Dim ws As New Notesuiworkspace
	Dim db As Notesdatabase
	Dim dc As Notesdocumentcollection	
	Dim view As NotesUIView
	Dim docDlg As Notesdocument
	Dim IHandle As Long
	Dim szFormat As String, szID As String
	Dim iFormatStore As Integer, iPrintSetup As Integer
	Dim iErr As Variant
	Dim rcode, i%
	Dim IPformat As String, IPoperation As String
	
'declare error handling for entire script
	On Error Goto Errorhandler
	
'some basic setup	
	Set db = s.currentdatabase
	Set view = ws.CurrentView	
	
'create a form that won't be saved to display the subform for user selection	
	Set docDlg = db.CreateDocument
	docDlg.SaveOptions = "0"
	docDlg.Form = "IPDlg"
	
'let the user select the report format and the processing option	
	rcode = ws.Dialogbox("IPDlg", True, True, False, False, False, False, "Report Printing", docDlg, False, False)
	
'bail if they made no selection	
	If Not rcode Then End
	IPformat = docDlg.Format(0)
	IPoperation = docDlg.Operation(0)
	
'load docs to be printed or previewed	
	Set seldc = db.UnprocessedDocuments
	If seldc.count &lt;&gt; 0 Then
		Set doc = seldc.GetFirstDocument
		If doc.Form(0) &lt;&gt; "OEHeader" Then
			boxType = MB_YESNO + MB_ICONEXCLAMATION 
			crlf$ = Chr(13) &amp; Chr(10)                                                ' Carriage return/line feed
			Messagebox "The selected document is not a header type document.", boxType, "INVALID DOCUMENT SELECTED"
			Exit Sub
		End If
		
		If IPformat = "Credit Card Validation" Then
			szID$ = szID$ + doc.NoteID			
		Else
			Set dc = doc.Responses
			For i = 1 To dc.Count
				Set doc = dc.GetNthDocument(i)
				szID$ = szID$ + doc.NoteID + ";"
			Next
		End If
		
'initialize IntelliPRINTPLUS and get its handle
		IHandle = IPSInitialize(db.Server, db.Filepath, "")
		
'launch IPP if we got the handle	
		If IHandle &lt;&gt; 0 Then
			szFormat = IPformat
			iFormatStore = 0
			iErr = IPSOpenFormat(IHandle, szFormat, iFormatStore, db.Server, db.Filepath)
			If iErr = 0 Then
				Select Case docDlg.Operation(0)
				Case "Preview"
					Call IPSPreview(IHandle, szID$, 0)
				Case "Print"
					Call IPSPrint(IHandle, szID$, 1)
					
				End Select		
			Else
				Msgbox "iErr is " &amp; iErr
			End If
			
			IPSCloseFormat(IHandle)
			IPSTerminate(IHandle)
			
		End If
	End If
	
	Exit Sub 'Exit the sub before the errorhandler
	
ErrorHandler:
	Print("Error Number " + Cstr(Err) + " : " + Error$ + " on line number " + Cstr(Erl)) 
	Resume Next 'Continue where the agent encountered the last error
	
End Sub</lotusscript></code>
<item name='$POID'><datetime>20101102T104210,35-05</datetime></item></scriptlibrary>

<sharedactions hide='v3 v4strict' designerversion='5' maxid='1'>
<noteinfo noteid='d12' unid='2461D40A41EAAFA885256CD30059DC78' sequence='14'>
<created><datetime>20030220T112131,44-05</datetime></created>
<modified><datetime>20061215T010444,62-05</datetime></modified>
<revised><datetime>20061214T132523,21-05</datetime></revised>
<lastaccessed><datetime>20061215T010444,62-05</datetime></lastaccessed>
<addedtofile><datetime>20030220T114112,11-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby>
<action title='Open Order Report Format' icon='147' showinmenu='false' id='1'
 targetframe='NotesView'><code event='options'><lotusscript>Use "IPPlus"
</lotusscript></code><code event='click'><lotusscript>Sub Click(Source As Button)
	
	Dim s As New Notessession
	Dim ws As New Notesuiworkspace
	Dim db As Notesdatabase
	Dim IHandle As Long
	Dim szFormat As String, szID As String
	Dim iFormatStore As Integer, iPrintSetup As Integer
	
'declare error handling for entire script
	On Error Goto Errorhandler
	
	Set db = s.currentdatabase
	
	IHandle = IPSInitialize(db.Server, db.Filename, "PrintView")
	If IHandle &lt;&gt; 0 Then
		szFormat = "Online Order"
		iFormatStore = 0
		iErr = IPSOpenFormat(IHandle, szFormat, iFormatStore, db.Server, db.Filename)
		If iErr = 0 Then
			iErr = IPSPreview(IHandle, szID, 0)	
		End If
	End If
	
	Exit Sub 'Exit the sub before the errorhandler
	
ErrorHandler:
	Print("Error Number " + Cstr(Err) + " : " + Error$ + " on line number " + Cstr(Erl)) 
	Resume Next 'Continue where the agent encountered the last error
	
End Sub</lotusscript></code></action></sharedactions>

