>var f = document.forms[0]
f.Action.value = "Lettered Insert";

if( f.ODMod.value == "10.0" | f.ODMod.value == "10.1" |  f.ODMod.value == "11.0" | f.ODMod.value == "11.1" | 
	 	f.ODMod.value == "12.0" | f.ODMod.value == "12.1" |  f.ODMod.value == "13.0" | f.ODMod.value == "13.1" |
		f.ODMod.value == "14.0" | f.ODMod.value == "14.1" |  f.ODMod.value == "15.0" | f.ODMod.value == "15.1" | 
	 	f.ODMod.value == "16.0" | f.ODMod.value == "16.1" | f.ODMod.value == "16.25" | 
		f.ODMod.value == "17.100" | f.ODMod.value == "17.150" | f.ODMod.value == "17.200" | f.ODMod.value == "17.25" |
		 f.ODMod.value == "17.50L" |  f.ODMod.value == "17.50W" | f.ODMod.value == "24.0" |
	 	f.ODMod.value == "24.1" | f.ODMod.value == "24.2" | f.ODMod.value == "24.3" | f.ODMod.value == "29.0") { 
			f.Action.value = "Lettered Base"
		}
		else {
			if( f.ODMod.value == "5.2") {
				f.Action.value = "Lettered Right Insert";
			}
			else {
				f.Action.value = "Lettered Bottom Insert";
			}	
		}
	

if( f.ODMod.value == "" ) {
  alert( "You must select a module type before adding a lettered base insert.")
  f.ODMod.focus()
   return false
}   
if( f.Color.value == "") {
   alert("You must select a color for this module type before adding a lettered base insert.")
   f.Color.focus()
   return false
}
if( f.Shape.value == "") {
   alert("You must select a shape for this module type before adding a lettered base insert.")
   f.Shape.focus()
   return false
}
if( f.ODLetMsg.value == "" ) {
  alert( "You must enter the message text for a lettered base insert.")
  f.ODLetMsg.focus()
   return false
}   
if( f.ODLetStyle.value == "") {
   alert("You must select a type style for this strip insert.")
   f.ODLetStyle.focus()
   return false
}
if( f.ODFormat.value == "") {
   alert("You must select a lettering format for this strip insert.")
   f.ODFormat.focus()
   return false
}
if( f.ODLetColor.value == "") {
   alert("You must select a font color for this lettered base insert.")
   f.ODLetColor.focus()
   return false
}

