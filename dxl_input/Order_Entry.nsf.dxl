<agent name='(ConfDeleteItem)' hide='v3' publicaccess='false' designerversion='5'
 comment='Unused - 07/19/2001'>
<noteinfo noteid='752' unid='E080D18B23F96ECE85256A870052F371' sequence='31'>
<created><datetime dst='true'>20010712T110602,73-04</datetime></created>
<modified><datetime>20061215T010444,85-05</datetime></modified>
<revised><datetime>20061214T132507,48-05</datetime></revised>
<lastaccessed><datetime>20061215T010444,84-05</datetime></lastaccessed>
<addedtofile><datetime>20030211T095902,04-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby>
<designchange><datetime>20061214T132507,47-05</datetime></designchange>
<trigger type='agentlist'/>
<documentset type='runonce'/><code event='options'><lotusscript>Option Public

</lotusscript></code><code event='initialize'><lotusscript>Sub Initialize
'This agent will delete any item that the web user has decided not to order.  It is invoked as the
	'WebQuerySave agent from the DeleteSpecs form.
	
'declare everything	
	Dim s As New NotesSession
	Dim db As NotesDatabase
	Dim dc As notesdocumentcollection
	Dim ws As New NotesUIWorkspace
	Dim uidoc As notesuidocument
	Dim doc As NotesDocument, dtldoc As NotesDocument, confdoc As NotesDocument
	Dim dtldocr As NotesDocument	
	Dim View As NotesView, confview As NotesView
	Dim key As String, confkey As String
	Dim confunid As String, removeunid As String
	
'declare error handling for entire script
	On Error Goto Errorhandler
	
'get a handle on the backend document using the unid that was passed and remove it	
	Set db = s.CurrentDatabase	
	Set doc = s.DocumentContext
	
	key = doc.CustNum(0) &amp; doc.OHOrdNo(0) &amp; doc.ItemNum(0)
	Set view = db.GetView( "(ItemsforDelete)" )
	Set dtldoc = view.Getdocumentbykey( key, True )
	
	'removeunid = dtldoc.UniversalID
	'Set dtldocr = db.getDocumentByUNID( removeunid )
	
	Call dtldoc.Remove( True )
	Call view.Refresh
	
	confkey = doc.CustNum(0) &amp; doc.OHOrdNo(0)
	Set confview = db.GetView( "(OrdersforConf)" )
	Set confdoc = confview.GetDocumentByKey( confkey )
	confunid = confdoc.Universalid
	
	Print "[/Innerface/Order+Entry.nsf/0/" &amp; confunid &amp; "?EditDocument]"
	
	Exit Sub 'Exit the sub before the errorhandler
	
ErrorHandler:
	Print("Error Number " + Cstr(Err) + " : " + Error$ + " on line number " + Cstr(Erl)) 
	Resume Next 'Continue where the agent encountered the last error
	
End Sub</lotusscript></code>
<rundata processeddocs='0' exitcode='0'>
<agentmodified><datetime dst='true'>20010719T081710,14-04</datetime></agentmodified></rundata>
<item name='$POID'><datetime>20061214T132507,48-05</datetime></item></agent>

