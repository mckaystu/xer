unid := @Text(@DocumentUniqueID);
DtlItem :=  @Text(ODItem) ;
"[&lt;a href=\"javascript:windowopener('" + UrlPre + "NewInsertSpecs?OpenForm&amp;OrdNo=" + OHOrdNo + "&amp;Item=" + DtlItem + "&amp;JBANo=" + JBANo + "&amp;TrackNumber=" + hTrackNumber + "&amp;Random=" + hRndOrd+  "', '500', '700')\"&gt;Modify/Delete&lt;/a&gt;]"</formula></code></column></view>

