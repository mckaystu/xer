<agent name='(ConfirmOrder)' hide='v3' publicaccess='false' designerversion='6.5'
 restrictions='unrestricted'>
<noteinfo noteid='30e' unid='45BD213BDACD4BB985256A80004FEEB6' sequence='20'>
<created><datetime dst='true'>20010705T103304,54-04</datetime></created>
<modified><datetime>20061215T010444,88-05</datetime></modified>
<revised><datetime>20061214T132452,27-05</datetime></revised>
<lastaccessed><datetime>20061215T010444,87-05</datetime></lastaccessed>
<addedtofile><datetime>20030211T095856,60-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby>
<designchange><datetime>20061214T132452,27-05</datetime></designchange>
<trigger type='agentlist'/>
<documentset type='runonce'/><code event='options'><lotusscript>Option Public

</lotusscript></code><code event='initialize'><lotusscript>Sub Initialize
	
	'declare everything
	Dim s As New NotesSession
	Dim db As NotesDatabase
	Dim dc As NotesDocumentCollection
	Dim doc As notesDocument, olddoc As NotesDocument, newdoc As NotesDocument
	Dim detdoc As NotesDocument, newdetdoc As NotesDocument
	Dim details As Variant
	Dim view As notesview
	Dim counter As Integer
	Dim newunid As String
	Dim order As String, tracknum As String, rndnum As String
	Dim status As String
	
	'Declare error handling for entire script
	On Error Goto Errorhandler
	
	'set up things and get the URL string that called the agent to find the target UNID
	Set db = s.CurrentDatabase
	Set doc = s.DocumentContext
	doc.Form = "OEHeader"
	status = "Web - In Process"
	doc.OHOrdStatus = status	
	doc.Editors = "Web User"
	doc.EditDates = Now
	doc.EditSequence = "1"
	Call doc.Save( True, True)	
	
	order = doc.OHOrdNo(0)	
	newunid = doc.UniversalID
	tracknum = doc.hTrackNum(0)
	rndnum = doc.hRndNum(0)
	
	'get the next order number, increment, and put it back	
	Dim admindb As New NotesDatabase( db.server, "Innerface\\Order Entry Administration.nsf")
	Set view = admindb.GetView( "(luOEUsers)" )
	Set numdoc = view.GetDocumentbyKey( "Web User" , True)
	numdoc.UP_NextNumber = numdoc.UP_NextNumber(0) + 1
	Call numdoc.Save( True, True)
	
	If Cint(ordnum) &lt; 10 Then
		zeros = "0000"
	Else
		If Cint(ordnum) &lt; 100 Then
			zeros = "000"
		Else
			If Cint(ordnum) &lt; 1000 Then
				zeros = "00"
			Else
				If Cint(ordnum) &lt; 10000 Then
					zeros = "0"
				Else
					zeros = ""
				End If
			End If
		End If
	End If
	thankyouord = "W" &amp; zeros &amp; Cstr(ordnum)
	
	'create the new details
	details = doc.SelectDetail
	counter = 1
	
	Forall unid In details
		Set detdoc = db.GetDocumentbyUNID( unid )
		Set newdetdoc = detdoc.CopytoDatabase( db )
		newdetdoc.Form = "OEDtl"
		newdetdoc.OHDate = Now
		newdetdoc.OHOrdNo = doc.OHOrdNo(0)
		newdetdoc.OHOrdStatus = status					
		newdetdoc.ODItem = Cstr(counter)		
		Call newdetdoc.MakeResponse( doc )
		Call newdetdoc.Save( True, True)
		counter = counter + 1
	End Forall
	
	'send the user to the next webpage
	If(doc.Changes(0) = "0") Then	
		Set maildoc = New NotesDocument( db )     
		maildoc.Form = "Memo"     
		maildoc.ToField = maildoc.WebEmail(0)		
		maildoc.Head = "Memo from Innerface Sign Systems"		
		maildoc.Subject = "Your Recent Order"     
		maildoc.Body = "This email is to confirm receipt of your recent web order with Innerface Sign Systems." &amp; _
		"Your order number is " &amp; doc.OHOrdNo(0) &amp; ".  You may contact an Innerface customer service" &amp;_
		" representative at 1-800-445-4796 if you have questions or need further information.  Thank You for your order!"
   ' send the new document to the recipient
		Call doc.Send( False, doc.WebEmail( 0 ))
		'Print "[/Innerface/Order+Entry.nsf/ThankYouPage?OpenPage]"
		Print "[/Innerface/Order+Entry.nsf/ThankYouForm?OpenForm&amp;TrackNumber=" + tracknum + "&amp;Random=" + rndnum + "&amp;Order=" + order + "]"		
	Else
		Print "[/Innerface/Order+Entry.nsf/Web+Lettered+Insert+Mod?OpenForm&amp;Order=" &amp; order &amp; "&amp;Unid=" &amp; newunid &amp; "]"	
	End If
	
	Exit Sub 'Exit the sub before the errorhandler
	
ErrorHandler:
	Print("Error Number " + Cstr(Err) + " : " + Error$ + " on line number " + Cstr(Erl)) 
	Resume Next 'Continue where the agent encountered the last error
	
End Sub</lotusscript></code>
<rundata processeddocs='0' exitcode='0'>
<agentmodified><datetime dst='true'>20060622T104029,08-04</datetime></agentmodified></rundata>
<item name='$POID'><datetime>20061214T132452,27-05</datetime></item></agent>

