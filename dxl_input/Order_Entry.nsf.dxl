 kind='editable' name='hODDeliverDate'><datetimeformat show='date' date='yearmonthday'
 fourdigityearfor21stcentury='true' zone='never' dateformat='weekdaymonthdayyear'
 dayformat='twodigitday' monthformat='twodigitmonth' yearformat='fourdigityear'
 weekdayformat='shortname' dateseparator1=' ' dateseparator2='/' dateseparator3='/'
 timeseparator=':' preference='usersetting'/><code event='defaultvalue'><formula
>OHDelDate</formula></code></field></run><run><font size='7pt' name='Verdana'
 pitch='variable' truetype='true' familyid='20' color='gray'/>  </run></par>
<par def='1'><run><font size='7pt' name='Verdana' pitch='variable' truetype='true'
 familyid='20' color='gray'/>company: </run><run><font size='7pt' color='gray'
 name='Verdana' pitch='variable' truetype='true' familyid='20'/><field type='text'
 kind='computed' name='hODCono'><code event='defaultvalue'><formula>"II"</formula></code></field></run><run
><font size='7pt' name='Verdana' pitch='variable' truetype='true' familyid='20'
 color='gray'/>  </run></par>
<par def='1'><run><font size='7pt' name='Verdana' pitch='variable' truetype='true'
 familyid='20' color='gray'/>JBA delivery date: </run><run><font size='7pt'
 color='gray' name='Verdana' pitch='variable' truetype='true' familyid='20'/><field
 type='number' kind='computed' name='hODJBADelDate'><numberformat format='fixed'
 punctuated='false' parens='false' percent='false' bytes='false'/><code event='defaultvalue'><formula
>century := "1";
fullyear := @Text(@Year(hODDeliverDate));
year := @Right(fullyear ; 2);
monthnum := @Month(hODDeliverDate);
month := @If(monthnum &lt; 10 ; "0" + @Text(monthnum) ; @Text(monthnum));
daynum := @Day(hODDeliverDate);
day := @If(daynum &lt; 10 ; "0" + @Text(daynum) ; @Text(daynum));
tmpdate := century + year + month + day;
deliveryDate := @TextToNumber(tmpdate);
deliveryDate</formula></code></field></run><run><font size='7pt' name='Verdana'
 pitch='variable' truetype='true' familyid='20' color='gray'/>  </run></par>
<par def='1'><run><font size='7pt' name='Verdana' pitch='variable' truetype='true'
