<form name='Order Header' alias='OEHeader' hide='web' noquery='true' htmlallfields='true'
 publicaccess='false' designerversion='8.5.3' default='true' conflictaction='mergeconflicts'>
<noteinfo noteid='9b2' unid='B066966AFFFEB0C785256893005DF1FC' sequence='538'>
<created><datetime>20000228T120607,96-05</datetime></created>
<modified><datetime>20231201T012524,84-05</datetime></modified>
<revised><datetime>20231130T085445,70-05</datetime></revised>
<lastaccessed><datetime>20231201T012524,83-05</datetime></lastaccessed>
<addedtofile><datetime>20030211T095922,09-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby><code event='windowtitle'><formula
>@If(@IsNewDoc ; "New Order for " + OHBill_CustNam ; "Order for " + OHBill_CustNam)</formula></code><code
 event='querysave'><lotusscript>Sub Querysave(Source As Notesuidocument, Continue As Variant)
	Dim session As New NotesSession
	Dim workspace As New NotesUIWorkspace
	Dim currentdoc As notesdocument
	Dim admindoc As notesdocument
	Dim currentdb As NotesDatabase	
	Dim admindb As New NotesDatabase("AtlWeb1" , "Innerface\Order Entry Administration.nsf")
	Dim dc As NotesDocumentCollection	
	Dim respdoc As NotesDocument	
	Dim tempnumber As Double
	Dim adminview As notesview
	Dim key As String
	
	Set currentdb = session.CurrentDatabase
	Set adminview = admindb.GetView("(Order Number)")
	Set uidoc = workspace.currentdocument
	Set currentdoc = uidoc.document
	Set dc = currentdoc.Responses
	If dc.Count &gt; 0 Then	
		Call dc.StampAll( "hODStatus" , currentdoc.OHOrdStatus(0) )
		Call dc.StampAll( "OHOrdNo" , currentdoc.OHOrdNo(0) )
	End If
	
'If this is not a new document, we don't want to increment the next number for this user.	
	If uidoc.Isnewdoc Then	
		Call admindoc.save(True, True)
	End If
	
End Sub
</lotusscript></code><code event='querymodechange'><lotusscript>Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
	Dim session As New NotesSession				
	Dim workspace As New NotesUIWorkSpace				
	Dim db As NotesDatabase					
	Dim acl As NotesACL						
	Dim entry As NotesACLEntry	
	Dim docStatus As String
	Dim level As Integer
	
	Set db = session.CurrentDatabase				
	Set acl = db.ACL						
	Set entry = acl.GetEntry(session.CommonUserName)
	If entry Is Nothing Then
		Set entry = acl.GetEntry( session.UserName )
	End If
	level = db.QueryAccess( session.CommonUserName )
	
	If Not ( source.EditMode ) Then	
		docStatus = source.FieldGetText( "OHOrdStatus" )
		If level &gt;= ACLLEVEL_EDITOR And (docStatus &lt;&gt; "To Manufacturing" And docStatus &lt;&gt; "To Shipping" And docStatus &lt;&gt; "Shipped") Then
			Exit Sub
		End If
		If ( Not entry Is Nothing ) Then
			If entry.IsRoleEnabled("[Administrators]") And ( docStatus &lt;&gt; "To Manufacturing" And docStatus &lt;&gt; "To Shipping" And docStatus &lt;&gt; "Shipped" ) Then	
				Exit Sub
			End If		
		End If
		If ( docStatus = "To Manufacturing" Or docStatus = "To Shipping" Or docStatus = "Shipped" ) Then
			Messagebox _
			"Either this order has been released to manufacturing, shipping or it has been shipped.  The document is available for browsing only.", ,"Editing Is Not Allowed!"
			continue = False
		End If
	End If
	
End Sub

</lotusscript></code><code event='queryopen'><lotusscript>Sub Queryopen(Source As Notesuidocument, mode As Integer, Isnewdoc As Variant, Continue As Variant)
	Dim docStatus As Variant
	Dim userType As Variant
	Dim session As New NotesSession				
	Dim workspace As New NotesUIWorkSpace				
	Dim db As NotesDatabase					
	Dim acl As NotesACL						
	Dim entry As NotesACLEntry	
	Dim level As Integer
	
	Set db = session.CurrentDatabase				
	Set acl = db.ACL						
	Set entry = acl.GetEntry(session.UserName)
	If entry Is Nothing Then
		Set entry = acl.GetEntry( session.UserName )
	End If
	level = db.QueryAccess( session.CommonUserName )
	
	'If this is a new document in edit mode, no need to run the edit check routine.
	If Isnewdoc Or source.InPreviewPane Then Exit Sub
	
	
	If mode = 1 Then
		docStatus = source.Document.OHOrdStatus(0)
		If level &gt;= ACLLEVEL_EDITOR And (docStatus &lt;&gt; "To Manufacturing" And docStatus &lt;&gt; "To Shipping" And docStatus &lt;&gt; "Shipped") Then
			Exit Sub
		End If
		If ( Not entry Is Nothing ) Then
			If entry.IsRoleEnabled("[Administrators]") And ( docStatus &lt;&gt; "To Manufacturing" And docStatus &lt;&gt; "To Shipping" And docStatus &lt;&gt; "Shipped" ) Then	
				Exit Sub
			End If		
		End If		
		If ( docStatus = "To Order Entry" Or docStatus = "To Manufacturing" Or docStatus = "To Shipping" Or docStatus = "Shipped" ) Then
			Messagebox _
			"Either this order has been released to manufacturing, shipping or it has been shipped.  The document is available for browsing only.", ,"Editing Is Not Allowed!"
			continue = False
		End If
	End If	
	
End Sub</lotusscript></code>
