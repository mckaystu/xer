<form name='Web Duped Order Header' alias='OEDupe' hide='notes' nocompose='true'
 noquery='true' publicaccess='false' designerversion='8.5.3'>
<noteinfo noteid='8ee' unid='096F2A856EC6DF108525692100764BA6' sequence='56'>
<created><datetime dst='true'>20000719T173206,14-04</datetime></created>
<modified><datetime dst='true'>20220519T012453,06-04</datetime></modified>
<revised><datetime dst='true'>20220518T080626,15-04</datetime></revised>
<lastaccessed><datetime dst='true'>20220519T012453,05-04</datetime></lastaccessed>
<addedtofile><datetime>20030211T095918,42-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby><code event='windowtitle'><formula
>@If(@IsNewDoc ; "New Order for " + OHBill_CustNam ; "Order for " + OHBill_CustNam)</formula></code><code
 event='querysave'><lotusscript>Sub Querysave(Source As Notesuidocument, Continue As Variant)
	Dim session As New NotesSession
	Dim workspace As New NotesUIWorkspace
	Dim currentdoc As notesdocument
	Dim admindoc As notesdocument
	Dim currentdb As NotesDatabase	
	Dim admindb As New NotesDatabase("" , "Innerface\Order Entry Administration.nsf")
	Dim tempnumber As Double
	Dim adminview As notesview
	Dim key As String
	
	Set currentdb = session.CurrentDatabase
	Set adminview = admindb.GetView("(Order Number)")
	Set uidoc = workspace.currentdocument
	Set currentdoc = uidoc.document
	
'If this is not a new document, we don't want to increment the next number for this user.	
	If Not uidoc.Isnewdoc Then Exit Sub
	
'Key for view search, it selects control doc based on User's initials from the hidden field
	key = uidoc.FieldGetText("hUserInit")	
	Set admindoc = adminview.GetDocumentByKey(key)   
	
'Gets current value in control doc and adds 1 to the value	
	tempnumber = Val(admindoc.UP_NextNumber(0) + 1)
	
'Resets the control document to the next number	
	admindoc.UP_NextNumber = tempnumber   					
	
'Save and refresh	
	Call admindoc.save(True, True)
	Call uidoc.reload
	
End Sub
</lotusscript></code><code event='querymodechange'><lotusscript>Sub Querymodechange(Source As Notesuidocument, Continue As Variant)
	Dim session As New NotesSession				
	Dim workspace As New NotesUIWorkSpace				
	Dim db As NotesDatabase					
	Dim acl As NotesACL						
	Dim entry As NotesACLEntry					
	
	Set db = session.CurrentDatabase				
	Set acl = db.ACL						
	Set entry = acl.GetEntry(session.UserName)
	
	If Not ( source.EditMode ) Then
		currentStatus = source.FieldGetText( "OHOrdStatus" )
		If (entry.IsRoleEnabled("[Administrators]") And currentStatus &lt;&gt; "Entered to JBA") Then	
			Exit Sub
		End If		
		If ( currentStatus = "Released" Or currentStatus = "Pending" Or currentStatus = "Entered to JBA") Then
			Messagebox _
			"Either this order has been released to JBA or it is in pending status or is being manufactured.  The document is available for browsing only.", ,"Editing Is Not Allowed!"
			continue = False
		End If
	End If
	
End Sub

</lotusscript></code><code event='queryopen'><lotusscript>Sub Queryopen(Source As Notesuidocument, mode As Integer, Isnewdoc As Variant, Continue As Variant)
	Dim docStatus As Variant
	Dim userType As Variant
	Dim session As New NotesSession				
	Dim workspace As New NotesUIWorkSpace				
	Dim db As NotesDatabase					
	Dim acl As NotesACL						
	Dim entry As NotesACLEntry					
	
	Set db = session.CurrentDatabase				
	Set acl = db.ACL						
	Set entry = acl.GetEntry(session.UserName)
	
	'If this is a new document in edit mode, no need to run the edit check routine.
	If Isnewdoc Or source.InPreviewPane Then Exit Sub
	If mode = 1 Then
		docStatus = source.Document.OHOrdStatus
		If (entry.IsRoleEnabled("[Administrators]")And docStatus(0) &lt;&gt; "Entered to JBA") Then	
			Exit Sub
		End If				
		If ( docStatus(0) = "Released" Or docStatus(0) = "Pending" Or docStatus(0) = "Entered to JBA") Then
			Messagebox _
			"Either this order has been released for manufacture or it is in pending status.  The document is available for browsing only.", ,"Editing Is Not Allowed!"
			continue = False
		End If
	End If	
	
End Sub</lotusscript></code><code event='jsheader' for='web'><javascript>function popUp(url) {
sealWin=window.open(url,"win",'toolbar=0,location=0,directories=0,status=1,menubar=1,scrollbars=1,resizable=1,width=500,height=450');
self.name = "mainWin"; }</javascript></code><code event='jsheader' for='client'><javascript
>function popUp(url) {
sealWin=window.open(url,"win",'toolbar=0,location=0,directories=0,status=1,menubar=1,scrollbars=1,resizable=1,width=500,height=450');
self.name = "mainWin"; }</javascript></code>
