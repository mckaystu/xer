<agent name='(SelectDupeOrder)' hide='v3' publicaccess='false' designerversion='5'>
<noteinfo noteid='2f6' unid='42660AFC0D10F184852568FC0055212B' sequence='94'>
<created><datetime dst='true'>20000612T112950,51-04</datetime></created>
<modified><datetime>20061215T010446,61-05</datetime></modified>
<revised><datetime>20061214T132452,01-05</datetime></revised>
<lastaccessed><datetime>20061215T010446,60-05</datetime></lastaccessed>
<addedtofile><datetime>20030211T095856,51-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby>
<designchange><datetime>20061214T132452,01-05</datetime></designchange>
<trigger type='agentlist'/>
<documentset type='runonce'/><code event='options'><lotusscript>Option Public

</lotusscript></code><code event='initialize'><lotusscript>Sub Initialize
	
	'declare everything
	Dim s As New NotesSession
	Dim db As NotesDatabase
	Dim dc As NotesDocumentCollection
	Dim hdrdoc As notesDocument, doc As NotesDocument
	Dim detdoc As NotesDocument, newdetdoc As NotesDocument, confirmdoc As NotesDocument
	Dim details As Variant
	Dim view As notesview
	Dim counter As Integer
	Dim numlen As Integer
	Dim nums As Integer
	Dim numzeros As Integer
	Dim charzero As String
	Dim hdrunid As String
	Dim order As String
	Dim status As String
	
	'Declare error handling for entire script
	On Error Goto Errorhandler
	
	'create a new order header document and trap the new unid.
	Set db = s.CurrentDatabase
	Set doc = s.DocumentContext
	
	If (doc.ConfAction(0) = "Cancel" ) Then
		Print "[/Innerface/Order+Entry.nsf/Web+Select?OpenForm]"
	End If
	
	Set hdrdoc = db.CreateDocument
	Call doc.CopyAllItems( hdrdoc, True )
	
	hdrdoc.Form = "OEHeader"
	status = "Web - In Process"
	hdrdoc.OHOrdStatus = status	
	hdrdoc.Editors = "Web User"
	hdrdoc.EditDates = Now
	hdrdoc.EditSequence = "1"
	hdrdoc.OHProject = "Duplicated Web Order"
	Call hdrdoc.RemoveItem( "Query_String" )
	
	Call hdrdoc.Save( True, True)	
	
	order = "New Duplicated Web Order"
	hdrunid = hdrdoc.UniversalID
	
%REM
	'this code is remmed out because we are assigning the order number when the order is submitted
	'by the user
	
	Dim admindb As New NotesDatabase( db.server, "Innerface\Order Entry Administration.nsf")
	Set view = admindb.GetView( "(luOEUsers)" )
	Set numdoc = view.GetDocumentbyKey( "Web User" , True)
	numdoc.UP_NextNumber = numdoc.UP_NextNumber(0) + 1
	Call numdoc.Save( True, True)

%ENDREM
	
	'create the new details
	details = hdrdoc.SelectDetail
	counter = 1
	
	Forall unid In details
		Set detdoc = db.GetDocumentbyUNID( unid )
		Set newdetdoc = detdoc.CopytoDatabase( db )
		newdetdoc.Form = "OEDtl"
		newdetdoc.OHDate = Now
		newdetdoc.OHOrdNo = "New Duplicated Web Order"
		newdetdoc.hODStatus = status					
		newdetdoc.ODItem = Cstr(counter)		
		Call newdetdoc.MakeResponse( hdrdoc )
		Call newdetdoc.Save( True, True)
		counter = counter + 1
	End Forall
	
	'send the user to the next page	
	Set confirmdoc = db.CreateDocument	
	Call hdrdoc.CopyAllItems( confirmdoc, True )
	confirmdoc.Form = "OrderConfirmation"
	Call confirmdoc.Save(True, True)
	confunid = confirmdoc.UniversalID	
	Print "[/Innerface/Order+Entry.nsf/0/" &amp; confunid &amp; "?EditDocument&amp;HdrUnid=" &amp; hdrunid &amp; "]"	
	
	Exit Sub 'Exit the sub before the errorhandler
	
ErrorHandler:
	Print("Error Number " + Cstr(Err) + " : " + Error$ + " on line number " + Cstr(Erl)) 
	Resume Next 'Continue where the agent encountered the last error
	
End Sub</lotusscript></code>
<rundata processeddocs='0' exitcode='0'>
<agentmodified><datetime>20021112T081442,47-05</datetime></agentmodified></rundata>
<item name='$POID'><datetime>20061214T132452,01-05</datetime></item></agent>

