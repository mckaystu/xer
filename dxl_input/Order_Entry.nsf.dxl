<pardef id='58' keepwithnext='true' keeptogether='true'/>
<par def='58'><run><font size='7pt' style='bold' name='Verdana' pitch='variable'
 truetype='true' familyid='20' color='red'/>     </run></par></tablecell>
<tablecell borderwidth='0px' bgcolor='#efefef'>
<pardef id='59' align='center' keepwithnext='true' keeptogether='true'/>
<par def='59'><run><font size='7pt' style='bold' name='Verdana' pitch='variable'
 truetype='true' familyid='20' color='red'/></run><button width='1in' widthtype='fixed'
 wraptext='true' edge='rounded' bgcolor='#c2ff91' type='ok' htmlstyle='font-family:"Verdana"; font-size:7pt; color="darkslateblue"'
 extrahtmlattrs='tabindex=22'><code event='onClick' for='web'><javascript
>var f = document.forms[0]
f.Action.value = "Lettered Insert";

if( f.hModType.value == "Plaque Module" ) {
	if( f.ODMod.value == "2.1" | f.ODMod.value == "2.1/A" |  f.ODMod.value == "2.2" | f.ODMod.value == "2.2/A" | 
		f.ODMod.value == "4.1" | f.ODMod.value == "4.1/A" |  f.ODMod.value == "4.2" | f.ODMod.value == "4.2/A" | 
	 	f.ODMod.value == "4.1E" | f.ODMod.value == "4.1E/A" |  f.ODMod.value == "4.2E" | f.ODMod.value == "4.2E/A" |
		f.ODMod.value == "4.3" | f.ODMod.value == "4.3/A" |  f.ODMod.value == "4.4" | f.ODMod.value == "4.4/A" | 
	 	f.ODMod.value == "4.8" | f.ODMod.value == "4.8/A" | f.ODMod.value == "4.99" | f.ODMod.value == "4.99/A" |
	 	f.ODMod.value == "6.1" | f.ODMod.value == "6.1/A" | f.ODMod.value == "6.2" | f.ODMod.value == "6.2/A" | 
		f.ODMod.value == "6.3" | f.ODMod.value == "6.3/A" | f.ODMod.value == "6.4" | f.ODMod.value == "6.4/A" | 
 		f.ODMod.value == "2.11" | f.ODMod.value == "2.11/A" |  f.ODMod.value == "2.22" | f.ODMod.value == "2.22/A" |
		f.ODMod.value == "4.11" | f.ODMod.value == "4.11/A" |  f.ODMod.value == "4.22" | f.ODMod.value == "4.22/A" |
		f.ODMod.value == "4.33" | f.ODMod.value == "4.33/A" |  f.ODMod.value == "4.44" | f.ODMod.value == "4.44/A" |  
		f.ODMod.value == "4.88" | f.ODMod.value == "4.88/A" |  f.ODMod.value == "6.11" | f.ODMod.value == "6.11/A" |
 		f.ODMod.value == "6.22" | f.ODMod.value == "6.22/A" | f.ODMod.value == "6.33" | f.ODMod.value == "6.33/A" | 
		f.ODMod.value == "6.44" | f.ODMod.value == "6.44/A" | f.ODMod.value == "8.12" | f.ODMod.value == "8.12/A" |
		f.ODMod.value == "8.14" | f.ODMod.value == "8.14/A") {
			f.Action.value = "Lettered Header" 
		}
	else {
		if( f.ODMod.value == "4.6" | f.ODMod.value == "4.7" | f.ODMod.value == "5.6" | f.ODMod.value == "2.6" | 
		f.ODMod.value == "6.6" | f.ODMod.value == "8.6" | f.ODMod.value == "7.1") {
			f.Action.value = "Lettered Top Insert";
		}
		else {
			if( f.ODMod.value == "5.2") {
				f.Action.value = "Lettered Left Insert";
			}
		}
	}
}	
if( f.ODMod.value == "10.0" | f.ODMod.value == "10.0/A" |
	f.ODMod.value == "10.1" | f.ODMod.value == "10.1/A" | f.ODMod.value == "11.0" | f.ODMod.value == "11.0/A" |
 	f.ODMod.value == "11.1" | f.ODMod.value == "11.1/A" | f.ODMod.value == "12.0" | f.ODMod.value == "12.0/A" |
	f.ODMod.value == "12.1" | f.ODMod.value == "12.1/A" | f.ODMod.value == "13.0" | f.ODMod.value == "13.0/A" |
	f.ODMod.value == "13.1" | f.ODMod.value == "13.1/A" | f.ODMod.value == "14.0" | f.ODMod.value == "14.0/A" |
	f.ODMod.value == "14.1" | f.ODMod.value == "14.1/A" | f.ODMod.value == "15.0" | f.ODMod.value == "15.0/A" |
	f.ODMod.value == "15.1" | f.ODMod.value == "15.1/A" | f.ODMod.value == "16.0" | f.ODMod.value == "16.0/A" |
	f.ODMod.value == "16.1" | f.ODMod.value == "16.1/A" ) {
		f.Action.value = "Lettered Header";
}
if( f.ODMod.value == "17.25" | f.ODMod.value == "17.25/B" |
	f.ODMod.value == "17.50L" | f.ODMod.value == "17.50L/B" | f.ODMod.value == "17.50W" | f.ODMod.value == "17.50W/B" |
	f.ODMod.value == "17.100" | f.ODMod.value == "17.100/B" |f.ODMod.value == "17.150" | f.ODMod.value == "17.150/B" |
	f.ODMod.value == "17.200" | f.ODMod.value == "17.200/B" | f.ODMod.value == "17.250" | f.ODMod.value == "17.250/B" |
	f.ODMod.value == "17.300" | f.ODMod.value == "17.300/B") {
		f.Action.value = "Custom Header";
}
				
if( f.ODMod.value == "" ) {
  alert( "You must select a module type before adding a lettered header insert.")
  f.ODMod.focus()
   return false
}   
if( f.Color.value == "") {
   alert("You must select a color for this module type before adding a lettered header insert.")
   f.Color.focus()
   return false
}
if( f.Shape.value == "") {
   alert("You must select a shape for this module type before adding a lettered header insert.")
   f.Shape.focus()
   return false
}
if( f.ODLetMsg.value == "" ) {
  alert( "You must enter the message text for a header insert.")
  f.ODLetMsg.focus()
   return false
}   
if( f.ODLetStyle.value == "") {
   alert("You must select a type style for this strip insert.")
   f.ODLetStyle.focus()
   return false
}
if( f.ODFormat.value == "") {
   alert("You must select a lettering format for this strip insert.")
   f.ODFormat.focus()
   return false
}
if( f.ODLetColor.value == "") {
   alert("You must select a font color for this header insert.")
   f.ODLetColor.focus()
   return false
}

