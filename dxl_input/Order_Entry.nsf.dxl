@Implode(OHOrdNo : @Text(ODItem) : instype : ODLetMsg : ODLetStyle : ODSymbol : ODLetColor : ODArrowDir : ODLetUse : ODFormat : adatype : ADAMsg : ODColor_1 : @Text(ODQty) : ODFrMount : ODFrMountMtl : ODFrShape : ADACompliant : ADAMsg : framecolor : blankcolor ;"~")</formula></code></column></view>

