   alert("You must select a lettering format for this lettered strip.")
   f.ODFormat.focus()
   return false
   }
if( f.ODLetColor.value == "") {
   alert("You must select a font color for this lettered strip.")
   f.ODLetColor.focus()
   return false
   }
   if( f.InsQty == "") {
   alert("You must enter a quantity for this lettered strip.")
   f.InsQty.focus()
   return false
   }
if( f.ADACompliant_1.value == "") {
   alert("You specify if this lettered strip will be used on an InnerDot (ADA Compliant) frame.")
   f.ADACompliant_1.focus()
   return false
   }
if( f.ADACompliant_1.value == "" &amp;&amp; f.SignType.value != "Standard") {
   alert("You specify if this lettered insert will be used on an InnerDot (ADA Compliant) frame.")
   f.ADACompliant_1.focus()
   return false
   }
   
f.submit()</javascript></code><run><font size='7pt' style='bold underline'
