@If((@IsNewDoc &amp; !@IsDocBeingRecalculated &amp; !@IsDocBeingSaved) &amp; CustNum != "" ;  "" ; @Return(custdata));
db := "Innerface\\MasterDB.nsf";
signdata := @DbLookup( "" ; dbserver : db; "(luCustNum)" ; CustNum  ; 2 );
@If(signdata = "" | @IsError(signdata) ; @Return("") ; "");
FIELD ODLetStyle := @Word( signdata ; "~" ; 1);
FIELD ODLetColor := @Word( signdata ; "~" ; 2);
FIELD Shape := @Word( signdata ; "~" ; 3);
FIELD ODLetUse := @Word( signdata ; "~" ; 4);
signdata</formula></code></field></run><compositedata type='98' prevtype='65418'
