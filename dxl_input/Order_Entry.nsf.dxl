 showaslinks='false'><font size='9pt'/><columnheader align='center' title='Ship To'><font
 size='9pt' style='bold'/></columnheader><code event='value'><formula>csz := @If(OHShip_City != "" ; OHShip_City + ", " + OHShip_State + "  " + OHShip_ZIP; "");
shipto := OHShip_Add1+ @Char(13) + OHShip_Add2 + @Char(13) + csz;
shipto</formula></code></column></view>

