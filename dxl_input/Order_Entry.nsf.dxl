<modified><datetime>20090401T010345,22-05</datetime></modified>
<revised><datetime>20090331T093556,67-05</datetime></revised>
<lastaccessed><datetime>20090401T010345,21-05</datetime></lastaccessed>
<addedtofile><datetime dst='true'>20040729T160841,85-04</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby>
<actionbar bgcolor='#e0dfe3' bordercolor='black'>
<actionbuttonstyle bgcolor='#e0dfe3'/><font color='system'/><border style='solid'
 width='0px 0px 1px'/>
<action title='Categori_ze' showinbar='false' systemcommand='categorize'/>
<action title='_Edit Document' showinbar='false' systemcommand='edit'/>
<action title='_Send Document' showinbar='false' systemcommand='send'/>
