  return CheckLettered()
}   
if( f.Action.value == "Blank" || f.Action.value == "Blank Base" || f.Actionvalue == "Blank Header") {
  return CheckBlank()
}   
if( f.Action.value == "Frame" ) {
  return CheckFrame()
}   

f.submit()</javascript></code><font size='7pt' style='bold' name='Verdana'
