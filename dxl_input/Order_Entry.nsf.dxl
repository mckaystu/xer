<noteinfo noteid='2d6' unid='3E7E6328AC4F02928825699A00740A4F' sequence='3'>
<created><datetime>20001117T130728,15-08</datetime></created>
<modified><datetime dst='true'>20060425T111023,29-04</datetime></modified>
