<agent name='Notify CSR of Web Order or Quote' hide='v3' noreplace='true'
 publicaccess='false' designerversion='7' restrictions='unrestricted' activatable='false'>
<noteinfo noteid='17e' unid='08952A286799C5F9852569210052167E' sequence='162'>
<created><datetime dst='true'>20000719T105637,10-04</datetime></created>
<modified><datetime>20100323T085114,98-05</datetime></modified>
<revised><datetime>20100323T085114,97-05</datetime></revised>
<lastaccessed><datetime>20100323T085114,97-05</datetime></lastaccessed>
<addedtofile><datetime>20030211T095854,73-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby>
<designchange><datetime>20100323T085114,96-05</datetime></designchange>
<trigger type='scheduled'>
<schedule type='byminutes' hours='1' minutes='0' runlocation='specific' runserver='CN=AtlWeb1/O=Innerface'>
<starttime><datetime>T060000,00</datetime></starttime>
<endtime><datetime>T160000,00</datetime></endtime></schedule></trigger>
<documentset type='all'/><code event='action'>
<simpleaction action='runformula'><formula>@If(Form = "OEHeader"; "" ; @Return(""));
@If(OHOrdStatus = "Web - Verify" ; "" ; @Return(""));

@If(@IsError(@NoteID) | @Contains(OHOrdDesc; "Test") | @Contains(OHOrdDesc; "test") | @Contains(OHOrdDesc; "TEST")  | @Contains(OHPONumber; "Test") | @Contains(OHPONumber; "test") | @Contains(OHPONumber; "TEST")  ; @Return("") ; "");

FIELD OHOrdStatus := OHOrdStatus;
serverdb := "85256888:0052CA08";
customer := OHBill_CustNam;
type := @If(@Left(OHOrdNo; 1) = "Q"; "Quote"; "Order");

SendTo := @If(@DbLookup("" : "NoCache" ; "85256888:0052CA08" ; "Keys" ;"Web Order Notification"; 2));
@If(@IsError(SendTo); @Do(@SetField("OHOrdStatus" ; "Web - Notification Error"); @MailSend("John Holcomb"  ; "Claire Stubblefield" ; "" ; "Web Order Error" ; "A new web " + type + " has arrived from the original web order/quote page and the CSR can't be notified." ; "" ; [IncludeDoclink] ); @Return("")); "");

CopyTo := "";
BlindCopyTo := "John Holcomb";
custsendto := WebEmail ;

tmp := @MailSend( SendTo  ; "" ; BlindCopyTo ; "New " + customer + " Web " + type ; "A new web " + type + " has arrived from the original web order/quote page.  Click the document link included with this memo to view the " + type + "." ; "" ; [IncludeDoclink] );

@If(!@IsError(tmp) ; @Do(@SetField("OHOrdStatus" ; "Web - CSR Notified") ; @MailSend(custsendto ; "" ; "" ; "Innerface" + type + " Confirmation" ; "Your recent Innerface Architectural Signage " + type + " number " + OHOrdNo + " has been received by Customer Service.  You may contact an Innerface project manager at 1-800-445-4796 if you have questions or need further information." + @NewLine + @NewLine + "THANK YOU!" ; ""));
	@Do(@SetField("OHOrdStatus" ; "Web - Notification Error"); @MailSend("John Holcomb" ; SendTo ; "" ; "New Web " + type + " Error" ; "A new " + type + " has arrived from the Innerface web site and, due to error, the project manager could not be notified.   Click the document link included with this memo to view the " + type + "." ; "" ; [IncludeDoclink] ) ; @SetField("OHOrdStatus" ; "Web - CSR Notification Error")));

SELECT @All</formula></simpleaction></code>
