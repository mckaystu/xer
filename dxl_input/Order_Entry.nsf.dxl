<par def='3'><run><font size='9pt' style='bold' name='Verdana' pitch='variable'
 truetype='true' familyid='20' color='white'/>Editor</run></par></tablecell>
<tablecell borderwidth='0px' bgcolor='navy'>
<pardef id='4' leftmargin='2%' rightmargin='98%' keepwithnext='true' keeptogether='true'/>
<par def='4'><run><font size='9pt' style='bold' name='Verdana' pitch='variable'
 truetype='true' familyid='20' color='white'/>Date</run></par></tablecell>
<tablecell borderwidth='0px' bgcolor='navy'>
<pardef id='5' leftmargin='2%' rightmargin='98%' keepwithnext='true' keeptogether='true'/>
<par def='5'><run><font size='9pt' style='bold' name='Verdana' pitch='variable'
 truetype='true' familyid='20' color='white'/>Sequence</run></par></tablecell></tablerow>
<tablerow>
<tablecell borderwidth='0px' bgcolor='white'>
<par def='3'><run><font size='9pt' name='Verdana' pitch='variable' truetype='true'
 familyid='20' color='navy'/></run><run><font size='9pt' color='navy' name='Verdana'
 pitch='variable' truetype='true' familyid='20'/><field type='names' allowmultivalues='true'
 kind='computed' name='EditorsDetail' listinputseparators='comma semicolon newline'
 listdisplayseparator='newline'><code event='defaultvalue'><formula>@If(@IsNewDoc &amp; !@IsDocBeingSaved; ""; @IsDocBeingSaved; @Trim(@Name([CN]; @UserName) : EditorsDetail); EditorsDetail)</formula></code></field></run><run
><font size='9pt' name='Verdana' pitch='variable' truetype='true' familyid='20'
 color='navy'/></run></par></tablecell>
<tablecell borderwidth='0px' bgcolor='white'>
<par def='4'><run><font size='9pt' name='Verdana' pitch='variable' truetype='true'
 familyid='20' color='navy'/></run><run><font size='9pt' color='navy' name='Verdana'
 pitch='variable' truetype='true' familyid='20'/><field type='text' allowmultivalues='true'
 kind='computed' name='EditDatesDetail' listinputseparators='comma semicolon newline'
 listdisplayseparator='newline'><code event='defaultvalue'><formula>@If(!@IsDocBeingSaved; @Return(EditDatesDetail); "");
FIELD EditDatesDetail := EditDatesDetail;
mo := @Text(@Month(@Now));
da := @Text(@Day(@Now));
yr := @Text(@Year(@Now));
dateDisp := mo + "/" + da + "/" + yr + " " + @Text(@Time(@Now));
@SetField("EditDatesDetail" ; @Trim(dateDisp : EditDatesDetail))</formula></code></field></run><run
><font size='9pt' name='Verdana' pitch='variable' truetype='true' familyid='20'
 color='navy'/></run></par></tablecell>
<tablecell borderwidth='0px' bgcolor='white'>
<par def='5'><run><font size='9pt' name='Verdana' pitch='variable' truetype='true'
 familyid='20' color='navy'/></run><run><font size='9pt' color='navy' name='Verdana'
 pitch='variable' truetype='true' familyid='20'/><field type='text' allowmultivalues='true'
 kind='computed' name='EditSequenceDetail' listinputseparators='comma semicolon newline'
 listdisplayseparator='newline'><code event='defaultvalue'><formula>thisnumber := @If(EditSequenceDetail = ""; "1"; @Text(1 + @TextToNumber(@Subset(EditSequenceDetail; 1))));
@If(@IsNewDoc &amp; !@IsDocBeingSaved; ""; @IsDocBeingSaved; @Trim(thisnumber : EditSequenceDetail); EditSequenceDetail)</formula></code></field></run><run
><font size='9pt' name='Verdana' pitch='variable' truetype='true' familyid='20'
 color='navy'/></run></par></tablecell></tablerow></table>
