<agent name='(CreateNewWebOrder)' hide='v3' publicaccess='false' designerversion='7'
 restrictions='unrestricted'>
<noteinfo noteid='56a' unid='9676B0BD7061EAD085256A87004FE565' sequence='41'>
<created><datetime dst='true'>20010712T103240,69-04</datetime></created>
<modified><datetime>20101103T010559,16-05</datetime></modified>
<revised><datetime>20101102T104159,51-05</datetime></revised>
<lastaccessed><datetime>20101103T010559,15-05</datetime></lastaccessed>
<addedtofile><datetime>20030211T095859,93-05</datetime></addedtofile></noteinfo>
<updatedby><name>CN=John Holcomb/O=Innerface</name><name>CN=AtlWeb1/O=Innerface</name></updatedby>
<wassignedby><name>CN=AtlWeb1/O=Innerface</name></wassignedby>
<designchange><datetime>20101102T104159,47-05</datetime></designchange>
<trigger type='agentlist'/>
<documentset type='runonce'/><code event='options'><lotusscript>Option Public

</lotusscript></code><code event='initialize'><lotusscript>Sub Initialize
	'This script will begin the process of creating a web order or quote.  
	
'declare everything
	Dim s As New NotesSession
	Dim db As NotesDatabase
	Dim dc As NotesDocumentCollection
	Dim doc As notesDocument, olddoc As NotesDocument, newdoc As NotesDocument
	Dim numdoc As NotesDocument
	Dim detdoc As NotesDocument, newdetdoc As NotesDocument, custdoc As NotesDocument
	Dim unid As String
	Dim view As Notesview, custview As Notesview
	Dim num As String
	Dim desc As String
	Dim custname As String
	Dim key As String, custkey As String, trackkey As String
	Dim tracknum As String
	Dim rndord As String
	Dim checkit As Variant
	
'declare error handling for entire script
	On Error Goto Errorhandler
	
'set up things
	Set db = s.CurrentDatabase
	Set doc = s.DocumentContext
	doc.Form = "OEHeader"
	
'since we're saving this new order or quote we need to increment the next order number.
	Dim admindb As New NotesDatabase( db.server, "Innerface\Order Entry Administration.nsf")
	Set view = admindb.GetView( "(luOEUsers)" )
	If ( doc.hUserInit(0) = "WEB" ) Then
		key = "Web User"
	Else
		key = "Quote Requestor"
	End If
	
	trackkey = "Track Order"
	Set numdoc = view.GetDocumentbyKey( trackkey , True)
	tracknum = Cstr( numdoc.UP_NextNumber(0) )
	numdoc.UP_NextNumber = numdoc.UP_NextNumber(0) + 1
	Call numdoc.Save( True, True)	
	
'put this customer's sales rep name and number on the header document	
	Dim custdb As New NotesDatabase( db.server, "Innerface\MasterDB.nsf" )	
	Set custview = custdb.GetView( "(LookupNum)" )
	custkey = doc.OHBill_CustNo(0)
	Set custdoc = custview.GetDocumentbyKey( custkey, True )
	If ( Not custdoc Is Nothing ) Then	
		doc.RepName = custdoc.ColumnValues( 4 )
		doc.RepNbr = custdoc.ColumnValues( 5 )
	Else
		doc.RepName = "New Customer"
		doc.RepNbr = "000"
	End If
	
'here we determine if the user has changed the cc number and if so we use the new one
	
	
'this block sets the edit history section at the bottom of the form	
	doc.Editors = key
	doc.EditDates = Today
	doc.EditSequence = "1"
	
'here we save the new order header and retrieve parameters to be passed to the detail 
	'creation form
	doc.hTrackNum = tracknum		
	doc.Unid = ""
	Call doc.Save( False, False)	
	unid = doc.UniversalID
	doc.Unid = unid
	Call doc.Save( False, False)	
	num = doc.hTrackNum(0)
	rndord = doc.hRndOrd(0)	
	desc = doc.OHOrdDesc(0)
	custname = doc.OHBill_CustNam(0)
	pricelist = doc.hPriceList(0)
	
'send the user to the next page depending on whether they have requested a quote or are
	'submitting an order.
	If ( doc.hUserInit(0) = "WEB" ) Then
		Print "[/Innerface/Order+Entry.nsf/WOHSelectOD?OpenForm&amp;PriceList=" &amp; pricelist &amp; "&amp;ID=" &amp; unid &amp; "&amp;Tracknum=" &amp; num &amp; "&amp;Random=" &amp; rndord &amp; "]"
	Else
		Print "[/Innerface/Order+Entry.nsf/WebQuoteDetail?OpenForm&amp;PriceList=" &amp; pricelist &amp; "&amp;ID=" &amp; unid &amp; "&amp;Tracknum=" &amp; num &amp; "&amp;Random=" &amp; rndord &amp; "]"
	End If
	
	Exit Sub 'Exit the sub before the errorhandler
	
ErrorHandler:
	Print("Error Number " + Cstr(Err) + " : " + Error$ + " on line number " + Cstr(Erl)) 
	Resume Next 'Continue where the agent encountered the last error
	
End Sub</lotusscript></code>
