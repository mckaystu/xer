<par def='1'><run><font size='7pt' name='Verdana' pitch='variable' truetype='true'
 familyid='20' color='gray'/>picklist:</run><run><font size='7pt' color='gray'
 name='Verdana' pitch='variable' truetype='true' familyid='20'/><field type='text'
 kind='computed' name='OHSelection'><code event='defaultvalue'><formula>@If(@IsNewDoc &amp; !@IsDocBeingRecalculated &amp; !@IsDocBeingSaved ;  "" ; @Return(""));

server := @Subset( @DbName ; 1);
db := "Innerface\\MasterDB.nsf";

temp := @PickList( [Custom] : [Single] ; hDbserver : "Innerface\\MasterDB.nsf" ; "(LookupforOrders)" ; "Customer Selection" ; "Select the customer for this new order." ; 1);
custnbr := @DbLookup( "" : ""; server : db; "CustNamFlatLookup" ; temp  ; 2 );
billdata := @DbLookup( "" : ""; server : db; "CustNamFlatLookup" ; temp  ; 3 );

@If( @IsError( temp) ; @Return("") ; "");
FIELD OHBill_CustNam := temp;
FIELD OHBill_Add1 := @Word( billdata ; "~" ; 1);
FIELD OHBill_Add2 := @Word( billdata ; "~" ; 2);
FIELD OHBill_City := @Word( billdata ; "~" ; 4);
FIELD OHBill_State := @Word( billdata ; "~" ; 5);
FIELD OHBill_ZIP := @Word( billdata ; "~" ; 6);
FIELD OHBill_Phone := @Word( billdata ; "~" ; 7);
FIELD OHAPContact := @Word( billdata ; "~" ; 8);
FIELD OHAPCtc_Phone := @Word( billdata ; "~" ; 7);
FIELD RepName := @Word( billdata ; "~" ; 13);
FIELD RepNbr := @Word( billdata ; "~" ; 14);

temp</formula></code><code event='terminate'><lotusscript>Sub Terminate
	
End Sub</lotusscript></code></field></run><compositedata type='98' prevtype='65418'
