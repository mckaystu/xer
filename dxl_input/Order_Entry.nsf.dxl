 familyid='20' color='gray'/>shiplist:</run><run><font size='7pt' color='gray'
 name='Verdana' pitch='variable' truetype='true' familyid='20'/><field type='text'
 kind='computed' name='OHSelection_1'><code event='defaultvalue'><formula
>@If(@IsNewDoc &amp; !@IsDocBeingRecalculated &amp; !@IsDocBeingSaved ;  "" ; @Return(""));

server := @Subset( @DbName ; 1);
db := "Innerface\\MasterDB.nsf";

checkit := @DbLookup("" : "NoCache" ; server : db ; "(Lookup ShipTo)" ; OHBill_CustNam ; 8);

useShip := @If(@IsError(checkit) | checkit = "" ; "0"; "1");

temp := @If(useShip = "1" ; @PickList( [Custom] : [Single] ; hDbserver : "Innerface\\MasterDB.nsf" ; "(custship)" ; "Shipping Address Selection" ; "Select the shipping address for this new order." ; 2  ; OHBill_CustNam); "000");

key := OHBill_CustNam + temp;

shipdata := @DbLookup( "" : "NoCache"; server : db; "(Lookup Ship Imploded)" ; key  ; 3 );
@If(@IsError(shipdata) ; @Return("") ; "");

FIELD OHShip_CustNam := OHBill_CustNam;
FIELD OHShip_Add1 := @If( useShip="1" ; @Word( shipdata ; "~" ; 1); OHBill_Add1);
FIELD OHShip_Add2 := @If( useShip="1" ; @Word( shipdata ; "~" ; 2); OHBill_Add2) ;
FIELD OHShip_City := @If( useShip="1" ; @Word( shipdata ; "~" ; 4); OHBill_City);
FIELD OHShip_State := @If( useShip="1" ; @Word( shipdata ; "~" ; 5); OHBill_State);
FIELD OHShip_ZIP := @If( useShip="1" ; @Word( shipdata ; "~" ; 6); OHBill_ZIP);
FIELD OHShip_Phone := @If( useShip="1" ; @Word( shipdata ; "~" ; 7); OHBill_Phone);
FIELD OHShipAddrCode := temp;
temp</formula></code><code event='terminate'><lotusscript>Sub Terminate
	
