<tablerow>
<tablecell borderwidth='0px' bgcolor='#e1e1e1'>
<pardef id='57' align='center' leftmargin='0.0104in' hide='notes' keepwithnext='true'
 keeptogether='true'><code event='hidewhen'><formula>SignType != "Standard"</formula></code></pardef>
<par def='57'><run><font size='8pt' style='bold' name='Verdana' pitch='variable'
 truetype='true' familyid='20' color='red'/></run><actionhotspot hotspotstyle='none'
 extrahtmlattrs='tabindex=10'><code event='onClick' for='web'><javascript
>var f = document.forms[0] ;
f.Action.value = "Standard" ;

if( f.sQuantity.value == 0 ) {
  alert( "You must enter a quantity to order before adding a standard sign.")
  f.sQuantity.focus()
   return false ;
}

if( f.sInsColor.value == "") {
   alert("You must select a color before adding a standard sign.")
   f.sInsColor.focus()
   return false ;
}

if( f.sShape.value == "") {
   alert("You must select a shape before adding a standard sign.")
   f.sShape.focus()
   return false ;
}
f.submit();</javascript></code><run><font size='8pt' style='bold underline'
 name='Verdana' pitch='variable' truetype='true' familyid='20' color='red'/>Add Standard Sign(s) to the Order</run></actionhotspot><run
><font size='8pt' style='bold' name='Verdana' pitch='variable' truetype='true'
