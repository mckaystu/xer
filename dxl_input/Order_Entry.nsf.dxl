 type='text' kind='computedfordisplay' name='hDbserver'><code event='defaultvalue'><formula
>@Subset(@DbName; 1)</formula></code></field></run><run><font size='7pt' name='Arial'
 pitch='variable' truetype='true' familyid='20' color='gray'/> </run></par>
<par def='1'><run><font size='7pt' name='Arial' pitch='variable' truetype='true'
