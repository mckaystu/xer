 familyid='20'/><field type='text' kind='computed' name='CustName'><code event='defaultvalue'><formula
>@If(CustNum = "X99999"; @Return("Innerface Specs") ; "");
nam := @UserName;
conam := @If( nam = "Anonymous" ; @Return("") ; @NameLookup( [TrustedOnly] ; nam ; "CompanyName"));
@If(@IsError(conam); ""; @Return(conam));

custdb := "Innerface\\MasterDB.nsf";
temp := @UserName;
@If( temp = "Anonymous" ; @Return("") ; @DbLookup( "" ; "" : custdb; "Customers\\by Number" ; CustNum ; 2 ))</formula></code><code
 event='terminate'><lotusscript>Sub Terminate
	
